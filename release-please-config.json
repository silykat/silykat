{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore: release ${version}",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "silykat",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "packages/vscode-extension/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages['packages/vscode-extension'].version" },
        { "type": "json", "path": "adapters/claude-code/plugin/.claude-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
