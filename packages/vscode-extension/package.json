{
  "name": "silykat",
  "displayName": "silykat",
  "description": "Comment your code like on a pull request, and let your AI coding agent (Claude Code) answer in the threads. Then look back with retros to improve its setup. 100% local.",
  "version": "0.10.0",
  "publisher": "silykat",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14110F",
    "theme": "dark"
  },
  "homepage": "https://github.com/silykat/silykat#readme",
  "bugs": {
    "url": "https://github.com/silykat/silykat/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/silykat/silykat"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "code review",
    "review",
    "comments",
    "pull request",
    "claude",
    "claude code",
    "ai",
    "agent",
    "coding agent",
    "retro",
    "retrospective",
    "local",
    "threads"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "silykat.commentSelection",
        "title": "Comment on Selection",
        "category": "silykat"
      },
      {
        "command": "silykat.commentFile",
        "title": "Comment on File",
        "category": "silykat"
      },
      {
        "command": "silykat.submitComment",
        "title": "Comment"
      },
      {
        "command": "silykat.commentNow",
        "title": "Comment Now"
      },
      {
        "command": "silykat.addToReview",
        "title": "Add to Review"
      },
      {
        "command": "silykat.startReview",
        "title": "Start Review",
        "category": "silykat"
      },
      {
        "command": "silykat.submitReview",
        "title": "Submit Review",
        "category": "silykat",
        "icon": "$(check)"
      },
      {
        "command": "silykat.discardReview",
        "title": "Discard Review",
        "category": "silykat",
        "icon": "$(trash)"
      },
      {
        "command": "silykat.showPendingComments",
        "title": "Show Pending Comments",
        "category": "silykat"
      },
      {
        "command": "silykat.showAwaitingUser",
        "title": "Threads Waiting for My Reply",
        "category": "silykat"
      },
      {
        "command": "silykat.showSessions",
        "title": "Show Agent Sessions",
        "category": "silykat"
      },
      {
        "command": "silykat.reviewMenu",
        "title": "Review Menu",
        "category": "silykat"
      },
      {
        "command": "silykat.revealThread",
        "title": "Reveal Thread",
        "category": "silykat"
      },
      {
        "command": "silykat.saveWorktreeThreads",
        "title": "Save Worktree Threads",
        "category": "silykat"
      },
      {
        "command": "silykat.showRetroReminder",
        "title": "When Is the Next Retro?",
        "category": "silykat"
      },
      {
        "command": "silykat.archiveResolvedThreads",
        "title": "Archive Resolved Threads…",
        "category": "silykat"
      },
      {
        "command": "silykat.showArchivedThreads",
        "title": "Show Archived Threads",
        "category": "silykat"
      },
      {
        "command": "silykat.exportThreads",
        "title": "Export Threads (JSON)…",
        "category": "silykat"
      },
      {
        "command": "silykat.deleteOldThreads",
        "title": "Delete Old Threads Permanently…",
        "category": "silykat"
      },
      {
        "command": "silykat.reply",
        "title": "Reply"
      },
      {
        "command": "silykat.replyNow",
        "title": "Reply Now"
      },
      {
        "command": "silykat.cancelNewThread",
        "title": "Cancel"
      },
      {
        "command": "silykat.resolveThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "silykat.reopenThread",
        "title": "Reopen",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "silykat.openOriginalDiff",
        "title": "Open Original Diff",
        "icon": "$(diff)"
      },
      {
        "command": "silykat.archiveThread",
        "title": "Archive Thread",
        "icon": "$(archive)"
      },
      {
        "command": "silykat.deleteThread",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "silykat.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "silykat.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "silykat.saveEdit",
        "title": "Save"
      },
      {
        "command": "silykat.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "silykat.dev.simulateAgentReply",
        "title": "Simulate Agent Reply",
        "category": "silykat (dev)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "silykat.commentSelection",
          "when": "resourceScheme == file"
        },
        {
          "command": "silykat.submitComment",
          "when": "false"
        },
        {
          "command": "silykat.cancelNewThread",
          "when": "false"
        },
        {
          "command": "silykat.reply",
          "when": "false"
        },
        {
          "command": "silykat.resolveThread",
          "when": "false"
        },
        {
          "command": "silykat.reopenThread",
          "when": "false"
        },
        {
          "command": "silykat.deleteThread",
          "when": "false"
        },
        {
          "command": "silykat.archiveThread",
          "when": "false"
        },
        {
          "command": "silykat.editComment",
          "when": "false"
        },
        {
          "command": "silykat.deleteComment",
          "when": "false"
        },
        {
          "command": "silykat.saveEdit",
          "when": "false"
        },
        {
          "command": "silykat.cancelEdit",
          "when": "false"
        },
        {
          "command": "silykat.commentNow",
          "when": "false"
        },
        {
          "command": "silykat.addToReview",
          "when": "false"
        },
        {
          "command": "silykat.startReview",
          "when": "!silykat.reviewActiveHere"
        },
        {
          "command": "silykat.submitReview",
          "when": "silykat.reviewActive"
        },
        {
          "command": "silykat.showPendingComments",
          "when": "silykat.reviewActive"
        },
        {
          "command": "silykat.reviewMenu",
          "when": "false"
        },
        {
          "command": "silykat.revealThread",
          "when": "false"
        },
        {
          "command": "silykat.replyNow",
          "when": "false"
        },
        {
          "command": "silykat.discardReview",
          "when": "silykat.reviewActive"
        },
        {
          "command": "silykat.openOriginalDiff",
          "when": "false"
        },
        {
          "command": "silykat.commentFile",
          "when": "resourceScheme == file || resourceScheme == git"
        }
      ],
      "editor/context": [
        {
          "command": "silykat.commentSelection",
          "when": "resourceScheme == file",
          "group": "silykat@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "silykat.submitComment",
          "when": "commentController == silykat && commentThreadIsEmpty && !commentIsEmpty && !silykat.reviewActiveHere",
          "group": "inline@1"
        },
        {
          "command": "silykat.startReview",
          "when": "commentController == silykat && commentThreadIsEmpty && !commentIsEmpty && !silykat.reviewActiveHere",
          "group": "inline@2"
        },
        {
          "command": "silykat.addToReview",
          "when": "commentController == silykat && commentThreadIsEmpty && !commentIsEmpty && silykat.reviewActiveHere",
          "group": "inline@1"
        },
        {
          "command": "silykat.commentNow",
          "when": "commentController == silykat && commentThreadIsEmpty && !commentIsEmpty && silykat.reviewActiveHere",
          "group": "inline@2"
        },
        {
          "command": "silykat.cancelNewThread",
          "when": "commentController == silykat && commentThreadIsEmpty",
          "group": "inline@3"
        },
        {
          "command": "silykat.addToReview",
          "when": "commentController == silykat && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^slk draft /",
          "group": "inline@1"
        },
        {
          "command": "silykat.reply",
          "when": "commentController == silykat && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^slk (open|needs-info|addressed|resolved)( diff)?$/ && !silykat.reviewActiveHere",
          "group": "inline@1"
        },
        {
          "command": "silykat.addToReview",
          "when": "commentController == silykat && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^slk (open|needs-info|addressed|resolved)( diff)?$/ && silykat.reviewActiveHere",
          "group": "inline@1"
        },
        {
          "command": "silykat.replyNow",
          "when": "commentController == silykat && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^slk (open|needs-info|addressed|resolved)( diff)?$/ && silykat.reviewActiveHere",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "silykat.openOriginalDiff",
          "when": "commentController == silykat && commentThread =~ / diff$/",
          "group": "inline@0"
        },
        {
          "command": "silykat.resolveThread",
          "when": "commentController == silykat && commentThread =~ /^slk (open|needs-info|addressed)( diff)?$/",
          "group": "inline@1"
        },
        {
          "command": "silykat.reopenThread",
          "when": "commentController == silykat && commentThread =~ /^slk resolved( diff)?$/",
          "group": "inline@1"
        },
        {
          "command": "silykat.archiveThread",
          "when": "commentController == silykat && commentThread =~ /^slk (open|needs-info|addressed|resolved)( diff)?$/",
          "group": "inline@2"
        },
        {
          "command": "silykat.deleteThread",
          "when": "commentController == silykat && commentThread =~ /^slk (draft )?(open|needs-info|addressed|resolved)( diff)?$/",
          "group": "inline@3"
        }
      ],
      "comments/comment/title": [
        {
          "command": "silykat.editComment",
          "when": "commentController == silykat && comment == author-user",
          "group": "inline@1"
        },
        {
          "command": "silykat.deleteComment",
          "when": "commentController == silykat && comment == author-user",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "silykat.saveEdit",
          "when": "commentController == silykat && comment == author-user",
          "group": "inline@1"
        },
        {
          "command": "silykat.cancelEdit",
          "when": "commentController == silykat && comment == author-user",
          "group": "inline@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "silykat.commentFile",
          "when": "resourceScheme == file || resourceScheme == git",
          "group": "silykat@1"
        }
      ]
    },
    "configuration": {
      "title": "silykat",
      "properties": {
        "silykat.userName": {
          "type": "string",
          "default": "",
          "description": "Name shown on your comments. When empty: `git config user.name`, otherwise your OS user name."
        },
        "silykat.commentShortcut": {
          "type": "string",
          "enum": [
            "ctrl+cmd+c",
            "ctrl+alt+c",
            "cmd+alt+m",
            "none"
          ],
          "enumDescriptions": [
            "Ctrl+Cmd+C on macOS, Ctrl+Alt+C on Windows/Linux.",
            "Ctrl+Alt+C (Ctrl+Option+C on macOS).",
            "Cmd+Alt+M on macOS (may clash with \"Minimize All\"), Ctrl+Alt+M on Windows/Linux.",
            "No shortcut from silykat. Bind `silykat.commentSelection` yourself in keybindings.json."
          ],
          "default": "ctrl+cmd+c",
          "markdownDescription": "Keyboard shortcut for **silykat: Comment on Selection**. For any other key combination, pick `none` and bind the `silykat.commentSelection` command in `keybindings.json` (*Preferences: Open Keyboard Shortcuts*)."
        },
        "silykat.notifyOnAgentReply": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when the agent replies in a thread. The status bar counter of threads waiting for your reply is always shown."
        },
        "silykat.excludeFromGit": {
          "type": "boolean",
          "default": true,
          "description": "Add `.silykat/` to the local git exclude file (`.git/info/exclude`) on the first comment. Never modifies `.gitignore`."
        },
        "silykat.pushToAgents": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send what you publish (comments, replies, reviews, edits, deletions) to the agent sessions subscribed to it, so that they handle it on their own. When off, nothing is sent: ask the agent yourself (e.g. `/silykat:review`), and no warning is shown about sessions."
        },
        "silykat.keepHistory": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "markdownDescription": "Keep the history of what you delete, for `slk review history` and retros (looking back at your review comments with your agent): a deleted thread stays on disk, out of sight, and the agent saves the threads of a git worktree before removing it. When off, deleting a thread erases it for good, nothing is saved when a worktree is removed, and you are offered to erase the history already kept. For this machine: machine setting `keep-history` of `slk config`, updated when you change it here."
        },
        "silykat.retroSessions": {
          "type": "string",
          "enum": [
            "reports",
            "insights"
          ],
          "enumDescriptions": [
            "A report on each of the agent's sessions, written by a model when the retro starts: finer, takes longer and costs more.",
            "The agent's own summaries of its sessions (Claude Code's /insights): cheaper, less precise."
          ],
          "default": "reports",
          "scope": "application",
          "markdownDescription": "How a retro (looking back at your review comments with your agent, e.g. `/silykat:retro`) reads your sessions with the agent, next to the review threads. Never both: they tell the same sessions twice. For this machine: machine setting `retro-sessions` of `slk config`, updated when you change it here."
        },
        "silykat.retroSources.reviews": {
          "type": "string",
          "enum": [
            "ask",
            "yes",
            "no"
          ],
          "enumDescriptions": [
            "Asked at each retro.",
            "Always read.",
            "Never read."
          ],
          "default": "ask",
          "scope": "application",
          "markdownDescription": "Whether a retro (looking back at your work with your agent, e.g. `/silykat:retro`) reads your review threads (the comments you left in VS Code). A retro reads at least one source. For this machine: machine setting `retro-source-reviews` of `slk config`, updated when you change it here. A project's own setting comes first: it is asked at the first retro of each project, and changed with `slk config set retro-source-reviews <value> --project`."
        },
        "silykat.retroSources.sessions": {
          "type": "string",
          "enum": [
            "ask",
            "yes",
            "no"
          ],
          "enumDescriptions": [
            "Asked at each retro.",
            "Always read.",
            "Never read."
          ],
          "default": "ask",
          "scope": "application",
          "markdownDescription": "Whether a retro (looking back at your work with your agent, e.g. `/silykat:retro`) reads your sessions with the agent (how they are read: Retro Sessions). A retro reads at least one source. For this machine: machine setting `retro-source-sessions` of `slk config`, updated when you change it here. A project's own setting comes first: it is asked at the first retro of each project, and changed with `slk config set retro-source-sessions <value> --project`."
        },
        "silykat.retroSources.audit": {
          "type": "string",
          "enum": [
            "ask",
            "yes",
            "no"
          ],
          "enumDescriptions": [
            "Asked at each retro.",
            "Always read.",
            "Never read."
          ],
          "default": "ask",
          "scope": "application",
          "markdownDescription": "Whether a retro (looking back at your work with your agent, e.g. `/silykat:retro`) reads the audit of your setup by the agent (Claude Code's `/doctor prompt-audit`, about 8 minutes). A retro reads at least one source. For this machine: machine setting `retro-source-audit` of `slk config`, updated when you change it here. A project's own setting comes first: it is asked at the first retro of each project, and changed with `slk config set retro-source-audit <value> --project`."
        },
        "silykat.retroReminder.days": {
          "type": "integer",
          "default": 7,
          "minimum": 1,
          "markdownDescription": "A retro (looking back at your review comments with your agent, e.g. `/silykat:retro`) is due this many days after the last one. Also used by the agent's reminder at the start of a session (machine setting `retro-reminder-days` of `slk config`, updated when you change it here)."
        },
        "silykat.retroReminder.sizeKB": {
          "type": "integer",
          "default": 1000,
          "minimum": 1,
          "markdownDescription": "Or sooner, once the review threads since the last retro weigh this many kilobytes (1000 = 1 MB): a retro reads them all, and reads less finely when there are too many. Machine setting `retro-reminder-size`."
        },
        "silykat.retroReminder.maxDays": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "markdownDescription": "And never later than this many days, whatever the setting above: agents delete their conversations after a while (Claude Code: 30 days by default), and the retro reads back those linked to replies. Machine setting `retro-reminder-max-days`."
        },
        "silykat.retroReminder.statusBar": {
          "type": "string",
          "enum": [
            "always",
            "whenDue",
            "never"
          ],
          "enumDescriptions": [
            "Show the days and size of the threads since the last retro, and \"Retro due\" once a retro is due.",
            "Show it only once a retro is due.",
            "Never show it."
          ],
          "default": "always",
          "description": "The retro reminder in the status bar (hidden while there is nothing new since the last retro)."
        },
        "silykat.retroReminder.agentMessage": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When a retro is due, the agent says so once at the start of a session (Claude Code). Machine setting `retro-reminder` of `slk config`, updated when you change it here."
        }
      }
    },
    "keybindings": [
      {
        "command": "silykat.commentSelection",
        "key": "ctrl+alt+c",
        "mac": "ctrl+cmd+c",
        "when": "editorTextFocus && resourceScheme == file && config.silykat.commentShortcut == 'ctrl+cmd+c'"
      },
      {
        "command": "silykat.commentSelection",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c",
        "when": "editorTextFocus && resourceScheme == file && config.silykat.commentShortcut == 'ctrl+alt+c'"
      },
      {
        "command": "silykat.commentSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && resourceScheme == file && config.silykat.commentShortcut == 'cmd+alt+m'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "test:integration:coverage": "node esbuild.mjs --tests && vscode-test --coverage --coverage-output ../../coverage/integration",
    "package": "node esbuild.mjs --production && node scripts/check-local-only.mjs && vsce package --no-dependencies -o dist/silykat.vsix"
  },
  "devDependencies": {
    "@silykat/core": "0.1.0",
    "@types/mocha": "10.0.10",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0"
  }
}
