{
  "name": "local-review",
  "displayName": "Local Review",
  "description": "GitHub-style code review between you and your AI coding agent, 100% local.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lbenamer/local-review"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "localReview.commentSelection",
        "title": "Comment on Selection",
        "category": "Local Review"
      },
      {
        "command": "localReview.submitComment",
        "title": "Comment"
      },
      {
        "command": "localReview.commentNow",
        "title": "Comment Now"
      },
      {
        "command": "localReview.addToReview",
        "title": "Add to Review"
      },
      {
        "command": "localReview.startReview",
        "title": "Start Review",
        "category": "Local Review"
      },
      {
        "command": "localReview.submitReview",
        "title": "Submit Review",
        "category": "Local Review",
        "icon": "$(check)"
      },
      {
        "command": "localReview.discardReview",
        "title": "Discard Review",
        "category": "Local Review",
        "icon": "$(trash)"
      },
      {
        "command": "localReview.showPendingComments",
        "title": "Show Pending Comments",
        "category": "Local Review"
      },
      {
        "command": "localReview.reviewMenu",
        "title": "Review Menu",
        "category": "Local Review"
      },
      {
        "command": "localReview.revealThread",
        "title": "Reveal Thread",
        "category": "Local Review"
      },
      {
        "command": "localReview.reply",
        "title": "Reply"
      },
      {
        "command": "localReview.replyNow",
        "title": "Reply Now"
      },
      {
        "command": "localReview.cancelNewThread",
        "title": "Cancel"
      },
      {
        "command": "localReview.resolveThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "localReview.reopenThread",
        "title": "Reopen",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "localReview.openOriginalDiff",
        "title": "Open Original Diff",
        "icon": "$(diff)"
      },
      {
        "command": "localReview.deleteThread",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "localReview.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "localReview.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "localReview.saveEdit",
        "title": "Save"
      },
      {
        "command": "localReview.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "localReview.dev.simulateAgentReply",
        "title": "Simulate Agent Reply",
        "category": "Local Review (dev)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "localReview.commentSelection",
          "when": "resourceScheme == file"
        },
        {
          "command": "localReview.submitComment",
          "when": "false"
        },
        {
          "command": "localReview.cancelNewThread",
          "when": "false"
        },
        {
          "command": "localReview.reply",
          "when": "false"
        },
        {
          "command": "localReview.resolveThread",
          "when": "false"
        },
        {
          "command": "localReview.reopenThread",
          "when": "false"
        },
        {
          "command": "localReview.deleteThread",
          "when": "false"
        },
        {
          "command": "localReview.editComment",
          "when": "false"
        },
        {
          "command": "localReview.deleteComment",
          "when": "false"
        },
        {
          "command": "localReview.saveEdit",
          "when": "false"
        },
        {
          "command": "localReview.cancelEdit",
          "when": "false"
        },
        {
          "command": "localReview.commentNow",
          "when": "false"
        },
        {
          "command": "localReview.addToReview",
          "when": "false"
        },
        {
          "command": "localReview.startReview",
          "when": "!localReview.reviewActive"
        },
        {
          "command": "localReview.submitReview",
          "when": "localReview.reviewActive"
        },
        {
          "command": "localReview.showPendingComments",
          "when": "localReview.reviewActive"
        },
        {
          "command": "localReview.reviewMenu",
          "when": "false"
        },
        {
          "command": "localReview.revealThread",
          "when": "false"
        },
        {
          "command": "localReview.replyNow",
          "when": "false"
        },
        {
          "command": "localReview.discardReview",
          "when": "localReview.reviewActive"
        },
        {
          "command": "localReview.openOriginalDiff",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "localReview.commentSelection",
          "when": "resourceScheme == file",
          "group": "localReview@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localReview.submitComment",
          "when": "commentController == local-review && commentThreadIsEmpty && !commentIsEmpty && !localReview.reviewActive",
          "group": "inline@1"
        },
        {
          "command": "localReview.startReview",
          "when": "commentController == local-review && commentThreadIsEmpty && !commentIsEmpty && !localReview.reviewActive",
          "group": "inline@2"
        },
        {
          "command": "localReview.addToReview",
          "when": "commentController == local-review && commentThreadIsEmpty && !commentIsEmpty && localReview.reviewActive",
          "group": "inline@1"
        },
        {
          "command": "localReview.commentNow",
          "when": "commentController == local-review && commentThreadIsEmpty && !commentIsEmpty && localReview.reviewActive",
          "group": "inline@2"
        },
        {
          "command": "localReview.cancelNewThread",
          "when": "commentController == local-review && commentThreadIsEmpty",
          "group": "inline@3"
        },
        {
          "command": "localReview.addToReview",
          "when": "commentController == local-review && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^lr draft /",
          "group": "inline@1"
        },
        {
          "command": "localReview.reply",
          "when": "commentController == local-review && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^lr (open|needs-info|addressed|resolved)( diff)?$/ && !localReview.reviewActive",
          "group": "inline@1"
        },
        {
          "command": "localReview.addToReview",
          "when": "commentController == local-review && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^lr (open|needs-info|addressed|resolved)( diff)?$/ && localReview.reviewActive",
          "group": "inline@1"
        },
        {
          "command": "localReview.replyNow",
          "when": "commentController == local-review && !commentThreadIsEmpty && !commentIsEmpty && commentThread =~ /^lr (open|needs-info|addressed|resolved)( diff)?$/ && localReview.reviewActive",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "localReview.openOriginalDiff",
          "when": "commentController == local-review && commentThread =~ / diff$/",
          "group": "inline@0"
        },
        {
          "command": "localReview.resolveThread",
          "when": "commentController == local-review && commentThread =~ /^lr (open|needs-info|addressed)( diff)?$/",
          "group": "inline@1"
        },
        {
          "command": "localReview.reopenThread",
          "when": "commentController == local-review && commentThread =~ /^lr resolved( diff)?$/",
          "group": "inline@1"
        },
        {
          "command": "localReview.deleteThread",
          "when": "commentController == local-review && commentThread =~ /^lr (draft )?(open|needs-info|addressed|resolved)( diff)?$/",
          "group": "inline@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "localReview.editComment",
          "when": "commentController == local-review && comment == author-user",
          "group": "inline@1"
        },
        {
          "command": "localReview.deleteComment",
          "when": "commentController == local-review && comment == author-user",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "localReview.saveEdit",
          "when": "commentController == local-review && comment == author-user",
          "group": "inline@1"
        },
        {
          "command": "localReview.cancelEdit",
          "when": "commentController == local-review && comment == author-user",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Local Review",
      "properties": {
        "localReview.userName": {
          "type": "string",
          "default": "",
          "description": "Name shown on your comments. When empty: `git config user.name`, otherwise your OS user name."
        },
        "localReview.commentShortcut": {
          "type": "string",
          "enum": [
            "ctrl+cmd+c",
            "ctrl+alt+c",
            "cmd+alt+m",
            "none"
          ],
          "enumDescriptions": [
            "Ctrl+Cmd+C on macOS, Ctrl+Alt+C on Windows/Linux.",
            "Ctrl+Alt+C (Ctrl+Option+C on macOS).",
            "Cmd+Alt+M on macOS (may clash with \"Minimize All\"), Ctrl+Alt+M on Windows/Linux.",
            "No shortcut from Local Review. Bind `localReview.commentSelection` yourself in keybindings.json."
          ],
          "default": "ctrl+cmd+c",
          "markdownDescription": "Keyboard shortcut for **Local Review: Comment on Selection**. For any other key combination, pick `none` and bind the `localReview.commentSelection` command in `keybindings.json` (*Preferences: Open Keyboard Shortcuts*)."
        },
        "localReview.excludeFromGit": {
          "type": "boolean",
          "default": true,
          "description": "Add `.local-review/` to the local git exclude file (`.git/info/exclude`) on the first comment. Never modifies `.gitignore`."
        }
      }
    },
    "keybindings": [
      {
        "command": "localReview.commentSelection",
        "key": "ctrl+alt+c",
        "mac": "ctrl+cmd+c",
        "when": "editorTextFocus && resourceScheme == file && config.localReview.commentShortcut == 'ctrl+cmd+c'"
      },
      {
        "command": "localReview.commentSelection",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c",
        "when": "editorTextFocus && resourceScheme == file && config.localReview.commentShortcut == 'ctrl+alt+c'"
      },
      {
        "command": "localReview.commentSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && resourceScheme == file && config.localReview.commentShortcut == 'cmd+alt+m'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "package": "node esbuild.mjs --production && node scripts/check-local-only.mjs && vsce package --no-dependencies --skip-license -o dist/local-review.vsix"
  },
  "devDependencies": {
    "@local-review/core": "0.1.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
