{
  "name": "local-review",
  "displayName": "Local Review",
  "description": "GitHub-style code review between you and Claude Code, 100% local.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lbenamer/local-review"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "localReview.commentSelection",
        "title": "Comment on Selection",
        "category": "Local Review"
      },
      {
        "command": "localReview.submitComment",
        "title": "Comment"
      },
      {
        "command": "localReview.cancelNewThread",
        "title": "Cancel"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "localReview.commentSelection",
          "when": "resourceScheme == file"
        },
        {
          "command": "localReview.submitComment",
          "when": "false"
        },
        {
          "command": "localReview.cancelNewThread",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "localReview.commentSelection",
          "when": "resourceScheme == file",
          "group": "localReview@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localReview.submitComment",
          "when": "commentController == local-review && commentThreadIsEmpty && !commentIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "localReview.cancelNewThread",
          "when": "commentController == local-review && commentThreadIsEmpty",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Local Review",
      "properties": {
        "localReview.userName": {
          "type": "string",
          "default": "",
          "description": "Name shown on your comments. When empty: `git config user.name`, otherwise your OS user name."
        },
        "localReview.excludeFromGit": {
          "type": "boolean",
          "default": true,
          "description": "Add `.local-review/` to the local git exclude file (`.git/info/exclude`) on the first comment. Never modifies `.gitignore`."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "package": "node esbuild.mjs --production && node scripts/check-local-only.mjs && vsce package --no-dependencies --skip-license -o dist/local-review.vsix"
  },
  "devDependencies": {
    "@local-review/core": "0.1.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
