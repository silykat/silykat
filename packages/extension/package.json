{
  "name": "local-review",
  "displayName": "Local Review",
  "description": "GitHub-style code review between you and Claude Code, 100% local.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lbenamer/local-review"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "localReview.commentSelection",
        "title": "Comment on Selection",
        "category": "Local Review"
      },
      {
        "command": "localReview.submitComment",
        "title": "Comment"
      },
      {
        "command": "localReview.cancelNewThread",
        "title": "Cancel"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "localReview.commentSelection",
          "when": "resourceScheme == file"
        },
        {
          "command": "localReview.submitComment",
          "when": "false"
        },
        {
          "command": "localReview.cancelNewThread",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "localReview.commentSelection",
          "when": "resourceScheme == file",
          "group": "localReview@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localReview.submitComment",
          "when": "commentController == local-review && commentThreadIsEmpty && !commentIsEmpty",
          "group": "inline@1"
        },
        {
          "command": "localReview.cancelNewThread",
          "when": "commentController == local-review && commentThreadIsEmpty",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Local Review",
      "properties": {
        "localReview.userName": {
          "type": "string",
          "default": "",
          "description": "Name shown on your comments. When empty: `git config user.name`, otherwise your OS user name."
        },
        "localReview.commentShortcut": {
          "type": "string",
          "enum": [
            "ctrl+cmd+c",
            "ctrl+alt+c",
            "cmd+alt+m",
            "none"
          ],
          "enumDescriptions": [
            "Ctrl+Cmd+C on macOS, Ctrl+Alt+C on Windows/Linux.",
            "Ctrl+Alt+C (Ctrl+Option+C on macOS).",
            "Cmd+Alt+M on macOS (may clash with \"Minimize All\"), Ctrl+Alt+M on Windows/Linux.",
            "No shortcut from Local Review. Bind `localReview.commentSelection` yourself in keybindings.json."
          ],
          "default": "ctrl+cmd+c",
          "markdownDescription": "Keyboard shortcut for **Local Review: Comment on Selection**. For any other key combination, pick `none` and bind the `localReview.commentSelection` command in `keybindings.json` (*Preferences: Open Keyboard Shortcuts*)."
        },
        "localReview.excludeFromGit": {
          "type": "boolean",
          "default": true,
          "description": "Add `.local-review/` to the local git exclude file (`.git/info/exclude`) on the first comment. Never modifies `.gitignore`."
        }
      }
    },
    "keybindings": [
      {
        "command": "localReview.commentSelection",
        "key": "ctrl+alt+c",
        "mac": "ctrl+cmd+c",
        "when": "editorTextFocus && resourceScheme == file && config.localReview.commentShortcut == 'ctrl+cmd+c'"
      },
      {
        "command": "localReview.commentSelection",
        "key": "ctrl+alt+c",
        "mac": "ctrl+alt+c",
        "when": "editorTextFocus && resourceScheme == file && config.localReview.commentShortcut == 'ctrl+alt+c'"
      },
      {
        "command": "localReview.commentSelection",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && resourceScheme == file && config.localReview.commentShortcut == 'cmd+alt+m'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:integration": "node esbuild.mjs --tests && vscode-test",
    "package": "node esbuild.mjs --production && node scripts/check-local-only.mjs && vsce package --no-dependencies --skip-license -o dist/local-review.vsix"
  },
  "devDependencies": {
    "@local-review/core": "0.1.0",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
