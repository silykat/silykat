async function readInsights(usageDir, root, env, run) {
  const metaDir = (0, import_node_path15.join)(usageDir, "session-meta");
  const names = (await (0, import_promises14.readdir)(metaDir).catch(() => [])).filter((n) => n.endsWith(".json")).sort();
  const files = [];
  for (const n of names) {
    const f = await readJson((0, import_node_path15.join)(metaDir, n));
    if (f) files.push(f);
  }
  const maps = await readFieldMaps(env);
  const failing = files.filter((f) => !keysWith(f, maps));
  if (failing.length > 0) {
    const found2 = await askFieldMap(failing.slice(0, 20), root, env, run);
    const candidate = { ...DEFAULT_FIELDS, ...found2 };
    if (failing.some((f) => keysOf(f, candidate))) {
      maps.push(candidate);
      await writeFieldMaps(env, maps).catch(() => void 0);
    }
  }
  const sessions = [];
  for (const f of files) {
    const k = keysWith(f, maps);
    if (!k) continue;
    const summary = await readJson((0, import_node_path15.join)(usageDir, "facets", `${k.id}.json`));
    sessions.push({ id: k.id, folder: k.folder, start: k.start, facts: factsOf(f, k.map), summary });
  }
  return { sessions, files: files.length };
}
function factsOf(f, map) {
  const skip = /* @__PURE__ */ new Set([map.session_id, map.project_path, map.start_time, "transcript_mtime"]);
  const out = {};
  const put = (k, v) => {
    if (typeof v === "number" || typeof v === "boolean") out[k] = v;
    else if (typeof v === "string" && v.trim()) out[k] = v.length > 300 ? `${v.slice(0, 299)}\u2026` : v;
  };
  for (const [k, v] of Object.entries(f)) {
    if (skip.has(k) || Array.isArray(v)) continue;
    if (typeof v === "object" && v !== null) for (const [k2, v2] of Object.entries(v)) put(`${k}.${k2}`, v2);
    else put(k, v);
  }
  return out;
}
var inPeriod = (start, since, until) => (since === null || start >= since) && start <= until;
async function projectSessions(usageDir, root, period, env, run, exclude = /* @__PURE__ */ new Set()) {
  const { sessions, files } = await readInsights(usageDir, root, env, run);
  const folders = await projectFolders(root, env);
  const kept = sessions.filter((s) => !exclude.has(s.id) && inFolders(s.folder, folders) && inPeriod(s.start, period.since, period.until)).sort((a, b) => a.start.localeCompare(b.start)).map((s) => ({ id: s.id, start: s.start, folder: s.folder, facts: s.facts, summary: s.summary }));
  return { sessions: kept, files, read: sessions.length };
}
async function transcriptStart(file) {
  const lines = (0, import_node_readline.createInterface)({ input: (0, import_node_fs2.createReadStream)(file, { encoding: "utf8" }), crlfDelay: Infinity });
  let cwd = null;
  let start = null;
  let entrypoint;
  try {
    for await (const line of lines) {
      let e;
      try {
        e = JSON.parse(line);
      } catch {
        continue;
      }
      if (cwd === null && typeof e.cwd === "string") {
        cwd = e.cwd;
        if (typeof e.entrypoint === "string") entrypoint = e.entrypoint;
      }
      if (start === null && typeof e.timestamp === "string") start = e.timestamp;
      if (cwd !== null && start !== null) break;
    }
  } finally {
    lines.close();
  }
  return cwd !== null && start !== null && !Number.isNaN(Date.parse(start)) ? { cwd, start: new Date(start).toISOString(), ...entrypoint ? { entrypoint } : {} } : null;
}
async function allTranscripts(claudeDir) {
  const projects = (0, import_node_path15.join)(claudeDir, "projects");
  const out = [];
  for (const dir of await (0, import_promises14.readdir)(projects).catch(() => [])) {
    const names = await (0, import_promises14.readdir)((0, import_node_path15.join)(projects, dir)).catch(() => []);
    for (const name of names.filter((x) => x.endsWith(".jsonl"))) {
      const file = (0, import_node_path15.join)(projects, dir, name);
      const s = await transcriptStart(file);
      if (s) out.push({ id: name.slice(0, -".jsonl".length), file, ...s });
    }
  }
  return out;
}
var PROGRAM_ENTRYPOINT = "sdk-cli";
async function programSessions(claudeDir) {
  return new Set((await allTranscripts(claudeDir)).filter((t) => t.entrypoint === PROGRAM_ENTRYPOINT).map((t) => t.id));
}
async function projectTranscripts(claudeDir, root, period, env) {
  const folders = await projectFolders(root, env);
  return (await allTranscripts(claudeDir)).filter(
    (t) => t.entrypoint !== PROGRAM_ENTRYPOINT && inFolders(t.cwd, folders) && inPeriod(t.start, period.since, period.until)
  ).sort((a, b) => a.start.localeCompare(b.start));
}

