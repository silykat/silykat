              last_prompt_before: lastPrompt
            })
          );
        } else if (st === "away_summary") away++;
        else if (st === "stop_hook_summary")
          add(
            "tools",
            "hooks",
            at(n, e, {
              kind: "stop",
              hook_count: orNull(e.hookCount),
