async function projectStores(root, env = process.env) {
  if (root === LOOSE_ROOT) return [{ root, origin: "root" }];
  const top = (0, import_node_path5.resolve)(root);
  const found2 = [];
  const seen = /* @__PURE__ */ new Set();
