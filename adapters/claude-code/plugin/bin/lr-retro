      void Promise.all(paths.map((p) => (0, import_promises3.realpath)(p).catch(() => null))).then(
        (real) => done(real.filter((p) => p !== null))
      );
    })
  );
}
async function projectHistory(root, opts = {}) {
  const env = opts.env ?? process.env;
  const sinceMs = opts.since ? opts.since.getTime() : null;
  const stores = await Promise.all(
    (await projectStores(root, env)).map(async (s) => {
      const { threads, warnings } = await storeAt(s.root, env).loadHistory();
      const kept = threads.filter((t) => activeSince(t, sinceMs)).sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id));
      return {
        ...s,
        threads: kept,
        bytes: kept.reduce((n, t) => n + t.bytes, 0),
        states: countStates(kept),
        warnings
      };
    })
  );
  const all = stores.flatMap((s) => s.threads);
  return {
    root: root === LOOSE_ROOT ? root : (0, import_node_path5.resolve)(root),
    since: opts.since ? opts.since.toISOString() : null,
    stores,
    threads: all.length,
    bytes: stores.reduce((n, s) => n + s.bytes, 0),
    states: countStates(all)
  };
}

