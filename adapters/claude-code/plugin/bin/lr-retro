// src/retroAudit.ts
var import_node_child_process4 = require("node:child_process");
var AUDIT_COMMAND = "/doctor prompt-audit";
var AUDIT_MIN_VERSION = [2, 1, 283];
var AUDIT_MODEL = "opus";
var AUDIT_TIMEOUT_MS = 15 * 6e4;
var runProcess = (command, args, { cwd, env, timeoutMs }) => new Promise((resolve8) => {
  (0, import_node_child_process4.execFile)(command, args, { cwd, env, timeout: timeoutMs, maxBuffer: 32 * 1024 * 1024 }, (err, stdout, stderr) => {
    const e = err;
    resolve8({
      stdout,
      stderr,
      code: e ? typeof e.code === "number" ? e.code : null : 0,
      timedOut: Boolean(e?.killed)
    });
  });
});
function auditArgs(claudeDir) {
  return [
    "-p",
    AUDIT_COMMAND,
    "--model",
    AUDIT_MODEL,
    "--permission-mode",
    "default",
    "--disallowedTools",
    "Bash",
    "Edit",
    "Write",
    "NotebookEdit",
    "--add-dir",
    claudeDir,
    "--output-format",
    "json"
  ];
