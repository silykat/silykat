var mask = (text) => text.replace(SECRET, "[secret]");
function cut(text, n) {
  const t = mask(typeof text === "string" ? text : "");
  return t.length <= n ? t : t.slice(0, n - 1) + "\u2026";
}
var isRecord3 = (x) => typeof x === "object" && x !== null && !Array.isArray(x);
var str = (x) => typeof x === "string" ? x : null;
var strOf = (x) => typeof x === "string" ? x : "";
