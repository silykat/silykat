async function jevKeyStatus(env = process.env) {
  const path = jevKeyFile(env);
  const fromEnv = (env.JEV_API_KEY ?? "").trim() !== "";
  const st = await (0, import_promises5.stat)(path).catch(() => null);
  const exists2 = st?.isFile() === true;
  const status = {
    source: fromEnv ? "env" : exists2 ? "file" : "none",
    path,
    exists: exists2,
    mode: null,
    private: false,
    inRepo: null,
    ok: fromEnv,
    fixes: []
  };
  if (!exists2 || !st) return status;
  status.mode = (st.mode & 511).toString(8);
  const mine = typeof process.getuid !== "function" || st.uid === process.getuid();
  status.private = (st.mode & 63) === 0 && mine;
  status.inRepo = await worktreeTopOf((0, import_node_path7.dirname)(path));
  if (!status.private) status.fixes.push(`chmod 600 "${path}"`);
  if (status.inRepo)
    status.fixes.push(`move it out of the repository ${status.inRepo} (e.g. to the default place, ${jevKeyFile(env)})`);
  if (!fromEnv) status.ok = status.private && status.inRepo === null;
  return status;
}

// ../../packages/core/src/retroScope.ts
var import_promises6 = require("node:fs/promises");
var import_node_path8 = require("node:path");
var who = (by, agent) => by === "user" ? "User" : agent ?? "Agent";
function entryText(e) {
  switch (e.kind) {
    case "comment": {
      const notes = [e.publishedAt ?? e.at];
      if (e.editedAt) notes.push(`edited ${e.editedAt}`);
      if (e.deletedAt) notes.push(`deleted ${e.deletedAt}`);
      return `[${who(e.author, e.agent)}] (${notes.join(", ")}) ${e.body}`;
    }
    case "status":
      return `(status -> ${e.status} by ${who(e.by, e.agent)}, ${e.at})`;
    case "deleted":
      return `(thread deleted by ${who(e.by, e.agent)}, ${e.at})`;
  }
}
function threadText(t, store) {
  const a = t.anchor;
  const where = a.range ? `${a.path}:${a.range.startLine}-${a.range.endLine}` : `${a.path} (whole file)`;
  const lines = [
    `THREAD ${t.id} \xB7 ${where} \xB7 ${t.state}` + (store ? ` \xB7 store ${store}` : "") + (t.branch ? ` \xB7 branch ${t.branch.branch}` : "")
  ];
  if (a.range && a.snippet) lines.push("code:", ...a.snippet.split("\n").map((l) => `  ${l}`));
  for (const e of t.conversation) lines.push(entryText(e));
  return lines.join("\n");
}
async function retroThreads(retro, env = process.env) {
  const history = await projectHistory(retro.root, { since: retro.since ? new Date(retro.since) : null, env });
  const wanted = new Set(retro.threads);
  const threads = /* @__PURE__ */ new Map();
  for (const s of history.stores)
    for (const t of s.threads) if (wanted.has(t.id)) threads.set(t.id, { thread: t, store: s.root });
  return { history, threads };
}
async function writeRetroFile(book, id, name, content) {
  const file = (0, import_node_path8.join)(await book.workDir(id), name);
  await (0, import_promises6.writeFile)(file, content);
  return file;
}

// src/retroAudit.ts
var import_node_child_process3 = require("node:child_process");
var AUDIT_COMMAND = "/doctor prompt-audit";
var AUDIT_MIN_VERSION = [2, 1, 283];
var AUDIT_MODEL = "sonnet";
var AUDIT_TIMEOUT_MS = 15 * 6e4;
var runProcess = (command, args, { cwd, env, timeoutMs }) => new Promise((resolve6) => {
  (0, import_node_child_process3.execFile)(command, args, { cwd, env, timeout: timeoutMs, maxBuffer: 32 * 1024 * 1024 }, (err, stdout, stderr) => {
    const e = err;
    resolve6({
      stdout,
      stderr,
      code: e ? typeof e.code === "number" ? e.code : null : 0,
      timedOut: Boolean(e?.killed)
    });
  });
});
function auditArgs(claudeDir) {
  return [
    "-p",
    AUDIT_COMMAND,
    "--model",
    AUDIT_MODEL,
    "--permission-mode",
    "default",
    "--disallowedTools",
    "Bash",
    "Edit",
    "Write",
    "NotebookEdit",
    "--add-dir",
    claudeDir,
    "--output-format",
    "json"
  ];
}
var parseVersion = (text) => {
  const m = /(\d+)\.(\d+)\.(\d+)/.exec(text);
  return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
};
var atLeast = (v, min) => {
  for (let i = 0; i < min.length; i++) if (v[i] !== min[i]) return v[i] > min[i];
  return true;
};
async function runAudit(root, claudeDir, env, run = runProcess, timeoutMs = AUDIT_TIMEOUT_MS) {
  const claude = env.LR_CLAUDE_BIN?.trim() || "claude";
  const v = await run(claude, ["--version"], { cwd: root, env, timeoutMs: 3e4 });
  const version = v.code === 0 ? parseVersion(v.stdout) : null;
  if (!version) return { kind: "skipped", reason: "Claude Code was not found" };
  if (!atLeast(version, AUDIT_MIN_VERSION))
    return {
      kind: "skipped",
      reason: `${AUDIT_COMMAND} needs Claude Code ${AUDIT_MIN_VERSION.join(".")} or later (here ${version.join(".")})`
    };
  const r = await run(claude, auditArgs(claudeDir), { cwd: root, env, timeoutMs });
  if (r.timedOut) return { kind: "failed", reason: `it took more than ${Math.round(timeoutMs / 6e4)} min` };
  let out;
  try {
    out = JSON.parse(r.stdout);
  } catch {
    const why = (r.stderr || r.stdout).trim().split("\n").at(-1) ?? "";
    return { kind: "failed", reason: `Claude Code ended with code ${r.code ?? "?"}${why ? `: ${why}` : ""}` };
  }
  const report = typeof out.result === "string" ? out.result.trim() : "";
  if (out.is_error === true || !report)
    return { kind: "failed", reason: report ? report.split("\n")[0] : "the audit gave no report" };
  return {
    kind: "done",
    report,
    costUsd: typeof out.total_cost_usd === "number" ? out.total_cost_usd : null,
    durationMs: typeof out.duration_ms === "number" ? out.duration_ms : null
  };
}

// src/retroJev.ts
var import_promises7 = require("node:fs/promises");
var JEV_URL = "https://jevtypesafeai.com/api/v1/decide";
var INTRO = "Code review thread between a developer and their AI coding agent. ";
var QUESTIONS = {
  category: {
    type: "choice",
    instructions: INTRO + "Which category best explains why the developer commented (the root cause, not the symptom)?",
    criteria: Object.fromEntries(Object.entries(FEEDBACK_CATEGORIES).map(([n, d]) => [n, d]))
  },
  missing_rule: {
    type: "noul",
    instructions: INTRO + "Does the developer's feedback reveal a constraint, convention or fact specific to THIS project (not general good practice) that the rules files do not state?"
  },
  ignored_rule: {
    type: "noul",
    instructions: INTRO + "Does the developer's feedback point to something the rules files already state, that the agent did not follow?"
  }
};
async function readJevKey(env = process.env) {
  const fromEnv = env.JEV_API_KEY?.trim();
  if (fromEnv) return fromEnv;
  const s = await jevKeyStatus(env);
  if (!s.exists) throw new Error(`no Jev key: ${s.path} does not exist (lr retro key tells how to add one)`);
  if (!s.ok) throw new Error(`the Jev key file is not safe, fix it first: ${s.fixes.join("; ")}`);
  const key = (await (0, import_promises7.readFile)(s.path, "utf8")).trim();
  if (!key) throw new Error(`the Jev key file ${s.path} is empty`);
  return key;
}
var unit = (x) => typeof x === "number" && x >= 0 && x <= 1 ? x : void 0;
async function decide(text, rules, deps) {
  const res = await deps.fetch(deps.url ?? JEV_URL, {
    method: "POST",
    headers: { Authorization: `Bearer ${deps.key}`, "Content-Type": "application/json" },
    body: JSON.stringify({ state: `Rules files of the project:
${rules}

---

${text}`, questions: QUESTIONS }),
    signal: AbortSignal.timeout(deps.timeoutMs ?? 6e4)
  });
  if (!res.ok) throw new Error(`Jev answered HTTP ${res.status}`);
  const o = await res.json();
  const a = o.answers ?? {};
  const category = Number(a.category?.choice);
  if (!FEEDBACK_CATEGORIES[category]) throw new Error("Jev gave no category");
  const label = { category };
  const conf = unit(a.category?.confidence);
  const missing = unit(a.missing_rule?.noul);
  const ignored = unit(a.ignored_rule?.noul);
  if (conf !== void 0) label.confidence = conf;
  if (missing !== void 0) label.missingRule = missing;
  if (ignored !== void 0) label.ignoredRule = ignored;
  return { label, cost: typeof o.usage?.cost_usd === "number" ? o.usage.cost_usd : 0 };
}
async function classifyWithJev(threads, rules, deps) {
  const result = { labels: {}, failed: [], costUsd: 0 };
  const queue = [...threads];
  const worker = async () => {
    for (let t = queue.shift(); t; t = queue.shift()) {
      let error = "";
      for (let attempt = 0; attempt < 2; attempt++) {
        try {
          const { label, cost } = await decide(t.text, rules, deps);
          result.labels[t.id] = label;
          result.costUsd += cost;
          error = "";
          break;
        } catch (err) {
          error = err instanceof Error && err.message.startsWith("Jev ") ? err.message : `request failed (${err?.name ?? "error"})`;
        }
      }
      if (error) result.failed.push({ thread: t.id, error });
    }
  };
  await Promise.all(Array.from({ length: Math.max(1, deps.concurrency ?? 4) }, worker));
  return result;
}

// src/retroSetup.ts
var import_promises8 = require("node:fs/promises");
var import_node_path9 = require("node:path");
var FILE_CAP = 24e3;
var SETUP_BUDGET = 1e5;
var orNull = (p) => p.catch(() => null);
var exists = async (p) => await orNull((0, import_promises8.stat)(p)) !== null;
async function markdown(dir, depth = 3) {
  if (depth < 0) return [];
  const names = await (0, import_promises8.readdir)(dir).catch(() => []);
  const out = [];
  for (const name of names.sort()) {
    const p = (0, import_node_path9.join)(dir, name);
    const st = await orNull((0, import_promises8.stat)(p));
    if (!st) continue;
    if (st.isDirectory()) out.push(...await markdown(p, depth - 1));
    else if (name.endsWith(".md")) out.push(p);
  }
  return out;
}
var isInside = (path, dir) => {
  const rel = (0, import_node_path9.relative)(dir, path);
  return rel !== "" && !rel.startsWith("..") && !(0, import_node_path9.isAbsolute)(rel);
};
function projectDirs(root, repos, home) {
  const parents = [];
  let dir = (0, import_node_path9.dirname)((0, import_node_path9.resolve)(root));
  const top = (0, import_node_path9.resolve)(home);
  while (dir !== (0, import_node_path9.dirname)(dir) && isInside(dir, top)) {
    parents.unshift(dir);
    dir = (0, import_node_path9.dirname)(dir);
  }
  return [.../* @__PURE__ */ new Set([...parents, (0, import_node_path9.resolve)(root), ...repos.map((r) => (0, import_node_path9.resolve)(r))])];
}
async function found(root, repos, home, claudeDir) {
  const files = [];
  const add = async (path, kind, scope) => {
    if (!files.some((f) => f.path === path) && await exists(path)) files.push({ path, kind, scope });
  };
  const dirs = projectDirs(root, repos, home);
  for (const d of dirs)
    for (const name of ["CLAUDE.md", "CLAUDE.local.md", ".claude/CLAUDE.md"])
      await add((0, import_node_path9.join)(d, name), "rules", "project");
  await add((0, import_node_path9.join)(claudeDir, "CLAUDE.md"), "rules", "user");
  const setupOf = async (claude, agents, scope) => {
    for (const f of await markdown((0, import_node_path9.join)(claude, "rules"))) await add(f, "rules", scope);
    for (const f of await markdown((0, import_node_path9.join)(claude, "skills"), 2))
      if ((0, import_node_path9.basename)(f) === "SKILL.md") await add(f, "skill", scope);
    for (const f of await markdown((0, import_node_path9.join)(claude, "commands"))) await add(f, "command", scope);
    for (const f of await markdown((0, import_node_path9.join)(claude, "agents"))) await add(f, "agent", scope);
    for (const name of ["settings.json", "settings.local.json"]) await add((0, import_node_path9.join)(claude, name), "hooks", scope);
    for (const f of await markdown(agents)) await add(f, "other", scope);
  };
  for (const d of [(0, import_node_path9.resolve)(root), ...repos.map((r) => (0, import_node_path9.resolve)(r))])
    await setupOf((0, import_node_path9.join)(d, ".claude"), (0, import_node_path9.join)(d, ".agents"), "project");
  await setupOf(claudeDir, (0, import_node_path9.join)(home, ".agents"), "user");
  return files;
}
function header(text) {
  const m = /^---\n([\s\S]*?)\n---/.exec(text);
  return m ? `---
${m[1]}
---
(header only: read the file for the rest)` : text.split("\n").slice(0, 5).join("\n");
}
function hooksOf(text) {
  try {
    const hooks = JSON.parse(text).hooks;
    return hooks ? JSON.stringify({ hooks }, null, 2) : null;
  } catch {
    return null;
  }
}
async function collectSetup(root, repos, home, claudeDir = (0, import_node_path9.join)(home, ".claude"), budget = SETUP_BUDGET) {
  const out = [];
  let used = 0;
  const all = await found(root, repos, home, claudeDir);
  const order = (f) => (f.kind === "rules" || f.kind === "hooks" ? 0 : 1) + (f.scope === "user" ? 2 : 0);
  for (const f of [...all].sort((a, b) => order(a) - order(b))) {
    const raw = await orNull((0, import_promises8.readFile)(f.path, "utf8"));
    if (raw === null) continue;
    let content = f.kind === "hooks" ? hooksOf(raw) : raw;
    if (content === null) continue;
    let shown = "full";
    if (f.kind !== "rules" && f.kind !== "hooks" && used + Math.min(content.length, FILE_CAP) > budget) {
      content = header(content);
      shown = "header";
    } else if (content.length > FILE_CAP) {
      content = content.slice(0, FILE_CAP) + "\n[\u2026 cut: read the file for the rest]";
      shown = "truncated";
    }
    used += content.length;
    out.push({ ...f, bytes: Buffer.byteLength(raw), content, shown });
  }
  return out;
}
var TITLES = {
  rules: "Rules files",
  hooks: "Hooks (from the settings)",
  skill: "Skills",
  command: "Commands",
  agent: "Sub-agents",
  other: "Other agent files (.agents/)"
};
function renderSetup(root, home, files) {
  const label = (p) => {
    if (isInside(p, (0, import_node_path9.resolve)(root))) return (0, import_node_path9.relative)(root, p);
    if (isInside(p, (0, import_node_path9.resolve)(home))) return "~/" + (0, import_node_path9.relative)(home, p);
    return p;
  };
  const lines = [
    `# Claude Code setup \u2014 ${root}`,
    "",
    `${files.length} files. The project's files come first, then the user's (~). Paths relative to the project.`,
    "Targets: project-shared = a CLAUDE.md or .claude/ file committed in a repository; project-personal = CLAUDE.local.md",
    "(or the CLAUDE.md of a parent folder outside any repository); user = ~/.claude/CLAUDE.md, ~/.claude/."
  ];
  for (const kind of Object.keys(TITLES)) {
    const fs = files.filter((f) => f.kind === kind);
    lines.push("", `## ${TITLES[kind]}`, "");
    if (fs.length === 0) lines.push("None.");
    for (const f of fs)
      lines.push(
        `### ${label(f.path)} (${f.scope}${f.shown === "full" ? "" : `, ${f.shown}`}, ${f.bytes} bytes)`,
        "",
        "````",
        f.content.trimEnd(),
        "````",
        ""
      );
  }
  return lines.join("\n");
}

// src/retroCli.ts
var RETRO_CLI_USAGE = `lr-retro \u2014 the Claude Code part of Local Review's retros

  lr-retro setup <retro-id> [--root <dir>]   Write Claude Code's setup of the project (rules files,
                                             .claude/ and .agents/ of the project and of ~) in a file
                                             of the retro, for its analysis
  lr-retro jev <retro-id> [--root <dir>]     Classify the retro's threads with Jev (needs a key:
                                             lr retro key), and record the labels
  lr-retro audit <retro-id> [--root <dir>]   Audit the setup with /doctor prompt-audit (a separate,
                                             read-only Claude Code; several minutes), in a file of
                                             the retro, for its analysis`;
var RULES_CAP = 8e3;
async function runRetroCli(args, io) {
  try {
    const { values, positionals } = (0, import_node_util.parseArgs)({
      args,
      options: { root: { type: "string" } },
      allowPositionals: true
    });
    const [action, id] = positionals;
    if (action !== "setup" && action !== "jev" && action !== "audit") {
      io.out(RETRO_CLI_USAGE);
      return action === void 0 || action === "help" ? 0 : 1;
    }
    if (!id) throw new Error("missing <retro-id>");
    const root = values.root ?? io.cwd;
    const book = new RetroBook(await retroHome(root, io.env));
    const retro = await book.get(id);
    const home = io.env.HOME?.trim() || (0, import_node_os3.homedir)();
    const claudeDir = io.env.CLAUDE_CONFIG_DIR?.trim() || (0, import_node_path10.join)(home, ".claude");
    const repos = retro.stores.map((s) => s.root);
    if (action === "setup") {
      const files = await collectSetup(retro.root, repos, home, claudeDir);
      const file = await writeRetroFile(book, retro.id, "setup.md", renderSetup(retro.root, home, files));
      const header2 = files.filter((f) => f.shown === "header").length;
      io.out(
        `Written: ${file}
${files.length} setup files (${files.filter((f) => f.kind === "rules").length} rules files)` + (header2 ? `, ${header2} shown by their header only (over the size budget: read them if needed)` : "") + "."
      );
      return 0;
    }
    if (action === "audit") {
      const outcome = await runAudit(retro.root, claudeDir, io.env, io.run);
      if (outcome.kind === "skipped") {
        io.out(`Audit skipped: ${outcome.reason}.`);
        return 0;
      }
      if (outcome.kind === "failed") {
        io.err(`lr-retro: the audit failed: ${outcome.reason}.`);
        return 1;
      }
      const file = await writeRetroFile(
        book,
        retro.id,
        "audit.md",
        [
          `# Audit of the setup \u2014 ${AUDIT_COMMAND}`,
          "",
          `Run for the retro ${retro.id} in ${retro.root}, read-only (no shell, no edit), with access to ${claudeDir}.`,
          "",
          outcome.report,
          ""
        ].join("\n")
      );
      const minutes = outcome.durationMs === null ? "" : ` in ${Math.max(1, Math.round(outcome.durationMs / 6e4))} min`;
      const cost = outcome.costUsd === null ? "" : ` (about $${outcome.costUsd.toFixed(2)})`;
      io.out(`Written: ${file}
The audit of the setup is done${minutes}${cost}.`);
      return 0;
    }
    const key = await readJevKey(io.env);
    const { threads } = await retroThreads(retro, io.env);
    const rules = (await collectSetup(retro.root, repos, home, claudeDir)).filter((f) => f.kind === "rules").map((f) => `## ${f.path}
${f.content}`).join("\n\n").slice(0, RULES_CAP);
    const result = await classifyWithJev(
      [...threads.values()].map(({ thread, store }) => ({ id: thread.id, text: threadText(thread, store) })),
      rules,
      { fetch: io.fetch ?? fetch, key, url: io.env.LR_JEV_URL?.trim() || void 0 }
    );
    const n = Object.keys(result.labels).length;
    if (n > 0) await book.record(retro.id, [{ type: "retro.classified", by: "jev", labels: result.labels }]);
    io.out(
      `Classified ${n}/${threads.size} threads with Jev` + (result.costUsd ? ` (about $${result.costUsd.toFixed(2)})` : "") + "." + (result.failed.length ? `
${result.failed.length} failed: ${result.failed.map((f) => `${f.thread} (${f.error})`).join(", ")}` : "")
    );
    return n > 0 ? 0 : 1;
  } catch (err) {
    io.err(`lr-retro: ${err instanceof Error ? err.message : String(err)}`);
    return 1;
  }
}

// src/retroMain.ts
runRetroCli(process.argv.slice(2), {
  cwd: process.cwd(),
  env: process.env,
  out: (text) => process.stdout.write(text + "\n"),
  err: (text) => process.stderr.write(text + "\n")
}).then(
  (code) => {
    process.exitCode = code;
  },
  (err) => {
    process.stderr.write(`lr-retro: ${String(err)}
`);
    process.exitCode = 1;
  }
);
