        const origin = isRecord3(e.origin) ? e.origin : {};
        const human = agent.id === "main" && text !== "" && !e.isMeta && !e.isCompactSummary && (origin.kind ?? "human") === "human" && !INJECTED.test(text);
        if (origin.kind === "channel") add("delivery", "local_review_messages", at(n, e, { text: cut(text, 200) }));
        if (human) {
          const after = [...actionsSincePrompt.reduce((m2, a) => bump(m2, a), /* @__PURE__ */ new Map())].sort(
            (a, b) => b[1] - a[1]
          );
          const p = at(n, e, {
            chars: text.length,
            source: orNull(e.promptSource),
            after_actions: after,
            text: cut(text, 600)
          });
          prompts.push(p);
          if (actionsSincePrompt.length)
            add("collaboration", "corrections", {
              agent: p.agent,
              uuid: p.uuid,
              time: p.time,
              line: p.line,
              after_actions: after,
              text: p.text
            });
          lastPrompt = { uuid: orNull(e.uuid), text: cut(text, 300) };
          actionsSincePrompt = [];
          bashSincePrompt = [];
        }
        firstUser = false;
      }
    }
  }
  for (const [command, uuids] of errorsByCommand)
    if (uuids.length >= 2) add("tools", "repeated_failures", { command, failures: uuids.length, uuids });
  if (prompts.length) add("workflow", "handoff", { ...prompts.at(-1), kind: "last_prompt_of_session" });
  (sig.workflow ??= {}).repeated_requests = prompts;
  for (const [family, names] of Object.entries(FAMILIES)) for (const name of names) (sig[family] ??= {})[name] ??= [];
  const skillsCalled = new Set(
    (sig.setup?.skills ?? []).map((o) => o.skill).filter((s) => typeof s === "string")
  );
  times.sort();
  const top = (m) => [...m].sort((a, b) => b[1] - a[1]).map(([k]) => k);
  return {
    schema: ANALYTICS_SCHEMA,
    session_id: sid,
    cwd: top(cwd)[0] ?? null,
    branches: top(branches),
    start: times[0] ?? null,
    end: times.at(-1) ?? null,
    claude_code_versions: [...versions].sort(),
    entrypoints: [...entrypoints].sort(),
    title: titles.at(-1) ?? null,
    custom_title: customTitles.at(-1) ?? null,
    agents: agents.map((a) => ({
      id: a.id,
      type: str(a.meta.agentType) ?? (a.id === "main" ? "main" : null),
      description: str(a.meta.description),
      launchedBy: str(a.meta.toolUseId),
      workflow: Boolean(a.meta.workflow),
      lines: a.lines.length,
      file: a.file
    })),
    counts: {
      typed_prompts: prompts.length,
      lines: agents.reduce((s, a) => s + a.lines.length, 0),
      tool_calls: sorted(toolCalls),
      commands: sorted(commands),
      away_summaries: away,
      turns: turnMs.length,
      turn_duration_ms_total: turnMs.reduce((s, x) => s + x, 0),
      permission_modes: Object.fromEntries(permissionModes)
    },
    setup: {
      instructions_loaded: instructions,
      skills_available: [...skillsAvailable].sort(),
      skills_available_never_called: [...skillsAvailable].filter((s) => !skillsCalled.has(s)).sort(),
      skills_active_messages: sorted(skillsActive)
    },
    cost: {
      tokens_by_model: Object.fromEntries([...usage].map(([k, v]) => [k, Object.fromEntries(v)])),
      cost_state: costState,
      models: sorted(models)
    },
    signals: sig
  };
}

// src/sessionReportBrief.ts
var REPORT_BRIEF = `You write the **report** on one Claude Code session, from its **analytics** (computed without a model) and its conversations. An analyst will then read the reports of every session of the project, to find what they have in common and propose improvements to the setup (CLAUDE.md, skills, hooks, permissions, workflows) or to the way of working. Write for that analyst: factual, sourced, useful.

## Inputs (files of your working folder; read nothing else)

- \`analytics.json\`: \`signals.<family>.<signal>\` lists occurrences; each one points to a moment: \`agent\` (\`main\` or a sub-agent id), \`uuid\`, \`time\`, \`line\`, plus details. \`agents\` lists the session's sub-agents. It can be long: read it in parts (offset and limit).
- \`conversation-main.txt\`, and \`conversation-agent-<id>.txt\` for each sub-agent: the conversation, one step per line, each starting with \`L<line> <uuid>\`. Long texts are cut and secrets masked.
- To read the context of a moment, search its uuid in the agent's conversation with Grep, with lines before (what led to it) and after (what followed), e.g. 8 before and 6 after. Read **as many moments as you need to judge**, but never a whole conversation.

## The signals and their relevance

For each signal present, judge every occurrence (or a representative sample when there are very many: say so in its note): **relevant** or not, with a one-sentence reason. A relevant occurrence reveals something that can be improved in the agent, in the setup or in the way of working.

### collaboration
- **friction** (interruptions, refusals by the user, command cut short). Relevant when the agent was doing something not asked, too broad, too long, risky, or ignored an instruction. Not relevant: a misclick (same request sent again right away), an interruption to add information without reproach, a legitimate action refused out of caution.
- **corrections** (a prompt typed after the agent acted). Relevant when the prompt **corrects or redirects** the agent ("no", "not like this", "I told you", redo it differently, undo). Not relevant: approval, a new request, a clarification without reproach, a question.
- **user_edits** (\`proposal_modified_by_user\`: an edit proposal changed by the user before accepting it; \`file_edited_outside_agent\`: a file changed outside the agent; \`file_changed_by_agent_command\`: a file changed by one of the agent's commands (sed, a script), hence **not** a user edit: not relevant unless something is off). Relevant when the user fixed the substance of the agent's work. Not relevant: automatic formatting, an unrelated file, an expected change (the user writing on their own).
- **agent_questions** (AskUserQuestion and the answers). Relevant when the answer was already known (an instruction, the conversation) or the same question comes back: a missing or misplaced rule. Not relevant: a real decision of the user.

### tools
- **permission_blocks** (refused by a rule or by auto mode). Relevant when the command was safe and useful (lead: allow it), or when the agent kept trying.
- **tool_errors**, **repeated_failures**. Relevant when the error comes from the agent or the setup (wrong command, wrong path, missing tool, version), especially when repeated. Not relevant: an expected failure (a test meant to fail), normal exploration.
- **hooks**. Relevant when a hook blocked or fixed a real mistake (it is useful), or when it fails or gets in the way.

### setup
- **skills** (called by the agent, typed by the user, failed); see also \`setup.skills_available_never_called\`. Relevant when a skill should have been used and was not, was misused, or fails.
- **commands** (built-in commands typed).
- **subagents** (launch and result). Relevant when the sub-agent failed, returned a result that was not used, or was poorly briefed.

### workflow
- **context_pressure** (compactions, \`/clear\`, \`/compact\`, with the prompt just before). Relevant when the session ran too long, or when the handoff shows a recurring need (e.g. "write down where we are before starting afresh").
- **handoff** (the session's last prompt). Relevant when it is a handoff or a recurring closing task.
- **repeated_requests** (every typed prompt). Spot the **intents** that come back within the session, or that look like a ritual (a way of asking, a sequence of steps): candidates for automation (skill, command, hook).
- **autonomy** (messages sent while the agent worked, plan mode). Relevant when it is a course correction mid-way.

### cost / delivery
- **api_errors**, **pull_requests**, **git**, **local_review_messages**: context. No judgement needed, unless something is off.

## Answer

Answer with **one JSON object only**, valid, without comments or text around it, with exactly this shape. **Write its texts in the language the user writes in, in this session's prompts**; keys stay in English.

{
  "session_id": "\u2026",
  "summary": "3 to 6 sentences: what the user wanted, what was done, how it went.",
  "goal": "the main goal in one sentence",
  "outcome": "achieved | partially_achieved | not_achieved | unclear",
  "signals": {
    "<family>": {
      "<signal>": {
        "occurrences": 0,
        "relevant": [ { "agent": "main", "uuid": "\u2026", "verdict": "what happened, in one sentence", "why_relevant": "what it reveals", "quote": "a short exact excerpt (\u2264 200 characters)" } ],
        "not_relevant": [ { "uuid": "\u2026", "reason": "one sentence" } ],
        "note": "optional: sampling, remark"
      }
    }
  },
  "patterns": [ { "name": "short", "description": "a way of working or a request that comes back, or a ritual", "evidence": ["uuid", "\u2026"], "automation_idea": "optional" } ],
  "setup_observations": [ { "subject": "skill | rule | hook | permission | subagent | other", "observation": "\u2026", "evidence": ["uuid"] } ],
  "improvement_hints": [ { "hint": "a concrete lead", "target": "CLAUDE.md | CLAUDE.local.md | skill | hook | permission | workflow | user | tool", "evidence": ["uuid"], "confidence": "high | medium | low" } ],
  "confidence": "high | medium | low",
  "limits": "what you could not judge, and why"
}

Rules:
- Include **every family and every signal** of the analytics, even empty ones (\`occurrences: 0\`, empty lists).
- Every \`uuid\` you cite must be one of the analytics or of a conversation you read: they are checked by program, and a moment that does not exist is removed. **Invent nothing**; what you did not check goes into \`limits\`.
- **Mask any secret** (key, token, password) that would appear in a quote.
- A lead without evidence has no place: better no lead than a generic one.`;
var reportPrompt = (sessionId, agents) => `${REPORT_BRIEF}

The session: ${sessionId}, with ${agents - 1} sub-agent(s). Its files are in your working folder.`;

// src/sessionTranscript.ts
var import_node_path17 = require("node:path");
var WIDTH = { result: 500, agent: 1500, user: 3e3 };
var isRecord4 = (x) => typeof x === "object" && x !== null && !Array.isArray(x);
var flat = (s) => s.replace(/\s*\n\s*/g, " \u23CE ");
var asText2 = (x) => typeof x === "string" ? x : x == null ? "" : JSON.stringify(x);
function renderLine(e) {
  const t = e.type;
  const time = typeof e.timestamp === "string" ? e.timestamp.slice(11, 19) : "";
  const m = isRecord4(e.message) ? e.message : {};
  const out = [];
  if (t === "assistant") {
    for (const b of Array.isArray(m.content) ? m.content.filter(isRecord4) : []) {
      if (b.type === "text" && typeof b.text === "string" && b.text.trim())
        out.push(`[${time}] AGENT: ${flat(cut(b.text, WIDTH.agent))}`);
      else if (b.type === "tool_use")
        out.push(`[${time}] AGENT \u2192 ${String(b.name)}: ${flat(toolSummary(String(b.name), b.input))}`);
    }
  } else if (t === "user") {
    const content = m.content;
    const results = Array.isArray(content) ? content.filter((b) => isRecord4(b) && b.type === "tool_result") : [];
    if (results.length) {
      for (const b of results) {
        const body = typeof b.content === "string" ? b.content : textOf2(b.content);
        out.push(`[${time}]   \u2190 ${b.is_error ? "ERROR" : "result"}: ${flat(cut(body, WIDTH.result))}`);
      }
      if (typeof e.toolDenialKind === "string")
        out.push(`[${time}]   \u2190 REFUSED (${e.toolDenialKind}) ${flat(cut(e.userFeedback, 300))}`);
    } else {
      const who2 = isRecord4(e.origin) && typeof e.origin.kind === "string" ? e.origin.kind : "human";
      out.push(`[${time}] USER (${who2}): ${flat(cut(textOf2(content), WIDTH.user))}`);
    }
  } else if (t === "attachment") {
    const a = isRecord4(e.attachment) ? e.attachment : {};
    if (a.type === "hook_success" || a.type === "hook_non_blocking_error" || a.type === "hook_additional_context")
      out.push(`[${time}]   (hook ${String(a.hookName)}: ${flat(cut(asText2(a.stdout ?? a.content), 200))})`);
    else if (a.type === "edited_text_file")
      out.push(`[${time}]   (file changed outside the agent: ${String(a.filename)})`);
    else if (a.type === "queued_command")
      out.push(`[${time}]   (message sent while the agent worked: ${flat(cut(asText2(a.prompt), 300))})`);
  } else if (t === "system" && ["compact_boundary", "away_summary", "local_command"].includes(String(e.subtype)))
    out.push(`[${time}]   (system ${String(e.subtype)}: ${flat(cut(asText2(e.content), 300))})`);
  return out;
}
async function renderSession(sessionFile) {
  const uuids = /* @__PURE__ */ new Set();
  const files = [{ id: "main", file: sessionFile }, ...await subagentFiles(sessionFile)];
  const transcripts = [];
  for (const f of files) {
    const lines = [];
    for (const { n, e } of await readJsonl(f.file)) {
      const uuid = typeof e.uuid === "string" ? e.uuid : "";
      if (uuid) uuids.add(uuid);
      const shown = renderLine(e);
      if (shown.length) lines.push(`L${n} ${uuid || "-"} ${shown.join(" | ")}`);
    }
    transcripts.push({
      agent: f.id,
      name: f.id === "main" ? "conversation-main.txt" : `conversation-${(0, import_node_path17.basename)(f.file, ".jsonl")}.txt`,
      text: lines.join("\n") + "\n"
    });
  }
  return { transcripts, uuids };
}

// src/sessionReports.ts
var REPORTS_SOURCE = "Claude Code session records";
var REPORT_MODEL = "opus";
var REPORT_TIMEOUT_MS = 20 * 6e4;
var REPORT_CONCURRENCY = 4;
var REPORT_COST = { baseUsd: 0.05, perPromptUsd: 0.04, baseMs: 4e4, perPromptMs: 6500 };
async function currentSession(env) {
  const sessions = await new SessionRegistry(localReviewHome(env)).list().catch(() => []);
  return sessionOfProcess(sessions, await processAncestors())?.id;
}
async function planReports(book, transcripts, opts = {}) {
  const plan = { candidates: [], noPrompt: 0, current: 0, oversized: [] };
  const scale = await reportScale(book);
  for (const t of transcripts) {
    if (opts.exclude?.has(t.id) || opts.retroId && await mentions(t.file, opts.retroId)) {
      plan.current++;
      continue;
    }
    const analytics = await analyseSession(t.file).catch(() => null);
    if (!analytics) continue;
    if (analytics.counts.typed_prompts === 0) {
      plan.noPrompt++;
      continue;
    }
    const existing = await readSessionReport(book, t.id);
    const upToDate = existing !== null && (existing.v > SESSION_REPORT_VERSION || existing.covered.lines >= analytics.counts.lines);
    const estimateMs = expected(analytics.counts.typed_prompts).ms * scale.time;
    if (!upToDate && estimateMs > REPORT_TIMEOUT_MS) {
      (plan.oversized ??= []).push(await oversized(t, analytics, estimateMs, existing !== null));
      if (existing) plan.candidates.push({ transcript: t, analytics, action: "keep", stale: true, estimateMs });
      continue;
    }
    plan.candidates.push({ transcript: t, analytics, action: upToDate ? "keep" : "write", estimateMs });
  }
  return plan;
}
async function oversized(t, a, estimateMs, report) {
  const tokens = Object.values(a.cost.tokens_by_model).flatMap((byKind) => Object.values(byKind)).reduce((n, x) => n + x, 0);
  const compactions = (a.signals.workflow?.context_pressure ?? []).filter((o) => o.kind === "compaction").length;
  return {
    id: t.id,
    start: a.start ?? t.start,
    end: a.end ?? t.start,
    prompts: a.counts.typed_prompts,
    estimateMs,
    tokens,
    bytes: await sizeOf(t.file),
    compactions,
    report
  };
}
var fileSize = (path) => (0, import_promises16.stat)(path).then(
  (x) => x.size,
  () => 0
);
async function sizeOf(file) {
  const below = async (dir) => {
    let n = 0;
    for (const e of await (0, import_promises16.readdir)(dir, { withFileTypes: true }).catch(() => [])) {
      const path = (0, import_node_path18.join)(dir, e.name);
      n += e.isDirectory() ? await below(path) : await fileSize(path);
    }
    return n;
  };
  return await fileSize(file) + await below((0, import_node_path18.join)((0, import_node_path18.dirname)(file), (0, import_node_path18.basename)(file, ".jsonl")));
}
var mentions = async (file, text) => (await (0, import_promises16.readFile)(file, "utf8").catch(() => "")).includes(text);
var expected = (prompts) => ({
  costUsd: REPORT_COST.baseUsd + REPORT_COST.perPromptUsd * prompts,
  ms: REPORT_COST.baseMs + REPORT_COST.perPromptMs * prompts
});
async function reportScale(book) {
  let actualCost = 0;
  let expectedCost = 0;
  let actualMs = 0;
  let expectedMs = 0;
  for (const id of await sessionReportIds(book)) {
    const r = await readSessionReport(book, id);
    if (!r) continue;
    const counts = r.analytics.counts;
    const e = expected(typeof counts?.typed_prompts === "number" ? counts.typed_prompts : 0);
    if (r.run.costUsd != null) {
      actualCost += r.run.costUsd;
      expectedCost += e.costUsd;
    }
    if (r.run.durationMs != null) {
      actualMs += r.run.durationMs;
      expectedMs += e.ms;
    }
  }
  return { cost: expectedCost ? actualCost / expectedCost : 1, time: expectedMs ? actualMs / expectedMs : 1 };
}
async function estimateReports(book, prompts) {
  const scale = await reportScale(book);
  const workers = Array.from({ length: REPORT_CONCURRENCY }, () => 0);
  let costUsd = 0;
  for (const p of [...prompts].sort((a, b) => b - a)) {
    const e = expected(p);
    costUsd += e.costUsd * scale.cost;
    const free = workers.indexOf(Math.min(...workers));
    workers[free] += e.ms * scale.time;
  }
  return { costUsd, ms: Math.max(0, ...workers) };
}
function reportArgs(prompt) {
  return [
    "-p",
    prompt,
    "--model",
    REPORT_MODEL,
    "--safe-mode",
    "--tools",
    "Read,Grep",
    "--no-session-persistence",
    "--permission-mode",
    "default",
    "--output-format",
    "json"
  ];
}
var isRecord5 = (x) => typeof x === "object" && x !== null && !Array.isArray(x);
function jsonOfAnswer(text) {
  const candidates = [text.trim(), /```(?:json)?\s*([\s\S]*?)```/.exec(text)?.[1] ?? ""];
  const first = text.indexOf("{");
  const last = text.lastIndexOf("}");
  if (first !== -1 && last > first) candidates.push(text.slice(first, last + 1));
  for (const c of candidates) {
    try {
      const v = JSON.parse(c);
      if (isRecord5(v)) return v;
    } catch {
    }
  }
  return null;
}
function maskAll(x) {
  if (typeof x === "string") return mask(x);
  if (Array.isArray(x)) return x.map(maskAll);
  if (isRecord5(x)) return Object.fromEntries(Object.entries(x).map(([k, v]) => [k, maskAll(v)]));
  return x;
}
function dropUnknownMoments(node, known) {
  if (Array.isArray(node))
    return node.filter((x) => !(isRecord5(x) && typeof x.uuid === "string" && !known.has(x.uuid))).map((x) => dropUnknownMoments(x, known));
  if (isRecord5(node))
    return Object.fromEntries(
      Object.entries(node).map(([k, v]) => [
        k,
        k === "evidence" && Array.isArray(v) ? v.filter((x) => typeof x !== "string" || known.has(x)) : dropUnknownMoments(v, known)
      ])
    );
  return node;
}
var tokensOf2 = (usage) => {
  if (!isRecord5(usage)) return null;
  const n = ["input_tokens", "output_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"].map((k) => usage[k]).filter((v) => typeof v === "number").reduce((s, v) => s + v, 0);
  return n || null;
};
async function writeReport(c, env, run = runProcess, timeoutMs = REPORT_TIMEOUT_MS) {
  const work = await (0, import_promises16.mkdtemp)((0, import_node_path18.join)((0, import_node_os3.tmpdir)(), "lr-session-report-"));
  try {
    const { transcripts, uuids } = await renderSession(c.transcript.file);
    await (0, import_promises16.writeFile)((0, import_node_path18.join)(work, "analytics.json"), JSON.stringify(c.analytics, null, 1));
    for (const t of transcripts) await (0, import_promises16.writeFile)((0, import_node_path18.join)(work, t.name), t.text);
    const claude = env.LR_CLAUDE_BIN?.trim() || "claude";
    const r = await run(claude, reportArgs(reportPrompt(c.transcript.id, transcripts.length)), {
      cwd: work,
      env,
      timeoutMs
    });
    if (r.timedOut)
      return fail(`it took more than ${Math.round(timeoutMs / 6e4)} min`, { costUsd: null, ms: null, tokens: null });
    let out;
    try {
      out = JSON.parse(r.stdout);
    } catch {
      const why = (r.stderr || r.stdout).trim().split("\n").at(-1) ?? "";
      return fail(`Claude Code ended with code ${r.code ?? "?"}${why ? `: ${why}` : ""}`, {
        costUsd: null,
        ms: null,
        tokens: null
      });
    }
    const spent = {
      costUsd: typeof out.total_cost_usd === "number" ? out.total_cost_usd : null,
      ms: typeof out.duration_ms === "number" ? out.duration_ms : null,
      tokens: tokensOf2(out.usage)
    };
    const answer = typeof out.result === "string" ? out.result : "";
    if (out.is_error === true) return fail(answer.split("\n")[0] || "an error", spent);
    const raw = jsonOfAnswer(answer);
    if (!raw || typeof raw.summary !== "string" || !isRecord5(raw.signals))
      return fail("the model did not answer with a report", spent);
    const cited = citedMoments(raw);
    const unknown = [...cited].filter((u) => !uuids.has(u)).sort();
    const analysis = maskAll(dropUnknownMoments({ ...raw, session_id: c.transcript.id }, uuids));
    const a = c.analytics;
    return {
      kind: "done",
      report: {
        v: SESSION_REPORT_VERSION,
        session: c.transcript.id,
        agent: "Claude Code",
        folder: a.cwd ?? c.transcript.cwd,
        start: a.start ?? c.transcript.start,
        end: a.end ?? c.transcript.start,
        covered: { lines: a.counts.lines },
        generatedAt: (/* @__PURE__ */ new Date()).toISOString(),
        model: REPORT_MODEL,
        run: { costUsd: spent.costUsd, durationMs: spent.ms, tokens: spent.tokens },
        checks: { citedMoments: cited.size, unknownMoments: unknown },
        analysis,
        analytics: a
      }
    };
  } finally {
    await (0, import_promises16.rm)(work, { recursive: true, force: true });
  }
}
var fail = (reason, spent) => ({ kind: "failed", reason, costUsd: spent.costUsd, durationMs: spent.ms, tokens: spent.tokens });
var OVERSIZED_REASON = "too long to analyse: its report would take more than the 20 minutes a report may take";
async function writeReports(book, plan, env, run = runProcess, concurrency = REPORT_CONCURRENCY) {
  const started = Date.now();
  const refs = /* @__PURE__ */ new Map();
  let costUsd = null;
  let tokens = null;
  const queue = plan.candidates.filter((c) => c.action === "write").sort((a, b) => (b.estimateMs ?? 0) - (a.estimateMs ?? 0));
  for (const c of plan.candidates)
    if (c.action === "keep")
      refs.set(c.transcript.id, {
        id: c.transcript.id,
        start: c.transcript.start,
        status: "reused",
        ...c.stale ? { reason: "too long to analyse again: its earlier report is read" } : {}
      });
  const worker = async () => {
    for (let c = queue.shift(); c; c = queue.shift()) {
      const outcome = await writeReport(c, env, run).catch(
        (err) => fail(err instanceof Error ? err.message : String(err), {
          costUsd: null,
          ms: null,
          tokens: null
        })
      );
      const spent = outcome.kind === "done" ? outcome.report.run : outcome;
      if (spent.costUsd !== null) costUsd = (costUsd ?? 0) + spent.costUsd;
      if (spent.tokens !== null) tokens = (tokens ?? 0) + spent.tokens;
      const ref = { id: c.transcript.id, start: c.transcript.start, status: "analysed" };
      if (outcome.kind === "done") await writeSessionReport(book, outcome.report);
      else if (await readSessionReport(book, c.transcript.id))
        Object.assign(ref, { status: "reused", reason: `not brought up to date: ${outcome.reason}` });
      else Object.assign(ref, { status: "failed", reason: outcome.reason });
      refs.set(c.transcript.id, ref);
    }
  };
  await Promise.all(Array.from({ length: Math.max(1, concurrency) }, worker));
  const ordered = plan.candidates.map((c) => refs.get(c.transcript.id)).filter((x) => !!x);
  for (const o of plan.oversized ?? [])
    if (!o.report) ordered.push({ id: o.id, start: o.start, status: "excluded", reason: OVERSIZED_REASON });
  return { refs: ordered, costUsd, durationMs: Date.now() - started, tokens };
}

// src/retroJev.ts
var import_promises17 = require("node:fs/promises");
var JEV_URL = "https://jevtypesafeai.com/api/v1/decide";
var INTRO = "Code review thread between a developer and their AI coding agent. ";
var QUESTIONS = {
  category: {
    type: "choice",
    instructions: INTRO + "Which category best explains why the developer commented (the root cause, not the symptom)?",
    criteria: Object.fromEntries(Object.entries(FEEDBACK_CATEGORIES).map(([n, d]) => [n, d]))
  },
  missing_rule: {
    type: "noul",
    instructions: INTRO + "Does the developer's feedback reveal a constraint, convention or fact specific to THIS project (not general good practice) that the rules files do not state?"
  },
  ignored_rule: {
    type: "noul",
    instructions: INTRO + "Does the developer's feedback point to something the rules files already state, that the agent did not follow?"
  }
};
async function readJevKey(env = process.env) {
  const fromEnv = env.JEV_API_KEY?.trim();
  if (fromEnv) return fromEnv;
  const s = await jevKeyStatus(env);
  if (!s.exists) throw new Error(`no Jev key: ${s.path} does not exist (lr retro key tells how to add one)`);
  if (!s.ok) throw new Error(`the Jev key file is not safe, fix it first: ${s.fixes.join("; ")}`);
  const key = (await (0, import_promises17.readFile)(s.path, "utf8")).trim();
  if (!key) throw new Error(`the Jev key file ${s.path} is empty`);
  return key;
}
var unit = (x) => typeof x === "number" && x >= 0 && x <= 1 ? x : void 0;
async function decide(text, rules, deps) {
  const res = await deps.fetch(deps.url ?? JEV_URL, {
    method: "POST",
    headers: { Authorization: `Bearer ${deps.key}`, "Content-Type": "application/json" },
    body: JSON.stringify({ state: `Rules files of the project:
${rules}

---

${text}`, questions: QUESTIONS }),
    signal: AbortSignal.timeout(deps.timeoutMs ?? 6e4)
  });
  if (!res.ok) throw new Error(`Jev answered HTTP ${res.status}`);
  const o = await res.json();
  const a = o.answers ?? {};
  const category = Number(a.category?.choice);
  if (!FEEDBACK_CATEGORIES[category]) throw new Error("Jev gave no category");
  const label = { category };
  const conf = unit(a.category?.confidence);
  const missing = unit(a.missing_rule?.noul);
  const ignored = unit(a.ignored_rule?.noul);
  if (conf !== void 0) label.confidence = conf;
  if (missing !== void 0) label.missingRule = missing;
  if (ignored !== void 0) label.ignoredRule = ignored;
  return { label, cost: typeof o.usage?.cost_usd === "number" ? o.usage.cost_usd : 0 };
}
async function classifyWithJev(threads, rules, deps) {
  const result = { labels: {}, failed: [], costUsd: 0 };
  const queue = [...threads];
  const worker = async () => {
    for (let t = queue.shift(); t; t = queue.shift()) {
      let error = "";
      for (let attempt = 0; attempt < 2; attempt++) {
        try {
          const { label, cost } = await decide(t.text, rules, deps);
          result.labels[t.id] = label;
          result.costUsd += cost;
          error = "";
          break;
        } catch (err) {
          error = err instanceof Error && err.message.startsWith("Jev ") ? err.message : `request failed (${err?.name ?? "error"})`;
        }
      }
      if (error) result.failed.push({ thread: t.id, error });
    }
  };
  await Promise.all(Array.from({ length: Math.max(1, deps.concurrency ?? 4) }, worker));
  return result;
}

// src/retroConversation.ts
var import_promises18 = require("node:fs/promises");
var import_node_path19 = require("node:path");
function linkedReplies(t) {
  return t.conversation.flatMap(
    (e) => e.kind === "comment" && e.author === "agent" && e.session ? [{ session: e.session.id, ...e.session.message ? { message: e.session.message } : {}, at: e.at }] : []
  );
}
var SAFE_ID = /^[A-Za-z0-9_-]{1,128}$/;
async function transcriptsOf(claudeDir, session) {
  if (!SAFE_ID.test(session)) return [];
  const projects = (0, import_node_path19.join)(claudeDir, "projects");
  let folders;
  try {
    folders = await (0, import_promises18.readdir)(projects);
  } catch {
    return [];
  }
  const found2 = [];
  for (const folder of folders.sort()) {
    const main = (0, import_node_path19.join)(projects, folder, `${session}.jsonl`);
    if (await readable(main)) found2.push(main);
    try {
      const sub = (0, import_node_path19.join)(projects, folder, session, "subagents");
      for (const f of (await (0, import_promises18.readdir)(sub)).sort()) if (f.endsWith(".jsonl")) found2.push((0, import_node_path19.join)(sub, f));
    } catch {
    }
  }
  return found2;
}
var readable = (file) => (0, import_promises18.stat)(file).then(
  (s) => s.isFile(),
  () => false
);
function parseTranscript(text) {
  const entries = [];
  for (const line of text.split("\n")) {
    if (line.trim() === "") continue;
    try {
      const raw = JSON.parse(line);
      if (typeof raw === "object" && raw !== null && !Array.isArray(raw)) entries.push(raw);
    } catch {
    }
  }
  return entries;
}
var blocks = (e) => Array.isArray(e.message?.content) ? e.message.content.filter((b) => typeof b === "object" && b !== null) : [];
var toolUses = (e) => e.type === "assistant" ? blocks(e).filter((b) => b.type === "tool_use") : [];
function isPrompt(e) {
  if (e.type !== "user" || e.isMeta) return false;
  const c = e.message?.content;
  if (typeof c === "string") return true;
  const bs = blocks(e);
  return bs.some((b) => b.type === "text") && !bs.some((b) => b.type === "tool_result");
}
var LATE_MS = 6e4;
function findReply(entries, reply, threadId) {
  if (reply.message) {
    const i = entries.findIndex((e) => toolUses(e).some((b) => b.id === reply.message));
    if (i >= 0) return i;
  }
  const until = Date.parse(reply.at) + LATE_MS;
  for (let i = entries.length - 1; i >= 0; i--) {
    const e = entries[i];
    if (Date.parse(e.timestamp ?? "") > until) continue;
    const named2 = toolUses(e).some((b) => {
      const command = b.input?.command;
      return typeof command === "string" && /\blr\b/.test(command) && command.includes(threadId);
    });
    if (named2) return i;
  }
  return -1;
}
var clip = (text, max) => {
  const t = text.trim();
  return t.length <= max ? t : `${t.slice(0, max)}\u2026 (${t.length - max} more characters)`;
};
var oneLine = (text, max) => clip(text.replace(/\s+/g, " "), max);
function promptText(e) {
  const c = e.message?.content;
  if (typeof c === "string") return c;
  return blocks(e).filter((b) => b.type === "text").map((b) => b.text ?? "").join("\n");
}
function resultText(b) {
  if (typeof b.content === "string") return b.content;
  if (Array.isArray(b.content))
    return b.content.filter((x) => x?.type === "text").map((x) => x.text ?? "").join("\n");
  return "";
}
function toolLine(b) {
  const input = b.input ?? {};
  const pick = (k) => typeof input[k] === "string" ? input[k] : void 0;
  const what = pick("command") ?? pick("file_path") ?? pick("notebook_path") ?? (pick("pattern") ? `${pick("pattern")}${pick("path") ? ` in ${pick("path")}` : ""}` : void 0) ?? pick("description") ?? pick("url") ?? JSON.stringify(input);
  return `${b.name ?? "tool"}: ${oneLine(what, 400)}`;
}
function renderEntry(e, mark, promptMax = 2e3) {
  const at = e.timestamp ? e.timestamp.slice(11, 19) : "";
  if (isPrompt(e)) return [`- **Prompt** (${at}): ${clip(promptText(e), promptMax)}`];
  if (e.type === "assistant") {
    return blocks(e).flatMap((b) => {
      if (b.type === "text" && b.text?.trim()) return [`- **Claude** (${at}): ${clip(b.text, 1500)}`];
      if (b.type === "tool_use")
        return [`- ${mark && b.id === mark ? "**This call wrote the reply** \u2192 " : "\u2192 "}${toolLine(b)}`];
      return [];
    });
  }
  if (e.type === "user")
    return blocks(e).filter((b) => b.type === "tool_result").map((b) => `  - ${b.is_error ? "error" : "result"}: ${oneLine(resultText(b), 300) || "(empty)"}`);
  return [];
}
function turnUsage(entries) {
  const calls = /* @__PURE__ */ new Map();
  for (const e of entries)
    if (e.type === "assistant" && e.message?.usage) calls.set(e.message.id ?? String(calls.size), e.message.usage);
  if (calls.size === 0) return null;
  let input = 0;
  let cached = 0;
  let output = 0;
  for (const u of calls.values()) {
    input += (u.input_tokens ?? 0) + (u.cache_creation_input_tokens ?? 0) + (u.cache_read_input_tokens ?? 0);
    cached += u.cache_read_input_tokens ?? 0;
    output += u.output_tokens ?? 0;
  }
  return `${calls.size} model call(s), ${input} tokens in (${cached} read from the cache), ${output} out`;
}
var EXCERPT_BUDGET = 12e3;
function excerpt(entries, at, budget = EXCERPT_BUDGET) {
  let start = at;
  while (start > 0 && !isPrompt(entries[start])) start--;
  let end = at + 1;
  let texts = 0;
  while (end < entries.length && !isPrompt(entries[end]) && texts < 2 && end - at <= 12) {
    if (blocks(entries[end]).some((b) => b.type === "text" && entries[end].type === "assistant")) texts++;
    end++;
  }
  const mark = toolUses(entries[at]).find(() => true)?.id ?? null;
  const prompt = isPrompt(entries[start]) ? renderEntry(entries[start], null, Math.min(2e3, budget >> 1)) : [];
  const steps = entries.slice(isPrompt(entries[start]) ? start + 1 : start, end).map((e) => renderEntry(e, mark)).filter((s) => s.length > 0);
  let size = prompt.join("\n").length;
  let first = steps.length;
  while (first > 0 && size + steps[first - 1].join("\n").length <= budget) size += steps[--first].join("\n").length;
  const lines = [...prompt];
  if (first > 0) lines.push(`- (\u2026 ${first} earlier step(s) of this turn left out)`);
  lines.push(...steps.slice(first).flat());
  const skill = entries[at].attributionSkill;
  const usage = turnUsage(entries.slice(start, end));
  if (skill) lines.push(`- Skill in use: ${skill}`);
  if (usage) lines.push(`- This turn up to there: ${usage}`);
  return lines.join("\n");
}
async function threadConversations(thread, claudeDir, read = (f) => (0, import_promises18.readFile)(f, "utf8")) {
  const replies = linkedReplies(thread);
  const sessions = [...new Set(replies.map((r) => r.session))];
  const head = `# The agent's conversation for thread ${thread.id}`;
  if (replies.length === 0)
    return {
      text: `${head}

No conversation is linked to this thread: its replies were written before Local Review recorded the agent's session, or by an agent that does not give it. Analyse it from the thread alone.`,
      sessions,
      available: false,
      linked: 0
    };
  const budget = Math.floor(EXCERPT_BUDGET / replies.length);
  const parsed = /* @__PURE__ */ new Map();
  const parts = [];
  let found2 = 0;
  for (const reply of replies) {
    const title = `## Reply of ${reply.at} \u2014 session ${reply.session}`;
    const files = await transcriptsOf(claudeDir, reply.session);
    if (files.length === 0) {
      parts.push(
        `${title}

No longer available: Claude Code deletes its conversations after 30 days by default (the cleanupPeriodDays setting), and keeps them only on the machine where they ran. Analyse this reply from the thread alone.`
      );
      continue;
    }
    found2++;
    let shown = false;
    for (const file of files) {
      if (!parsed.has(file)) parsed.set(file, parseTranscript(await read(file).catch(() => "")));
      const entries = parsed.get(file);
      const at = findReply(entries, reply, thread.id);
      if (at < 0) continue;
      parts.push(`${title}

Transcript: ${file}

${excerpt(entries, at, budget)}`);
      shown = true;
      break;
    }
    if (!shown)
      parts.push(
        `${title}

The conversation exists (${files[0]}), but this reply was not found in it: read it there if needed.`
      );
  }
  const n = replies.length;
  return {
    text: [
      head,
      `${n} agent repl${n === 1 ? "y" : "ies"} linked to a conversation, ${found2} still available.`,
      ...parts
    ].join("\n\n"),
    sessions,
    available: found2 > 0,
    linked: n
  };
}

// src/retroSetup.ts
var import_promises19 = require("node:fs/promises");
var import_node_path20 = require("node:path");
var FILE_CAP = 24e3;
var SETUP_BUDGET = 1e5;
var orNull2 = (p) => p.catch(() => null);
var exists = async (p) => await orNull2((0, import_promises19.stat)(p)) !== null;
async function markdown(dir, depth = 3) {
  if (depth < 0) return [];
  const names = await (0, import_promises19.readdir)(dir).catch(() => []);
  const out = [];
  for (const name of names.sort()) {
    const p = (0, import_node_path20.join)(dir, name);
    const st = await orNull2((0, import_promises19.stat)(p));
    if (!st) continue;
    if (st.isDirectory()) out.push(...await markdown(p, depth - 1));
    else if (name.endsWith(".md")) out.push(p);
  }
  return out;
}
var isInside = (path, dir) => {
  const rel = (0, import_node_path20.relative)(dir, path);
  return rel !== "" && !rel.startsWith("..") && !(0, import_node_path20.isAbsolute)(rel);
};
function projectDirs(root, repos, home) {
  const parents = [];
  let dir = (0, import_node_path20.dirname)((0, import_node_path20.resolve)(root));
  const top = (0, import_node_path20.resolve)(home);
  while (dir !== (0, import_node_path20.dirname)(dir) && isInside(dir, top)) {
    parents.unshift(dir);
    dir = (0, import_node_path20.dirname)(dir);
  }
  return [.../* @__PURE__ */ new Set([...parents, (0, import_node_path20.resolve)(root), ...repos.map((r) => (0, import_node_path20.resolve)(r))])];
}
async function found(root, repos, home, claudeDir) {
  const files = [];
  const add = async (path, kind, scope) => {
    if (!files.some((f) => f.path === path) && await exists(path)) files.push({ path, kind, scope });
  };
  const dirs = projectDirs(root, repos, home);
  for (const d of dirs)
    for (const name of ["CLAUDE.md", "CLAUDE.local.md", ".claude/CLAUDE.md"])
      await add((0, import_node_path20.join)(d, name), "rules", "project");
  await add((0, import_node_path20.join)(claudeDir, "CLAUDE.md"), "rules", "user");
  const setupOf = async (claude, agents, scope) => {
    for (const f of await markdown((0, import_node_path20.join)(claude, "rules"))) await add(f, "rules", scope);
    for (const f of await markdown((0, import_node_path20.join)(claude, "skills"), 2))
      if ((0, import_node_path20.basename)(f) === "SKILL.md") await add(f, "skill", scope);
    for (const f of await markdown((0, import_node_path20.join)(claude, "commands"))) await add(f, "command", scope);
    for (const f of await markdown((0, import_node_path20.join)(claude, "agents"))) await add(f, "agent", scope);
    for (const name of ["settings.json", "settings.local.json"]) await add((0, import_node_path20.join)(claude, name), "hooks", scope);
    for (const f of await markdown(agents)) await add(f, "other", scope);
  };
  for (const d of [(0, import_node_path20.resolve)(root), ...repos.map((r) => (0, import_node_path20.resolve)(r))])
    await setupOf((0, import_node_path20.join)(d, ".claude"), (0, import_node_path20.join)(d, ".agents"), "project");
  await setupOf(claudeDir, (0, import_node_path20.join)(home, ".agents"), "user");
  return files;
}
var frontName = (text) => /^---\n[\s\S]*?^name:\s*["']?([^"'\n]+?)["']?\s*$/m.exec(text)?.[1]?.trim();
async function setupTools(root, repos, home, claudeDir = (0, import_node_path20.join)(home, ".claude")) {
  const out = [];
  for (const f of await found(root, repos, home, claudeDir)) {
    if (f.kind !== "skill" && f.kind !== "command" && f.kind !== "agent") continue;
    const text = await orNull2((0, import_promises19.readFile)(f.path, "utf8")) ?? "";
    if (f.kind === "skill") {
      if ((0, import_node_path20.basename)((0, import_node_path20.dirname)((0, import_node_path20.dirname)(f.path))) !== "skills") continue;
      out.push({ ...f, kind: "skill", name: (0, import_node_path20.basename)((0, import_node_path20.dirname)(f.path)), file: f.path, path: (0, import_node_path20.dirname)(f.path) });
    } else if (f.kind === "command") {
      const dir = f.path.slice(0, f.path.lastIndexOf("/commands/") + "/commands/".length);
      const name = f.path.slice(dir.length, -".md".length).split("/").join(":");
      out.push({ ...f, kind: "command", name, file: f.path, path: f.path });
    } else
      out.push({ ...f, kind: "agent", name: frontName(text) ?? (0, import_node_path20.basename)(f.path, ".md"), file: f.path, path: f.path });
  }
  return out;
}
function header(text) {
  const m = /^---\n([\s\S]*?)\n---/.exec(text);
  return m ? `---
${m[1]}
---
(header only: read the file for the rest)` : text.split("\n").slice(0, 5).join("\n");
}
function hooksOf(text) {
  try {
    const hooks = JSON.parse(text).hooks;
    return hooks ? JSON.stringify({ hooks }, null, 2) : null;
  } catch {
    return null;
  }
}
async function collectSetup(root, repos, home, claudeDir = (0, import_node_path20.join)(home, ".claude"), budget = SETUP_BUDGET) {
  const out = [];
  let used = 0;
  const all = await found(root, repos, home, claudeDir);
  const order = (f) => (f.kind === "rules" || f.kind === "hooks" ? 0 : 1) + (f.scope === "user" ? 2 : 0);
  for (const f of [...all].sort((a, b) => order(a) - order(b))) {
    const raw = await orNull2((0, import_promises19.readFile)(f.path, "utf8"));
    if (raw === null) continue;
    let content = f.kind === "hooks" ? hooksOf(raw) : raw;
    if (content === null) continue;
    let shown = "full";
    if (f.kind !== "rules" && f.kind !== "hooks" && used + Math.min(content.length, FILE_CAP) > budget) {
      content = header(content);
      shown = "header";
    } else if (content.length > FILE_CAP) {
      content = content.slice(0, FILE_CAP) + "\n[\u2026 cut: read the file for the rest]";
      shown = "truncated";
    }
    used += content.length;
    out.push({ ...f, bytes: Buffer.byteLength(raw), content, shown });
  }
  return out;
}
var TITLES = {
  rules: "Rules files",
  hooks: "Hooks (from the settings)",
  skill: "Skills",
  command: "Commands",
  agent: "Sub-agents",
  other: "Other agent files (.agents/)"
};
function renderSetup(root, home, files) {
  const label = (p) => {
    if (isInside(p, (0, import_node_path20.resolve)(root))) return (0, import_node_path20.relative)(root, p);
    if (isInside(p, (0, import_node_path20.resolve)(home))) return "~/" + (0, import_node_path20.relative)(home, p);
    return p;
  };
  const lines = [
    `# Claude Code setup \u2014 ${root}`,
    "",
    `${files.length} files. The project's files come first, then the user's (~). Paths relative to the project.`,
    "Targets: project-shared = a CLAUDE.md or .claude/ file committed in a repository; project-personal = CLAUDE.local.md",
    "(or the CLAUDE.md of a parent folder outside any repository); user = ~/.claude/CLAUDE.md, ~/.claude/."
  ];
  for (const kind of Object.keys(TITLES)) {
    const fs = files.filter((f) => f.kind === kind);
    lines.push("", `## ${TITLES[kind]}`, "");
    if (fs.length === 0) lines.push("None.");
    for (const f of fs)
      lines.push(
        `### ${label(f.path)} (${f.scope}${f.shown === "full" ? "" : `, ${f.shown}`}, ${f.bytes} bytes)`,
        "",
        "````",
        f.content.trimEnd(),
        "````",
        ""
      );
  }
  return lines.join("\n");
}

// src/toolUsage.ts
var import_node_fs3 = require("node:fs");
var import_promises20 = require("node:fs/promises");
var import_node_path21 = require("node:path");
var import_node_readline2 = require("node:readline");
var USAGE_SOURCE = "Claude Code";
var DEFAULT_KEPT_DAYS = 30;
var bump2 = (m, k) => m.set(k, (m.get(k) ?? 0) + 1);
var isRecord6 = (x) => typeof x === "object" && x !== null && !Array.isArray(x);
var COMMAND2 = /<command-name>\/?([^<]+)<\/command-name>/;
function userText(content) {
  if (typeof content === "string") return content;
  if (!Array.isArray(content)) return "";
  return content.filter(isRecord6).map((b) => b.type === "text" && typeof b.text === "string" ? b.text : "").join("\n");
}
async function readUses(file, use) {
  const lines = (0, import_node_readline2.createInterface)({ input: (0, import_node_fs3.createReadStream)(file, { encoding: "utf8" }), crlfDelay: Infinity });
  try {
    for await (const line of lines) {
      const ts = /"timestamp":"([^"]+)"/.exec(line)?.[1];
      if (ts && (use.last === null || ts > use.last)) use.last = ts;
      if (!line.includes("command-name") && !line.includes('"Skill"') && !line.includes("subagent_type")) continue;
      let e;
      try {
        e = JSON.parse(line);
      } catch {
        continue;
      }
      const m = isRecord6(e.message) ? e.message : {};
      if (e.type === "user") {
        const cmd = COMMAND2.exec(userText(m.content));
        if (cmd) bump2(use.typed, cmd[1].trim());
      } else if (e.type === "assistant" && Array.isArray(m.content))
        for (const b of m.content.filter(isRecord6)) {
          if (b.type !== "tool_use" || !isRecord6(b.input)) continue;
          if (b.name === "Skill" && typeof b.input.skill === "string") bump2(use.called, b.input.skill.trim());
          if ((b.name === "Agent" || b.name === "Task") && typeof b.input.subagent_type === "string")
            bump2(use.agents, b.input.subagent_type.trim());
        }
    }
  } finally {
    lines.close();
  }
}
async function sessionUses(file) {
  const use = { typed: /* @__PURE__ */ new Map(), called: /* @__PURE__ */ new Map(), agents: /* @__PURE__ */ new Map(), last: null };
  await readUses(file, use);
  for (const s of await subagentFiles(file)) await readUses(s.file, use);
  return use;
}
async function allTranscripts2(claudeDir) {
  const projects = (0, import_node_path21.join)(claudeDir, "projects");
  const out = [];
  for (const dir of await (0, import_promises20.readdir)(projects).catch(() => []))
    for (const name of await (0, import_promises20.readdir)((0, import_node_path21.join)(projects, dir)).catch(() => []))
      if (name.endsWith(".jsonl")) out.push((0, import_node_path21.join)(projects, dir, name));
  return out;
}
async function keptDays(claudeDir) {
  try {
    const raw = JSON.parse(await (0, import_promises20.readFile)((0, import_node_path21.join)(claudeDir, "settings.json"), "utf8"));
    const n = raw.cleanupPeriodDays;
    return typeof n === "number" && n > 0 ? n : DEFAULT_KEPT_DAYS;
  } catch {
    return DEFAULT_KEPT_DAYS;
  }
}
var named = (m, name) => m.get(name) ?? 0;
function countUses(tools, sessions) {
  return tools.map((t) => {
    let byUser = 0;
    let byAgent = 0;
    let used = 0;
    let lastUsed = null;
    for (const s of sessions) {
      const u = t.kind === "agent" ? 0 : named(s.typed, t.name);
      const a = t.kind === "agent" ? named(s.agents, t.name) : t.kind === "skill" ? named(s.called, t.name) : 0;
      const c = t.kind === "command" ? named(s.called, t.name) : 0;
      byUser += u;
      byAgent += a + c;
      if (u + a + c > 0) {
        used++;
        if (s.last && (lastUsed === null || s.last > lastUsed)) lastUsed = s.last;
      }
    }
    return { byUser, byAgent, sessions: used, lastUsed };
  });
}
var oldest = (xs) => xs.map((x) => x.start).sort()[0] ?? null;
async function setupUsage(tools, claudeDir, root, env, exclude = /* @__PURE__ */ new Set()) {
  const until = (/* @__PURE__ */ new Date()).toISOString();
  const project = (await projectTranscripts(claudeDir, root, { since: null, until }, env)).filter(
    (t) => !exclude.has(t.id)
  );
  const projectUses = await Promise.all(project.map((t) => sessionUses(t.file)));
  const userTools = tools.filter((t) => t.scope === "user");
  let all = [];
  let allUses = [];
  let allSince = null;
  if (userTools.length > 0) {
    all = (await allTranscripts2(claudeDir)).filter(
      (f) => !exclude.has(f.slice(f.lastIndexOf("/") + 1, -".jsonl".length))
    );
    allUses = await Promise.all(all.map((f) => sessionUses(f)));
    allSince = allUses.map((u) => u.last).filter((x) => x !== null).sort()[0] ?? null;
  }
  const kept = await keptDays(claudeDir);
  const projectTools = tools.filter((t) => t.scope === "project");
  const counts = /* @__PURE__ */ new Map();
  countUses(projectTools, projectUses).forEach((c, i) => counts.set(projectTools[i], c));
  countUses(userTools, allUses).forEach((c, i) => counts.set(userTools[i], c));
  const windows = [
    { scope: "project", sessions: project.length, since: oldest(project), keptDays: kept },
    ...userTools.length ? [{ scope: "user", sessions: all.length, since: allSince, keptDays: kept }] : []
  ];
  return {
    source: USAGE_SOURCE,
    tools: tools.map((t) => ({
      kind: t.kind,
      name: t.name,
      scope: t.scope,
      file: t.file,
      path: t.path,
      ...counts.get(t)
    })),
    windows
  };
}

// src/retroCli.ts
var RETRO_CLI_USAGE = `lr-retro \u2014 the Claude Code part of Local Review's retros

  lr-retro setup <retro-id> [--root <dir>]   Write Claude Code's setup of the project (rules files,
                                             .claude/ and .agents/ of the project and of ~) in a file
                                             of the retro, for its analysis
  lr-retro jev <retro-id> [--root <dir>]     Classify the retro's threads with Jev (needs a key:
                                             lr retro key), and record the labels
  lr-retro audit <retro-id> [--root <dir>]   Audit the setup with /doctor prompt-audit (a separate,
                                             read-only Claude Code; several minutes), in a file of
                                             the retro, for its analysis

  lr-retro sessions [--root <dir>] [--since <date> | --all]
                                             How many Claude Code sessions the project had in the
                                             period of the next retro (as lr retro scope), how many
                                             need a report, and what writing them would take
  lr-retro reports <retro-id> [--root <dir>]
                                             Write a report on each Claude Code session of the
                                             project and of the retro's period (one separate Claude
                                             Code each, with Opus, several at once), or reuse the
                                             one already written, for its analysis
  lr-retro insights <retro-id> [--root <dir>]
                                             Run Claude Code's /insights (a separate Claude Code,
                                             about a minute), then keep what it knows of the
                                             sessions of the project and of the retro's period, for
                                             its analysis

  lr-retro usage <retro-id> [--root <dir>]   Count how much each skill, command and sub-agent of the
                                             setup was used, from Claude Code's sessions (the
                                             project's tools on its sessions, the user's on every
                                             project), without a model, for the analysis of the audit

  lr-retro conversation <retro-id> <thread-id> [--root <dir>]
                                             Read back Claude Code's conversation where the agent
                                             replied in that thread (the steps that led to each
                                             reply), while Claude Code keeps it (30 days by
                                             default); the retro records it was read back`;
var localDay = (iso) => {
  const d = new Date(iso);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
};
var MODE_LINE = {
  reports: "The retro reads them through these reports (setting retro-sessions: reports; Claude Code's /insights is cheaper: lr config set retro-sessions insights).",
  insights: "The retro reads them through Claude Code's /insights (setting retro-sessions: insights; a report on each session is finer: lr config set retro-sessions reports)."
};
var SOURCE_OF_ACTION = {
  jev: "reviews",
  audit: "audit",
  usage: "audit",
  reports: "sessions",
  insights: "sessions"
};
var SOURCE_WORDS = {
  reviews: "the review threads",
  sessions: "the Claude Code sessions",
  audit: "the audit of the setup"
};
function oversizedLine(o) {
  const tokens = o.tokens >= 1e6 ? `${(o.tokens / 1e6).toFixed(1)}M` : `${Math.round(o.tokens / 1e3)}k`;
  const span = localDay(o.start) === localDay(o.end) ? localDay(o.start) : `${localDay(o.start)} to ${localDay(o.end)}`;
  return `- ${o.id.slice(0, 8)}, ${span}: ${o.prompts} prompts, processing time about ${minutes(o.estimateMs)}, ${tokens} tokens, ${formatBytes(o.bytes)}, ${o.compactions} compaction${o.compactions === 1 ? "" : "s"} \u2192 ` + (o.report ? "read through its earlier report (written while it was shorter)" : "left out");
}
var minutes = (ms) => `${Math.max(1, Math.round(ms / 6e4))} min`;
var RULES_CAP = 8e3;
async function runRetroCli(args, io) {
  try {
    const { values, positionals } = (0, import_node_util.parseArgs)({
      args,
      options: { root: { type: "string" }, since: { type: "string" }, all: { type: "boolean" } },
      allowPositionals: true
    });
    const [action, id, threadId] = positionals;
    const actions = ["setup", "jev", "audit", "conversation", "insights", "sessions", "reports", "usage"];
    if (action === void 0 || !actions.includes(action)) {
      io.out(RETRO_CLI_USAGE);
      return action === void 0 || action === "help" ? 0 : 1;
    }
    const root = values.root ?? io.cwd;
    const home = io.env.HOME?.trim() || (0, import_node_os4.homedir)();
    const claudeDir = io.env.CLAUDE_CONFIG_DIR?.trim() || (0, import_node_path22.join)(home, ".claude");
    if (action === "sessions") {
      if (values.since !== void 0 && values.all) throw new Error("give --since or --all, not both");
      const since = values.since === void 0 ? void 0 : parseDateArg(values.since);
      if (since === null) throw new Error(`--since takes a date (2026-10-01) or a number of days ago (7d)`);
      const scope = await retroScope(root, { ...since ? { since } : {}, all: values.all === true, env: io.env });
      const book2 = new RetroBook(await retroHome(scope.root, io.env));
      const own = await (io.session ?? currentSession)(io.env);
      const period = async (from) => {
        const transcripts = await projectTranscripts(
          claudeDir,
          scope.root,
          { since: from, until: scope.until },
          io.env
        );
        const plan = await planReports(book2, transcripts, own ? { exclude: /* @__PURE__ */ new Set([own]) } : {});
        const writing2 = plan.candidates.filter((c) => c.action === "write");
        const est = await estimateReports(
          book2,
          writing2.map((c) => c.analytics.counts.typed_prompts)
        );
        const oversized2 = plan.oversized ?? [];
        return {
          sessions: transcripts.length,
          plan,
          toWrite: writing2.length,
          kept: plan.candidates.length - writing2.length,
          est,
          oversized: oversized2,
          leftOut: oversized2.filter((o) => !o.report).length
        };
      };
      const tooLong = /* @__PURE__ */ new Map();
      const mode = (await readConfig(io.env)).retroSessions;
      if (mode === "insights") {
        const count = async (from) => (await projectTranscripts(claudeDir, scope.root, { since: from, until: scope.until }, io.env)).filter(
          (t) => t.id !== own
        ).length;
        const n2 = await count(scope.since);
        const lines = [
          `${n2} Claude Code session${n2 === 1 ? "" : "s"} in this project ` + (scope.since ? `since ${localDay(scope.since)}` : "over the whole history") + (own ? " (this session left out)" : "") + ".",
          `${MODE_LINE.insights} No report is written.`
        ];
        if (scope.options.length > 0) {
          lines.push("", "Periods to choose from (as lr retro scope lists them):");
          for (const o of scope.options) {
            const x = o.since === scope.since ? n2 : await count(o.since);
            lines.push(
              `- ${o.label} (${o.flag || "the default"}${o.proposed ? ", proposed" : ""}): ${x} session${x === 1 ? "" : "s"}, read by /insights (about a minute)`
            );
          }
        }
        io.out(lines.join("\n"));
        return 0;
      }
      const p = await period(scope.since);
      io.out(
        [
          `${p.sessions} Claude Code session${p.sessions === 1 ? "" : "s"} in this project ` + (scope.since ? `since ${localDay(scope.since)}` : "over the whole history") + ".",
          `Reports on them: ${p.toWrite} to write` + (p.toWrite ? ` (about ${minutes(p.est.ms)} with ${REPORT_CONCURRENCY} at once, and about $${p.est.costUsd.toFixed(2)} at the API list price: on a subscription, tokens counted against the usage limits, not a bill)` : "") + `, ${p.kept} already written` + (p.plan.noPrompt ? `, ${p.plan.noPrompt} without any prompt typed by the user (not analysed)` : "") + (p.plan.current ? ", and this session (not analysed)" : "") + ".",
          ...p.leftOut ? [
            `\u26A0\uFE0F ${p.leftOut} session${p.leftOut === 1 ? "" : "s"} too long to analyse (a report would take more than ${minutes(REPORT_TIMEOUT_MS)}): left out of the retro.`
          ] : [],
          MODE_LINE.reports
        ].join("\n")
      );
      for (const o of p.oversized) tooLong.set(o.id, o);
      if (scope.options.length > 0) {
        const lines = ["", "Periods to choose from (as lr retro scope lists them):"];
        for (const o of scope.options) {
          const x = o.since === scope.since ? p : await period(o.since);
          for (const s of x.oversized) tooLong.set(s.id, s);
          lines.push(
            `- ${o.label} (${o.flag || "the default"}${o.proposed ? ", proposed" : ""}): ${x.sessions} session${x.sessions === 1 ? "" : "s"}, ${x.toWrite} report${x.toWrite === 1 ? "" : "s"} to write` + (x.toWrite ? ` (about ${minutes(x.est.ms)}, about $${x.est.costUsd.toFixed(2)})` : "") + `, ${x.kept} already written` + (x.leftOut ? `, \u26A0\uFE0F ${x.leftOut} left out (too long to analyse)` : "")
          );
        }
        io.out(lines.join("\n"));
      }
      if (tooLong.size > 0)
        io.out(
          [
            "",
            `\u26A0\uFE0F Sessions too long to analyse (a report would take more than ${minutes(REPORT_TIMEOUT_MS)}, and be cut before its end):`,
            ...[...tooLong.values()].sort((a, b) => a.start.localeCompare(b.start)).map(oversizedLine)
          ].join("\n")
        );
      return 0;
    }
    if (!id) throw new Error("missing <retro-id>");
    const book = new RetroBook(await retroHome(root, io.env));
    const retro = await book.get(id);
    const repos = retro.stores.map((s) => s.root);
    const source = SOURCE_OF_ACTION[action];
    if (source && !retro.sources.includes(source)) {
      if (action === "jev") throw new Error(`retro ${retro.id} does not read the review threads: nothing to classify`);
      io.out(
        `Skipped: retro ${retro.id} does not read ${SOURCE_WORDS[source]} (its sources: ${retro.sources.join(", ")}).`
      );
      return 0;
    }
    if (action === "conversation") {
      if (!threadId) throw new Error("missing <thread-id>");
      const { threads: threads2 } = await retroThreads(retro, io.env);
      const found2 = threads2.get(threadId);
      if (!found2) throw new Error(`thread ${threadId} is not one of the threads of retro ${retro.id}`);
      const result2 = await threadConversations(found2.thread, claudeDir);
      if (result2.linked > 0)
        await book.record(retro.id, [
          { type: "retro.conversation", thread: threadId, sessions: result2.sessions, available: result2.available }
        ]).catch(() => void 0);
      io.out(result2.text);
      return 0;
    }
    if (action === "usage") {
      const own = await (io.session ?? currentSession)(io.env);
      const tools = await setupTools(retro.root, repos, home, claudeDir);
      const usage = await setupUsage(tools, claudeDir, retro.root, io.env, new Set(own ? [own] : []));
      await book.record(retro.id, [{ type: "retro.usage", ...usage }]);
      const never = usage.tools.filter((t) => t.byUser + t.byAgent === 0);
      io.out(
        [
          `Usage of the ${usage.tools.length} skills, commands and sub-agents of the setup, from Claude Code's sessions ` + usage.windows.map(
            (w) => `(${w.scope === "project" ? "the project's" : "every project's, for the user's tools"}: ${w.sessions} session${w.sessions === 1 ? "" : "s"})`
          ).join(" ") + `: ${never.length} never used. lr retro input --for audit includes it.`
        ].join("\n")
      );
      return 0;
    }
    if (action === "setup") {
      const files = await collectSetup(retro.root, repos, home, claudeDir);
      const file = await writeRetroFile(book, retro.id, "setup.md", renderSetup(retro.root, home, files));
      const header2 = files.filter((f) => f.shown === "header").length;
      io.out(
        `Written: ${file}
${files.length} setup files (${files.filter((f) => f.kind === "rules").length} rules files)` + (header2 ? `, ${header2} shown by their header only (over the size budget: read them if needed)` : "") + "."
      );
      return 0;
    }
    if (action === "reports" || action === "insights") {
      const wanted = action;
      if (retro.sessionsMode !== null && retro.sessionsMode !== wanted) {
        io.out(
          `Skipped: this retro reads the sessions ${retro.sessionsMode === "reports" ? "through a report on each one" : "through Claude Code's /insights"} (setting retro-sessions when it started), never both.`
        );
        return 0;
      }
    }
    if (action === "reports") {
      const transcripts = await projectTranscripts(claudeDir, retro.root, retro, io.env);
      const own = await (io.session ?? currentSession)(io.env);
      const plan = await planReports(book, transcripts, {
        retroId: retro.id,
        ...own ? { exclude: /* @__PURE__ */ new Set([own]) } : {}
      });
      const done = await writeReports(book, plan, io.env, io.run);
      const count = (status) => done.refs.filter((r) => r.status === status).length;
      const written = count("analysed");
      const kept = count("reused");
      const refs = await Promise.all(
        done.refs.map(
          async (ref) => ref.status === "reused" && !ref.reason && ((await readSessionReport(book, ref.id))?.generatedAt ?? "") >= retro.startedAt ? { ...ref, status: "analysed" } : ref
        )
      );
      await book.record(retro.id, [
        {
          type: "retro.reports",
          source: REPORTS_SOURCE,
          sessions: refs,
          durationMs: done.durationMs,
          ...done.costUsd !== null ? { costUsd: done.costUsd } : {},
          ...done.tokens !== null ? { tokens: done.tokens } : {}
        }
      ]);
      const failed = done.refs.filter((r) => r.status === "failed");
      const leftOut = done.refs.filter((r) => r.status === "excluded");
      io.out(
        [
          `Reports on the ${done.refs.length} Claude Code session${done.refs.length === 1 ? "" : "s"} of this project in the period: ${written} written, ${kept} kept from before` + (failed.length ? `, ${failed.length} could not be written` : "") + (leftOut.length ? `, ${leftOut.length} left out (too long to analyse)` : "") + (written ? `, in ${minutes(done.durationMs)}` : "") + (done.costUsd !== null ? ` (about $${done.costUsd.toFixed(2)} at the API list price)` : "") + ". lr retro input --for analysis includes them.",
          ...failed.map((r) => `- ${r.id}: ${r.reason ?? "failed"}`)
        ].join("\n")
      );
      return written + kept > 0 || done.refs.length === leftOut.length ? 0 : 1;
    }
    if (action === "insights") {
      const ran = await runInsights(retro.root, io.env, io.run);
      const own = await (io.session ?? currentSession)(io.env);
      const { sessions, files, read } = await projectSessions(
        (0, import_node_path22.join)(claudeDir, "usage-data"),
        retro.root,
        retro,
        io.env,
        io.run,
        /* @__PURE__ */ new Set([...own ? [own] : [], ...await programSessions(claudeDir)])
      );
      if (files > 0 && read === 0) {
        io.err(
          `lr-retro: /insights has ${files} session file(s), but none could be read: its format changed. The retro goes on without the sessions; tell the user to report it as a bug of Local Review.`
        );
        return 1;
      }
      if (files === 0 && ran.kind === "failed") {
        io.err(`lr-retro: /insights failed (${ran.reason}): the retro goes on without the sessions.`);
        return 1;
      }
      const file = await recordRetroSessions(
        book,
        retro.id,
        INSIGHTS_SOURCE,
        sessions,
        ran.kind === "done" ? ran : { costUsd: null, durationMs: null }
      );
      const withSummary = sessions.filter((s) => s.summary).length;
      io.out(
        [
          `Written: ${file}`,
          `${sessions.length} Claude Code session${sessions.length === 1 ? "" : "s"} of this project in the period, ${withSummary} with a summary by /insights: lr retro input --for analysis includes them.`,
          ...ran.kind === "failed" ? [`(/insights did not run: ${ran.reason}; its last results were used.)`] : []
        ].join("\n")
      );
      return 0;
    }
    if (action === "audit") {
      const outcome = await runAudit(retro.root, claudeDir, io.env, io.run);
      if (outcome.kind === "skipped") {
        io.out(`Audit skipped: ${outcome.reason}.`);
        return 0;
      }
      if (outcome.kind === "failed") {
        io.err(`lr-retro: the audit failed: ${outcome.reason}.`);
        return 1;
      }
      const file = await writeRetroFile(
        book,
        retro.id,
        AUDIT_FILE,
        [
          `# Audit of the setup \u2014 ${AUDIT_COMMAND}`,
          "",
          `Run for the retro ${retro.id} in ${retro.root}, read-only (no shell, no edit), with access to ${claudeDir}.`,
          "",
          outcome.report,
          ""
        ].join("\n")
      );
      const minutes2 = outcome.durationMs === null ? "" : ` in ${Math.max(1, Math.round(outcome.durationMs / 6e4))} min`;
      const cost = outcome.costUsd === null ? "" : ` (about $${outcome.costUsd.toFixed(2)})`;
      io.out(`Written: ${file}
The audit of the setup is done${minutes2}${cost}.`);
      return 0;
    }
    const key = await readJevKey(io.env);
    const { threads } = await retroThreads(retro, io.env);
    const rules = (await collectSetup(retro.root, repos, home, claudeDir)).filter((f) => f.kind === "rules").map((f) => `## ${f.path}
${f.content}`).join("\n\n").slice(0, RULES_CAP);
    const result = await classifyWithJev(
      [...threads.values()].map(({ thread, store }) => ({ id: thread.id, text: threadText(thread, store) })),
      rules,
      { fetch: io.fetch ?? fetch, key, url: io.env.LR_JEV_URL?.trim() || void 0 }
    );
    const n = Object.keys(result.labels).length;
    if (n > 0) await book.record(retro.id, [{ type: "retro.classified", by: "jev", labels: result.labels }]);
    io.out(
      `Classified ${n}/${threads.size} threads with Jev` + (result.costUsd ? ` (about $${result.costUsd.toFixed(2)})` : "") + "." + (result.failed.length ? `
${result.failed.length} failed: ${result.failed.map((f) => `${f.thread} (${f.error})`).join(", ")}` : "")
    );
    return n > 0 ? 0 : 1;
  } catch (err) {
    io.err(`lr-retro: ${err instanceof Error ? err.message : String(err)}`);
    return 1;
  }
}

// src/retroMain.ts
runRetroCli(process.argv.slice(2), {
  cwd: process.cwd(),
  env: process.env,
  out: (text) => process.stdout.write(text + "\n"),
  err: (text) => process.stderr.write(text + "\n")
}).then(
  (code) => {
    process.exitCode = code;
  },
  (err) => {
    process.stderr.write(`lr-retro: ${String(err)}
`);
    process.exitCode = 1;
  }
);
