    (e) => e.kind === "comment" && e.author === "agent" && e.session ? [{ session: e.session.id, ...e.session.message ? { message: e.session.message } : {}, at: e.at }] : []
  );
}
var SAFE_ID = /^[A-Za-z0-9_-]{1,128}$/;
async function transcriptsOf(claudeDir, session) {
  if (!SAFE_ID.test(session)) return [];
  const projects = (0, import_node_path10.join)(claudeDir, "projects");
  let folders;
  try {
    folders = await (0, import_promises9.readdir)(projects);
  } catch {
    return [];
  }
  const found2 = [];
  for (const folder of folders.sort()) {
    const main = (0, import_node_path10.join)(projects, folder, `${session}.jsonl`);
    if (await readable(main)) found2.push(main);
    try {
      const sub = (0, import_node_path10.join)(projects, folder, session, "subagents");
      for (const f of (await (0, import_promises9.readdir)(sub)).sort()) if (f.endsWith(".jsonl")) found2.push((0, import_node_path10.join)(sub, f));
    } catch {
    }
  }
