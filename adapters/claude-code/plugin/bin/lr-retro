function textOf2(content) {
  if (typeof content === "string") return content;
  if (Array.isArray(content))
    return content.filter((b) => isRecord3(b) && b.type === "text").map((b) => strOf(b.text)).join("\n");
  return "";
}
function toolSummary(name, input) {
  const inp = isRecord3(input) ? input : {};
  if (name === "Bash") return cut(inp.command, 300);
  for (const key of ["file_path", "notebook_path", "path", "pattern", "url", "query", "skill", "subagent_type"])
    if (key in inp) return cut(String(inp[key]), 200);
  if (name === "Agent") return cut(inp.description, 200);
  return "";
}
var SETUP_STEP = /^(cd\s+\S+|source\s+\S+(\s*[>&\d/a-z]*\/dev\/null)?|\.\s+\S+|export\s+\S+|nvm\s+use\b[^&;|]*|[A-Z_][A-Z0-9_]*=\S*)\s*(&&|;)\s*/;
function normCommand(cmd) {
  let c = (typeof cmd === "string" ? cmd : "").replace(/\s+/g, " ").trim();
  for (let m = SETUP_STEP.exec(c); m; m = SETUP_STEP.exec(c)) c = c.slice(m[0].length);
  return c.split(" ").slice(0, 3).join(" ");
}
async function readJsonl(file) {
  const text = await (0, import_promises15.readFile)(file, "utf8");
  const out = [];
  text.split("\n").forEach((line, i) => {
    if (!line.trim()) return;
    try {
      const e = JSON.parse(line);
      if (isRecord3(e)) out.push({ n: i + 1, e });
    } catch {
    }
  });
  return out;
}
async function walk2(dir) {
  const entries = await (0, import_promises15.readdir)(dir, { withFileTypes: true }).catch(() => []);
  const out = [];
  for (const d of entries) {
    const p = (0, import_node_path16.join)(dir, d.name);
    if (d.isDirectory()) out.push(...await walk2(p));
    else out.push(p);
  }
  return out;
}
async function subagentFiles(sessionFile) {
  const dir = (0, import_node_path16.join)((0, import_node_path16.dirname)(sessionFile), (0, import_node_path16.basename)(sessionFile, ".jsonl"), "subagents");
  const files = (await walk2(dir)).filter((f) => /\/agent-[^/]+\.jsonl$/.test(f)).sort();
  const out = [];
  for (const file of files) {
    let meta = {};
    try {
      const raw = JSON.parse(await (0, import_promises15.readFile)(file.replace(/\.jsonl$/, ".meta.json"), "utf8"));
      if (isRecord3(raw)) meta = raw;
    } catch {
    }
    if (file.includes("/workflows/")) meta = { ...meta, workflow: true };
    out.push({ id: (0, import_node_path16.basename)(file, ".jsonl").slice("agent-".length), file, meta });
  }
  return out;
}
var bump = (m, k, by = 1) => m.set(k, (m.get(k) ?? 0) + by);
