async function analyseSession(sessionFile) {
  const sid = (0, import_node_path16.basename)(sessionFile, ".jsonl");
  const agents = [{ id: "main", file: sessionFile, meta: {}, lines: await readJsonl(sessionFile) }];
  for (const s of await subagentFiles(sessionFile)) agents.push({ ...s, lines: await readJsonl(s.file) });
