  };
  const repos = [];
  const below = [];
  await walk(top, env, below, repos);
  for (const dir of below) await add(dir, dir === top ? "root" : "below");
  if (!below.includes(top)) {
    const above = findStoreRoot(top, env);
    if (above) {
      await add(above, "above");
      repos.push(above);
    }
  }
