function parseLines(text, source, types) {
  const events = [];
  const warnings = [];
  let future = false;
  const end = text.lastIndexOf("\n");
  const lines = end === -1 ? [] : text.slice(0, end).split("\n");
  lines.forEach((line, i) => {
    if (line.trim() === "") return;
    let raw;
    try {
      raw = JSON.parse(line);
    } catch {
      warnings.push(`${source}:${i + 1}: invalid JSON, line skipped`);
      return;
    }
    const e = raw;
    if (typeof raw !== "object" || raw === null || typeof e.v !== "number" || typeof e.type !== "string") {
      warnings.push(`${source}:${i + 1}: not an event, line skipped`);
      return;
    }
    if (e.v > RETRO_SCHEMA_VERSION) {
      future = true;
      return;
    }
    if (!types.has(e.type)) {
      warnings.push(`${source}:${i + 1}: unknown event type "${e.type}", line skipped`);
      return;
    }
    events.push(raw);
  });
  return { events, warnings, future };
}
function foldRetro(events, warnings = [], future = false) {
  const first = events[0];
  if (!first || first.type !== "retro.started") return null;
  const r = {
    id: first.retroId,
    root: first.root,
    since: first.since,
    until: first.until,
    startedAt: first.at,
    stores: first.stores,
    threads: first.threads,
    bytes: first.bytes,
    preferences: first.preferences ?? [],
    feedback: [],
    classification: null,
    proposals: [],
    watch: [],
    dropped: [],
    verifications: [],
    decisions: {},
    applied: {},
    conversations: {},
    finishedAt: null,
    readOnly: future,
    warnings
  };
  for (const e of events.slice(1)) {
    switch (e.type) {
      case "retro.feedback":
        r.feedback.push(e.body);
        break;
      case "retro.classified": {
        const c = r.classification ??= { by: [], labels: {} };
        if (!c.by.includes(e.by)) c.by.push(e.by);
        Object.assign(c.labels, e.labels);
        break;
      }
      case "retro.proposed":
        r.proposals = e.proposals;
        r.watch = e.watch;
        r.dropped = e.dropped;
        r.verifications = e.verifications ?? [];
        r.decisions = {};
        r.applied = {};
        break;
      case "retro.decided":
        r.decisions[e.proposal] = {
          decision: e.decision,
          at: e.at,
          ...e.target ? { target: e.target } : {},
          ...e.note ? { note: e.note } : {}
        };
        break;
      case "retro.applied":
        r.applied[e.proposal] = [.../* @__PURE__ */ new Set([...r.applied[e.proposal] ?? [], ...e.files])];
        break;
      case "retro.undone":
        delete r.decisions[e.proposal];
        delete r.applied[e.proposal];
        break;
      case "retro.conversation":
        if (!r.conversations[e.thread]?.available)
          r.conversations[e.thread] = { sessions: e.sessions, available: e.available, at: e.at };
        break;
      case "retro.finished":
        r.finishedAt ??= e.at;
        break;
      case "retro.started":
        break;
    }
  }
  return r;
}
function foldPreferences(events) {
  const prefs = /* @__PURE__ */ new Map();
  for (const e of events) {
    if (e.type === "preference.added") prefs.set(e.id, { id: e.id, body: e.body, at: e.at });
    else prefs.delete(e.id);
  }
  return [...prefs.values()];
}
async function retroHome(root, env = process.env) {
  if (root === LOOSE_ROOT) throw new Error("a retro is about a project folder, not the files outside any folder");
  const dir = (0, import_node_path7.resolve)(root);
  if (isStoreRoot(dir, env)) return dir;
  return await worktreeTopOf(dir) ?? dir;
}
async function readRetros(dir) {
  let files;
  try {
    files = (await (0, import_promises5.readdir)(dir)).filter((f) => f.endsWith(".jsonl") && RETRO_ID.test(f.slice(0, -".jsonl".length)));
  } catch (err) {
    if (err.code === "ENOENT") return [];
    throw err;
  }
  const retros = await Promise.all(files.map((f) => readRetro(dir, f.slice(0, -".jsonl".length))));
  return retros.filter((r) => r !== null).sort((a, b) => a.startedAt.localeCompare(b.startedAt) || a.id.localeCompare(b.id));
}
async function readRetro(dir, id) {
  if (!RETRO_ID.test(id)) throw new Error(`Invalid retro id: ${id}`);
  let text;
  try {
    text = await (0, import_promises5.readFile)((0, import_node_path7.join)(dir, `${id}.jsonl`), "utf8");
  } catch (err) {
    if (err.code === "ENOENT") return null;
    throw err;
  }
  const parsed = parseLines(text, `retros/${id}.jsonl`, RETRO_EVENTS);
  return foldRetro(parsed.events, parsed.warnings, parsed.future);
}
var RetroBook = class {
  constructor(home) {
    this.home = home;
    this.dir = (0, import_node_path7.join)(home, STORE_DIR, RETROS_DIR);
  }
  home;
  dir;
  retroFile(id) {
    if (!RETRO_ID.test(id)) throw new Error(`Invalid retro id: ${id}`);
    return (0, import_node_path7.join)(this.dir, `${id}.jsonl`);
  }
  /** A folder for the files a retro writes for its agents. */
  async workDir(id) {
    if (!RETRO_ID.test(id)) throw new Error(`Invalid retro id: ${id}`);
    const dir = (0, import_node_path7.join)(this.dir, id);
    await (0, import_promises5.mkdir)(dir, { recursive: true });
    return dir;
  }
  get preferencesFile() {
    return (0, import_node_path7.join)(this.dir, "preferences.jsonl");
  }
  /** Every retro of this book, oldest first. */
  list() {
    return readRetros(this.dir);
  }
  read(id) {
    return readRetro(this.dir, id);
  }
  /** The retro, which must exist and accept writes. */
  async get(id) {
    const r = await this.read(id);
    if (!r) throw new Error(`Retro not found: ${id}`);
    return r;
  }
  /** The last finished retro of the project folder `root`, if any. */
  async lastFinished(root) {
    const done = (await this.list()).filter((r) => r.finishedAt !== null && r.root === (0, import_node_path7.resolve)(root));
    return done.at(-1) ?? null;
  }
  async preferences() {
    let text;
    try {
      text = await (0, import_promises5.readFile)(this.preferencesFile, "utf8");
    } catch (err) {
      if (err.code === "ENOENT") return [];
      throw err;
    }
    return foldPreferences(parseLines(text, "retros/preferences.jsonl", PREFERENCE_EVENTS).events);
  }
  async addPreference(body) {
    const text = body.trim();
    if (text === "") throw new Error("A preference cannot be empty");
    const ids = (await this.allPreferenceIds()).map((id2) => Number(id2.slice(1)));
    const id = `P${Math.max(0, ...ids) + 1}`;
    const at = (/* @__PURE__ */ new Date()).toISOString();
    await this.append(this.preferencesFile, [
      { v: RETRO_SCHEMA_VERSION, type: "preference.added", at, id, body: text }
    ]);
    return { id, body: text, at };
  }
  async removePreference(id) {
    if (!(await this.preferences()).some((p) => p.id === id)) throw new Error(`Preference not found: ${id}`);
    await this.append(this.preferencesFile, [
      { v: RETRO_SCHEMA_VERSION, type: "preference.removed", at: (/* @__PURE__ */ new Date()).toISOString(), id }
    ]);
  }
  /** Every preference id ever given, removed ones included: an id is never reused. */
  async allPreferenceIds() {
    try {
      const text = await (0, import_promises5.readFile)(this.preferencesFile, "utf8");
      return parseLines(text, "preferences", PREFERENCE_EVENTS).events.map((e) => e.id);
    } catch {
      return [];
    }
  }
  /** Starts a retro: its period and the threads it reads. */
  async start(scope) {
    const retroId = newRetroId();
    const preferences = await this.preferences();
    await this.append(this.retroFile(retroId), [
      {
        v: RETRO_SCHEMA_VERSION,
        type: "retro.started",
        at: (/* @__PURE__ */ new Date()).toISOString(),
        retroId,
        ...scope,
        root: (0, import_node_path7.resolve)(scope.root),
        preferences
      }
    ]);
    return this.get(retroId);
  }
  /** Appends events to a retro still in progress. */
  async record(id, events) {
    const r = await this.get(id);
    if (r.readOnly) throw new Error(`Retro ${id} was written by a newer version of Local Review: update Local Review`);
    if (r.finishedAt) throw new Error(`Retro ${id} is finished`);
    const at = (/* @__PURE__ */ new Date()).toISOString();
    await this.append(
      this.retroFile(id),
      events.map((e) => ({ v: RETRO_SCHEMA_VERSION, at, ...e }))
    );
    return this.get(id);
  }
  async append(file, events) {
    await (0, import_promises5.mkdir)(this.dir, { recursive: true });
    await (0, import_promises5.appendFile)(file, events.map((e) => JSON.stringify(e) + "\n").join(""), { flag: "a" });
  }
};

