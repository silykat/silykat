  const branches = /* @__PURE__ */ new Map();
  const versions = /* @__PURE__ */ new Set();
  const entrypoints = /* @__PURE__ */ new Set();
  const models = /* @__PURE__ */ new Map();
  const titles = [];
  const customTitles = [];
  const times = [];
  const permissionModes = /* @__PURE__ */ new Map();
  const usage = /* @__PURE__ */ new Map();
  const prompts = [];
  const skillsAvailable = /* @__PURE__ */ new Set();
  const skillsActive = /* @__PURE__ */ new Map();
  const instructions = {};
  const toolCalls = /* @__PURE__ */ new Map();
  const commands = /* @__PURE__ */ new Map();
  const errorsByCommand = /* @__PURE__ */ new Map();
  let away = 0;
  const turnMs = [];
  let costState = null;
  for (const agent of agents) {
    const at = (n, e, extra = {}) => ({
      agent: agent.id,
      uuid: orNull(e.uuid),
      time: orNull(e.timestamp),
      line: n,
      ...extra
    });
    const toolNames = /* @__PURE__ */ new Map();
    const seenMessages = /* @__PURE__ */ new Set();
    let actionsSincePrompt = [];
    let bashSincePrompt = [];
    let lastPrompt = null;
    let firstUser = true;
    for (const { n, e } of agent.lines) {
      const t = e.type;
      if (typeof e.timestamp === "string") times.push(e.timestamp);
      if (agent.id === "main") {
        if (typeof e.cwd === "string") bump(cwd, e.cwd);
        if (typeof e.gitBranch === "string" && e.gitBranch) bump(branches, e.gitBranch);
        if (typeof e.version === "string") versions.add(e.version);
