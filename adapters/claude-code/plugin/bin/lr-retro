// ../../packages/core/src/retroKey.ts
var import_promises6 = require("node:fs/promises");
var import_node_os2 = require("node:os");
var import_node_path8 = require("node:path");
function jevKeyFile(env = process.env) {
  return (0, import_node_path8.join)(env.HOME?.trim() || (0, import_node_os2.homedir)(), ".config", "local-review", "jev-key");
}
async function jevKeyStatus(env = process.env) {
  const path = jevKeyFile(env);
  const fromEnv = (env.JEV_API_KEY ?? "").trim() !== "";
  const st = await (0, import_promises6.stat)(path).catch(() => null);
  const exists2 = st?.isFile() === true;
  const status = {
    source: fromEnv ? "env" : exists2 ? "file" : "none",
    path,
    exists: exists2,
    mode: null,
    private: false,
    inRepo: null,
    ok: fromEnv,
    fixes: []
  };
  if (!exists2 || !st) return status;
  status.mode = (st.mode & 511).toString(8);
  const mine = typeof process.getuid !== "function" || st.uid === process.getuid();
  status.private = (st.mode & 63) === 0 && mine;
  status.inRepo = await worktreeTopOf((0, import_node_path8.dirname)(path));
  if (!status.private) status.fixes.push(`chmod 600 "${path}"`);
  if (status.inRepo)
    status.fixes.push(`move it out of the repository ${status.inRepo} (e.g. to the default place, ${jevKeyFile(env)})`);
  if (!fromEnv) status.ok = status.private && status.inRepo === null;
  return status;
}

// ../../packages/core/src/retroScope.ts
var import_promises7 = require("node:fs/promises");
var import_node_path9 = require("node:path");
var who = (by, agent) => by === "user" ? "User" : agent ?? "Agent";
function entryText(e) {
  switch (e.kind) {
    case "comment": {
      const notes = [e.publishedAt ?? e.at];
      if (e.editedAt) notes.push(`edited ${e.editedAt}`);
      if (e.deletedAt) notes.push(`deleted ${e.deletedAt}`);
      return `[${who(e.author, e.agent)}] (${notes.join(", ")}) ${e.body}`;
    }
    case "status":
      return `(status -> ${e.status} by ${who(e.by, e.agent)}, ${e.at})`;
    case "deleted":
      return `(thread deleted, ${deletionLabel(e.reason)}, ${e.at})`;
  }
}
function threadText(t, store) {
  const a = t.anchor;
  const where = a.range ? `${a.path}:${a.range.startLine}-${a.range.endLine}` : `${a.path} (whole file)`;
  const lines = [
    `THREAD ${t.id} \xB7 ${where} \xB7 ${t.state}` + (store ? ` \xB7 store ${store}` : "") + (t.branch ? ` \xB7 branch ${t.branch.branch}` : "")
  ];
  if (a.range && a.snippet) lines.push("code:", ...a.snippet.split("\n").map((l) => `  ${l}`));
  for (const e of t.conversation) lines.push(entryText(e));
  return lines.join("\n");
}
async function retroThreads(retro, env = process.env) {
  const history = await projectHistory(retro.root, { since: retro.since ? new Date(retro.since) : null, env });
  const wanted = new Set(retro.threads);
  const threads = /* @__PURE__ */ new Map();
  for (const s of history.stores)
    for (const t of s.threads)
      if (wanted.has(t.id))
        threads.set(t.id, {
          thread: t,
          store: s.saved ? `${s.root} (saved before its git worktree was removed)` : s.root
        });
  return { history, threads };
}
