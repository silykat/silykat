function jevKeyFile(env = process.env) {
  return (0, import_node_path7.join)(env.HOME?.trim() || (0, import_node_os2.homedir)(), ".config", "local-review", "jev-key");
}
async function jevKeyStatus(env = process.env) {
  const path = jevKeyFile(env);
  const fromEnv = (env.JEV_API_KEY ?? "").trim() !== "";
  const st = await (0, import_promises6.stat)(path).catch(() => null);
  const exists = st?.isFile() === true;
  const status2 = {
    source: fromEnv ? "env" : exists ? "file" : "none",
    path,
    exists,
    mode: null,
    private: false,
    inRepo: null,
    ok: fromEnv,
    fixes: []
  };
  if (!exists || !st) return status2;
  status2.mode = (st.mode & 511).toString(8);
  const mine = typeof process.getuid !== "function" || st.uid === process.getuid();
  status2.private = (st.mode & 63) === 0 && mine;
  status2.inRepo = await worktreeTopOf((0, import_node_path7.dirname)(path));
  if (!status2.private) status2.fixes.push(`chmod 600 "${path}"`);
  if (status2.inRepo)
    status2.fixes.push(`move it out of the repository ${status2.inRepo} (e.g. to the default place, ${jevKeyFile(env)})`);
  if (!fromEnv) status2.ok = status2.private && status2.inRepo === null;
  return status2;
}
function jevKeySetupCommand(path = "$HOME/.config/local-review/jev-key") {
  const dir = path.replace(/\/[^/]+$/, "");
  return `sh -c 'umask 077 && mkdir -p "${dir}" && trap "stty echo; echo; exit 130" INT TERM && printf "Jev API key (hidden): " && stty -echo && IFS= read -r k; stty echo; echo; [ -n "$k" ] && : > "${path}" && chmod 600 "${path}" && printf "%s\\n" "$k" > "${path}" && echo "Saved in ${path}"'`;
}

