    const key2 = await (0, import_promises4.realpath)((0, import_node_path5.join)(dir, STORE_DIR)).catch(() => (0, import_node_path5.join)(dir, STORE_DIR));
    if (seen.has(key2)) return;
    seen.add(key2);
