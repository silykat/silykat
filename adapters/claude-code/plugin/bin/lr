function parseLines(text2, source, types) {
  const events = [];
  const warnings = [];
  let future = false;
  const end = text2.lastIndexOf("\n");
  const lines = end === -1 ? [] : text2.slice(0, end).split("\n");
  lines.forEach((line, i) => {
    if (line.trim() === "") return;
    let raw;
    try {
      raw = JSON.parse(line);
    } catch {
      warnings.push(`${source}:${i + 1}: invalid JSON, line skipped`);
      return;
    }
    const e = raw;
    if (typeof raw !== "object" || raw === null || typeof e.v !== "number" || typeof e.type !== "string") {
      warnings.push(`${source}:${i + 1}: not an event, line skipped`);
      return;
    }
    if (e.v > RETRO_SCHEMA_VERSION) {
      future = true;
      return;
    }
    if (!types.has(e.type)) {
      warnings.push(`${source}:${i + 1}: unknown event type "${e.type}", line skipped`);
      return;
    }
    events.push(raw);
  });
  return { events, warnings, future };
}
function foldRetro(events, warnings = [], future = false) {
  const first = events[0];
  if (!first || first.type !== "retro.started") return null;
  const r = {
    id: first.retroId,
    root: first.root,
    since: first.since,
    until: first.until,
    startedAt: first.at,
    stores: first.stores,
    threads: first.threads,
    bytes: first.bytes,
    preferences: first.preferences ?? [],
    feedback: [],
    classification: null,
    proposals: [],
    watch: [],
    dropped: [],
    decisions: {},
    applied: {},
    finishedAt: null,
    readOnly: future,
    warnings
  };
  for (const e of events.slice(1)) {
    switch (e.type) {
      case "retro.feedback":
        r.feedback.push(e.body);
        break;
      case "retro.classified": {
        const c = r.classification ??= { by: [], labels: {} };
        if (!c.by.includes(e.by)) c.by.push(e.by);
        Object.assign(c.labels, e.labels);
        break;
      }
      case "retro.proposed":
        r.proposals = e.proposals;
        r.watch = e.watch;
        r.dropped = e.dropped;
        r.decisions = {};
        r.applied = {};
        break;
      case "retro.decided":
        r.decisions[e.proposal] = {
          decision: e.decision,
          at: e.at,
          ...e.target ? { target: e.target } : {},
          ...e.note ? { note: e.note } : {}
        };
        break;
      case "retro.applied":
        r.applied[e.proposal] = [.../* @__PURE__ */ new Set([...r.applied[e.proposal] ?? [], ...e.files])];
        break;
      case "retro.undone":
        delete r.decisions[e.proposal];
        delete r.applied[e.proposal];
        break;
      case "retro.finished":
        r.finishedAt ??= e.at;
        break;
      case "retro.started":
        break;
    }
  }
  return r;
}
function foldPreferences(events) {
  const prefs2 = /* @__PURE__ */ new Map();
  for (const e of events) {
    if (e.type === "preference.added") prefs2.set(e.id, { id: e.id, body: e.body, at: e.at });
    else prefs2.delete(e.id);
  }
  return [...prefs2.values()];
}
