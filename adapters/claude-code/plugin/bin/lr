      if (record.pid !== null && !this.isAlive(record.pid)) {
        await this.unregister(record.id).catch(() => void 0);
        continue;
      }
      sessions2.push({ ...record, subscriptions: await this.subscriptions(record.id) });
    }
    return sessions2;
  }
