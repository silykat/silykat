// ../core/src/reanchor.ts
function reanchor(anchor, fileText) {
  if (!anchor.range) return null;
  const lines = splitLines(fileText);
  const snippet = splitLines(anchor.snippet);
  const n = snippet.length;
  const toRange = (i) => ({ startLine: i + 1, endLine: i + n });
  const stored = anchor.range.startLine - 1;
  const exactAt = (i) => i >= 0 && i + n <= lines.length && snippet.every((l, k) => lines[i + k] === l);
  if (exactAt(stored)) return { kind: "exact", range: toRange(stored) };
  const moved = closest(anchor, lines, n, stored, exactAt);
  if (moved !== void 0) return { kind: "moved", range: toRange(moved) };
  const normalized = snippet.map(normalize);
  if (normalized.every((l) => l === "")) return { kind: "lost" };
  const looseAt = (i) => i >= 0 && i + n <= lines.length && normalized.every((l, k) => normalize(lines[i + k]) === l);
  const fuzzy = closest(anchor, lines, n, stored, looseAt);
  return fuzzy !== void 0 ? { kind: "fuzzy", range: toRange(fuzzy) } : { kind: "lost" };
}
function normalize(line) {
  return line.replace(/\s+/g, "");
}
function closest(anchor, lines, n, stored, matchesAt) {
  let best;
  for (let i = 0; i + n <= lines.length; i++) {
    if (!matchesAt(i)) continue;
    const candidate = { i, distance: Math.abs(i - stored), context: contextScore(anchor, lines, i, n) };
    if (!best || candidate.distance < best.distance || candidate.distance === best.distance && candidate.context > best.context) {
      best = candidate;
    }
  }
  return best?.i;
}
function contextScore(anchor, lines, start2, n) {
  let score = 0;
  anchor.contextBefore.forEach((l, k) => {
    if (lines[start2 - anchor.contextBefore.length + k] === l) score++;
  });
  anchor.contextAfter.forEach((l, k) => {
    if (lines[start2 + n + k] === l) score++;
  });
  return score;
}

