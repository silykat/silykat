function findStoresBelow(dir, maxDepth = 3, env = process.env) {
  const found = [];
  const walk2 = (current, depth) => {
    if (depth > maxDepth || found.length >= 20) return;
    let entries;
    try {
      entries = (0, import_node_fs.readdirSync)(current, { withFileTypes: true });
    } catch {
      return;
    }
    for (const entry of entries) {
      if (!entry.isDirectory() || SKIPPED.has(entry.name)) continue;
      const child = (0, import_node_path4.join)(current, entry.name);
      if (isStoreRoot(child, env)) found.push(child);
      walk2(child, depth + 1);
    }
  };
  walk2((0, import_node_path4.resolve)(dir), 1);
  return found.sort();
}
