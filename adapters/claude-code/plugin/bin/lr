    for (const line of text2.split("\n")) {
      try {
        const e = JSON.parse(line);
        if (!e.topic || e.topic.kind !== "branch" && e.topic.kind !== "path") continue;
        const key2 = topicKey(e.topic);
        if (e.op === "remove") current.delete(key2);
        else if (e.op === "add" && !current.has(key2))
          current.set(key2, { topic: e.topic, reason: e.reason ?? "user", at: e.at ?? "" });
      } catch {
      }
    }
    return [...current.values()];
  }
