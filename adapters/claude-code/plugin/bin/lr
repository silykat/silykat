}

// ../core/src/agentView.ts
function userRevision(comments) {
  const asked = comments.filter((c) => c.author === "user" && !c.isDraft).map((c) => [c.id, c.body]);
  return (0, import_node_crypto2.createHash)("sha256").update(JSON.stringify(asked)).digest("hex").slice(0, 8);
}
function agentView(thread) {
  if (thread.deleted) return null;
  const comments = thread.comments.filter((c) => !c.isDraft);
  if (comments.length === 0) return null;
  const last = comments[comments.length - 1];
  const open2 = thread.status !== "resolved";
  const lastAgentAt = [...comments].reverse().find((c) => c.author === "agent")?.createdAt;
  const editedSince = lastAgentAt !== void 0 && comments.some((c) => c.author === "user" && c.editedAt !== void 0 && c.editedAt >= lastAgentAt);
  const userTurn = last.author === "user" || editedSince;
  return {
    thread,
    comments,
    needsAgent: open2 && userTurn,
    waitsForUser: open2 && !userTurn,
    rev: userRevision(comments)
  };
}
function isStoreRoot(dir, env = process.env) {
  const store = (0, import_node_path4.join)(dir, STORE_DIR);
  if (!(0, import_node_fs.existsSync)((0, import_node_path4.join)(store, "schema-version")) && !(0, import_node_fs.existsSync)((0, import_node_path4.join)(store, "threads"))) return false;
  return realpath2(store) !== realpath2(localReviewHome(env));
}
function findStoreRoot(fromDir, env = process.env) {
  let dir = (0, import_node_path4.resolve)(fromDir);
  for (; ; ) {
    if (isStoreRoot(dir, env)) return dir;
    const parent = (0, import_node_path4.dirname)(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}
var SKIPPED = /* @__PURE__ */ new Set(["node_modules", ".git", "dist", "out", ".vscode-test", STORE_DIR]);
function findStoresBelow(dir, maxDepth = 3, env = process.env) {
  const found = [];
  const walk2 = (current, depth) => {
    if (depth > maxDepth || found.length >= 20) return;
    let entries;
    try {
      entries = (0, import_node_fs.readdirSync)(current, { withFileTypes: true });
    } catch {
      return;
    }
    for (const entry of entries) {
      if (!entry.isDirectory() || SKIPPED.has(entry.name)) continue;
      const child = (0, import_node_path4.join)(current, entry.name);
      if (isStoreRoot(child, env)) found.push(child);
      walk2(child, depth + 1);
    }
  };
  walk2((0, import_node_path4.resolve)(dir), 1);
  return found.sort();
}
