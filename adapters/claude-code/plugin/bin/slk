var import_promises16 = require("node:fs/promises");
var import_node_path18 = require("node:path");

// ../core/src/retroFindings.ts
var AUDIT_FILE = "audit.md";
var FINDING_SOURCES = ["threads", "sessions", "audit"];
var PREFIX = { threads: "T", sessions: "S", audit: "A" };
function checkFindings(input2, source, ctx) {
  const result = { source, findings: [], rejected: [], notes: [] };
  if (!isRawRecord(input2) || !Array.isArray(input2.findings)) {
    result.rejected.push({ index: 0, subject: "", reasons: ['expected a JSON object with a "findings" array'] });
    return result;
  }
  input2.findings.forEach((raw, i) => {
    const index = i + 1;
    if (!isRawRecord(raw)) {
      result.rejected.push({ index, subject: "", reasons: ["not an object"] });
      return;
    }
    const subject = textOf(raw.subject);
    const reasons = [];
    if (!subject) reasons.push('"subject" is missing');
    const cause = textOf(raw.cause) || (idsOf(raw.causes).length === 1 ? idsOf(raw.causes)[0] : "");
    if (!cause)
      reasons.push(
        idsOf(raw.causes).length > 1 ? "one cause per finding: split it into one finding per cause" : '"cause" is missing: the one cause in the setup it points at'
      );
    const confidence = typeof raw.confidence === "number" ? raw.confidence : NaN;
    if (!(confidence >= 0 && confidence <= 1)) reasons.push('"confidence" must be a number from 0 to 1');
    const column = textOf(raw.column).toLowerCase().replace(/^to\s+/, "") || null;
    if (column !== null && !COLUMNS.includes(column)) reasons.push(`"column" must be one of ${COLUMNS.join(", ")}`);
    const kind = textOf(raw.kind) || null;
    if (kind !== null && !PROPOSAL_KINDS.includes(kind))
      reasons.push(`"kind" must be one of ${PROPOSAL_KINDS.join(", ")}`);
    const target = textOf(raw.target) || null;
    if (target !== null && !TARGETS.includes(target)) reasons.push(`"target" must be one of ${TARGETS.join(", ")}`);
    const evidence = [];
    const sessions2 = [];
    let audit = null;
    if (source === "threads") {
      for (const e of evidenceOf(raw.evidence ?? raw.threads)) {
        if (evidence.some((x) => x.thread === e.thread)) continue;
        if (ctx.threads.has(e.thread)) evidence.push(e);
        else result.notes.push(`${subject}: thread ${e.thread} is not in the period, left out`);
      }
      if (evidence.length === 0)
        reasons.push('"evidence" needs at least one thread of the period, with an excerpt: copy its id exactly');
    } else if (source === "sessions") {
      for (const c of sessionsOf(raw.sessions)) {
        if (sessions2.some((x) => x.session === c.session)) continue;
        const known = ctx.sessions?.get(c.session);
        if (known) sessions2.push(checkSession(c, known, reasons));
        else result.notes.push(`${subject}: session ${c.session} is not one the retro reads, left out`);
      }
      if (sessions2.length === 0)
        reasons.push('"sessions" needs at least one session the retro reads, with words copied from it');
    } else {
      audit = auditOf(raw.audit);
      if (!audit) reasons.push('"audit" needs a "location" and a "finding": where the audit saw it, and what');
    }
    if (reasons.length > 0) {
      result.rejected.push({ index, subject, reasons });
      return;
    }
    result.findings.push({
      id: `${PREFIX[source]}${result.findings.length + 1}`,
      source,
      subject,
      cause,
      column,
      kind,
      file: textOf(raw.file),
      rule: textOf(raw.rule),
      change: textOf(raw.change),
      target,
      targetEvidence: idsOf(raw.targetEvidence).filter((id) => ctx.threads.has(id)),
      evidence,
      sessions: sessions2,
      audit,
      confidence,
      note: textOf(raw.note)
    });
  });
  if (source === "threads" || source === "sessions") {
    const verifications = verifyChanges(input2.verify, ctx, result, source);
    if (verifications.length) result.verifications = verifications;
  }
  if (source === "sessions") {
    const overview = overviewOf(input2.overview, ctx, result);
    if (overview) result.overview = overview;
  }
  return result;
}
function findingsFormat(source) {
  const evidence = source === "threads" ? '"evidence": [{ "thread": "t_\u2026", "excerpt": "a short quote of the thread" }]' : source === "sessions" ? '"sessions": [{ "session": "<id>", "excerpt": "words copied exactly from its report or summary", "moments": ["<uuid its report cites>"] }]' : '"audit": { "location": "CLAUDE.md:2-3", "finding": "what the audit says is wrong there" }';
  return [
    "## Your answer: findings, in the common format",
    "",
    'Write a JSON file (the path is given below) with what this source shows, then record it with the command given below. A finding is not a proposal: the analysis weighs the findings of every source against each other, then decides what becomes a proposal. Give each finding even when it rests on a single thread or session: say how strong it is in "confidence" and "note".',
    "",
    "```json",
    "{",
    '  "findings": [',
    "    {",
    '      "subject": "a few words",',
    '      "cause": "the ONE cause in the setup it points at (a rule missing, a rule ignored, a skill that misleads\u2026)",',
    `      ${evidence},`,
    '      "column": "keep | remove | improve (what you would suggest)",',
    '      "kind": "rule | hook | skill | command | agent | doc | setting | other",',
    '      "file": "the file of the existing rule, or where a change would go",',
    '      "rule": "the existing text concerned, word for word, if any",',
    '      "change": "the change you would suggest, if any",',
    '      "target": "project-shared | project-personal | user (only when the source tells it)",',
    ...source === "threads" ? ['      "targetEvidence": ["the threads that tell where it belongs"],'] : [],
    '      "confidence": 0.8,',
    '      "note": "how strong it is, how often it came back, what it is not"',
    "    }",
    "  ]" + (source === "threads" ? ',\n  "verify": [{ "change": "<ref>", "threads": ["t_\u2026"], "note": "what you saw" }]' : source === "sessions" ? ',\n  "verify": [{ "change": "<ref>", "sessions": ["<id>"], "note": "what you saw" }],\n  "overview": { "summary": "2 or 3 sentences", "items": [{ "kind": "pattern | friction | ritual", "title": "\u2026", "description": "\u2026", "sessions": ["<id>"], "idea": "optional lead" }] }' : ""),
    "}",
    "```",
    "",
    "- One cause per finding: two causes are two findings.",
    "- Copy ids, excerpts and moments exactly: they are checked by program.",
    ...source !== "audit" ? ['- "verify": one item per change adopted at the last retro the input lists to check (else leave it out).'] : [],
    ...source === "sessions" ? ['- "overview": what recurs across the sessions (8 items at most), for the user to find leads of their own.'] : [],
    "- Write in the language of the user (the threads and their prompts), with its accents."
  ];
}

// ../core/src/retroScope.ts
var DAY2 = 864e5;
async function retroScope(root, opts = {}) {
  const env = opts.env ?? process.env;
  const now = opts.now ?? Date.now();
  const dir = (0, import_node_path18.resolve)(root);
  const home = await retroHome(dir, env);
  const book2 = new RetroBook(home);
  const retros = (await book2.list()).filter((r) => r.root === dir);
  const lastRetro = retros.filter((r) => r.finishedAt !== null).at(-1) ?? null;
  const unfinished = retros.filter((r) => r.finishedAt === null);
  const afterLast = lastRetro ? Date.parse(lastRetro.until) + 1 : null;
  let options = [];
  let since;
  let source;
  if (opts.all) [since, source] = [null, "all"];
  else if (opts.since) [since, source] = [opts.since, "given"];
  else {
    const whole = await projectHistory(dir, { env });
    const threads = whole.stores.flatMap((s) => s.threads);
    const option = (label2, from, flag) => {
      const ts = from === null ? threads : threads.filter((t) => Date.parse(t.lastActivityAt) >= from);
      return {
        label: label2,
        since: from === null ? null : new Date(from).toISOString(),
        flag,
        threads: ts.length,
        bytes: ts.reduce((n, t) => n + t.bytes, 0),
        proposed: false,
        overlapsLastRetro: afterLast !== null && (from === null || from < afterLast)
      };
    };
    const days = (n) => option(`last ${n} days`, now - n * DAY2, `--since ${n}d`);
    options = [
      ...afterLast !== null ? [option("since the last retro", afterLast, "")] : [days(7)],
      days(30),
      option("whole history", null, "--all")
    ];
    const pick = afterLast !== null ? options[0] : options.find((o) => o.threads > 0) ?? options[0];
    pick.proposed = true;
    options = [pick, ...options.filter((o) => o !== pick)];
    since = pick.since ? new Date(pick.since) : null;
    source = afterLast !== null ? "last-retro" : "proposed";
  }
  const history2 = await projectHistory(dir, { since, env });
  return {
    root: dir,
    home,
    since: history2.since,
    until: new Date(now).toISOString(),
    source,
    history: history2,
    estimate: estimate(history2),
    lastRetro,
    unfinished,
    preferences: await book2.preferences(),
    options,
    toVerify: lastRetro ? adoptedChanges(lastRetro) : []
  };
}
function changesToVerify(retro2, previous) {
  const last = previous.filter((r) => r.root === retro2.root && r.finishedAt !== null && r.finishedAt <= retro2.startedAt).at(-1);
  return last ? adoptedChanges(last) : [];
}
var tokensOf = (chars) => Math.ceil(chars / 4);
function estimate(h) {
  const threads = h.stores.flatMap((s) => s.threads);
  const tokens = tokensOf(threads.reduce((n, t) => n + threadText(t).length, 0));
  return {
    tokens,
    classifyJev: Math.round(10 + threads.length * 0.25),
    classifyModel: Math.round(45 + threads.length),
    analysis: Math.round(60 + tokens / 1e3),
    audit: 480
  };
}
var who = (by, agent) => by === "user" ? "User" : agent ?? "Agent";
function entryText(e) {
  switch (e.kind) {
    case "comment": {
      const notes = [e.publishedAt ?? e.at];
      if (e.editedAt) notes.push(`edited ${e.editedAt}`);
      if (e.deletedAt) notes.push(`deleted ${e.deletedAt}`);
      return `[${who(e.author, e.agent)}] (${notes.join(", ")}) ${e.body}`;
    }
    case "status":
      return `(status -> ${e.status} by ${who(e.by, e.agent)}, ${e.at})`;
    case "deleted":
      return `(thread deleted, ${deletionLabel(e.reason)}, ${e.at})`;
  }
}
function threadText(t, store) {
  const a = t.anchor;
  const where4 = a.range ? `${a.path}:${a.range.startLine}-${a.range.endLine}` : `${a.path} (whole file)`;
  const lines = [
    `THREAD ${t.id} \xB7 ${where4} \xB7 ${t.state}` + (store ? ` \xB7 store ${store}` : "") + (t.branch ? ` \xB7 branch ${t.branch.branch}` : "")
  ];
  if (a.range && a.snippet) lines.push("code:", ...a.snippet.split("\n").map((l) => `  ${l}`));
  for (const e of t.conversation) lines.push(entryText(e));
  return lines.join("\n");
}
async function retroThreads(retro2, env = process.env) {
  const history2 = await projectHistory(retro2.root, { since: retro2.since ? new Date(retro2.since) : null, env });
  const wanted = new Set(retro2.threads);
  const threads = /* @__PURE__ */ new Map();
  for (const s of history2.stores)
    for (const t of s.threads)
      if (wanted.has(t.id))
        threads.set(t.id, {
          thread: t,
          store: s.saved ? `${s.root} (saved before its git worktree was removed)` : s.root
        });
  return { history: history2, threads };
}
var label = (l) => l ? `classified: ${l.category} ${FEEDBACK_CATEGORIES[l.category]?.split(":")[0] ?? "?"}` + (l.missingRule !== void 0 ? ` \xB7 missing rule ${l.missingRule.toFixed(2)}` : "") + (l.ignoredRule !== void 0 ? ` \xB7 ignored rule ${l.ignoredRule.toFixed(2)}` : "") : "";
function classifyInput(retro2, threads) {
  const grid = Object.entries(FEEDBACK_CATEGORIES).map(([n, d]) => `${n} ${d}`).join("\n");
  return [
    `# Classification input \u2014 retro ${retro2.id}`,
    `${threads.size} threads. For each one, give:`,
    '- "category": the ONE category below that best explains why the developer commented (the root cause, not the symptom);',
    '- "missingRule" (0 to 1): does the feedback reveal a constraint, convention or fact specific to this project (not general good practice) that the rules files do not state?',
    '- "ignoredRule" (0 to 1): does the feedback point to something the rules files already state, that the agent did not follow?',
    '- "confidence" (0 to 1) in the category.',
    "",
    "## Categories",
    grid,
    "",
    "## Threads",
    ...[...threads.values()].map(({ thread, store }) => threadText(thread, store) + "\n")
  ].join("\n");
}
function statsOf(ctx) {
  return retroStats(
    [...ctx.threads.values()].map((x) => x.thread),
    ctx.retro.classification?.labels
  );
}
function renderStats(s) {
  const lines = [
    `- ${s.threads} threads; reopened after the agent said it was done: ${s.reopened}; the agent asked a question: ${s.questions}; back-and-forth (the user replied again after the agent): ${s.backAndForth}; deleted: ${s.deleted} (removed by the user: ${s.deletedByUser}; with their branch, once the work was done: ${s.deletedWithBranch}; older, reason unknown: ${s.deleted - s.deletedByUser - s.deletedWithBranch}).`
  ];
  const cats = Object.entries(s.categories).sort((a, b) => b[1] - a[1]);
  if (cats.length > 0)
    lines.push(
      `- Classification (indicative): ${cats.map(([c, n]) => `${FEEDBACK_CATEGORIES[Number(c)]?.split(":")[0]} ${n}`).join(", ")}.`,
      `- Flagged as a possibly missing project rule: ${s.missingRule}; as a possibly ignored existing rule: ${s.ignoredRule}.`
    );
  return lines;
}
function renderPrevious(previous, exclusions) {
  if (previous.length === 0) return ["None: this is the first retro of the project."];
  const out2 = [];
  for (const r of previous) {
    out2.push(`### Retro ${r.id} (${r.since?.slice(0, 10) ?? "start"} to ${r.until.slice(0, 10)})`);
    for (const f of r.feedback) out2.push(`- Feedback of the user on the retro before it: ${f}`);
    for (const p of r.proposals) {
      const d = r.decisions[p.id];
      const files = r.applied[p.id]?.join(", ");
      out2.push(
        `- ${p.id} [${p.column}] ${p.subject} \u2192 ${d ? d.decision + (d.target ? ` (target ${d.target})` : "") : "no decision"}` + (d?.note ? `; note: ${d.note}` : "") + (files ? `; changed: ${files}` : "") + (p.change ? `; change: ${p.change.replace(/\s+/g, " ").slice(0, 300)}` : "")
      );
    }
    for (const w of r.watch) out2.push(`- watched: ${w.subject} (${w.evidence.map((e) => e.thread).join(", ")})`);
  }
  if (exclusions.length > 0) {
    out2.push(
      "",
      'Excluded subjects: never propose them again, unless at least 2 NEW threads raise them (then set "reopens" to "<retro>/<proposal>"):'
    );
    for (const x of exclusions) out2.push(`- ${x.retro}/${x.proposal}: ${x.subject} (excluded ${x.at.slice(0, 10)})`);
  }
  return out2;
}
function inputHead(title, ctx) {
  const { retro: retro2, threads } = ctx;
  const prefs2 = ctx.preferences.length ? ctx.preferences.map((p) => `- ${p.id}: ${p.body}`) : ["None yet."];
  return [
    `# ${title} \u2014 ${retro2.root}`,
    `Retro ${retro2.id}. Period: ${retro2.since ?? "the whole history"} to ${retro2.until}. ${threads.size} threads, from ${retro2.stores.length} comment store(s): ${retro2.stores.map((s) => s.root).join(", ")}.`,
    "",
    "## The user's retro preferences (apply them)",
    ...prefs2,
    "",
    "## Previous retros",
    ...renderPrevious(ctx.previous, exclusionsOf(ctx.previous)),
    ""
  ];
}
function renderThreads(ctx) {
  const labels = ctx.retro.classification?.labels ?? {};
  return [
    `## Threads (all ${ctx.threads.size} of them, oldest first)`,
    "",
    ...[...ctx.threads.values()].map(({ thread, store }) => {
      const sig = threadSignals(thread);
      const extra = [
        label(labels[thread.id]),
        sig.reopened ? "reopened" : "",
        sig.question ? "agent asked" : "",
        sig.rounds ? `${sig.rounds} round(s) of back-and-forth` : "",
        linkedSessions(thread).length ? "the agent's conversation is linked" : ""
      ].filter(Boolean);
      return threadText(thread, store) + (extra.length ? `
(${extra.join(" \xB7 ")})` : "") + "\n";
    })
  ];
}
