function parseLines(text, source, types) {
  const events = [];
  const warnings = [];
  let future = false;
  const end = text.lastIndexOf("\n");
  const lines = end === -1 ? [] : text.slice(0, end).split("\n");
  lines.forEach((line, i) => {
    if (line.trim() === "") return;
    let raw;
    try {
      raw = JSON.parse(line);
    } catch {
      warnings.push(`${source}:${i + 1}: invalid JSON, line skipped`);
      return;
    }
    const e = raw;
    if (typeof raw !== "object" || raw === null || typeof e.v !== "number" || typeof e.type !== "string") {
      warnings.push(`${source}:${i + 1}: not an event, line skipped`);
      return;
    }
    if (e.v > RETRO_SCHEMA_VERSION) {
      future = true;
      return;
    }
    if (!types.has(e.type)) {
      warnings.push(`${source}:${i + 1}: unknown event type "${e.type}", line skipped`);
      return;
    }
    events.push(raw);
  });
  return { events, warnings, future };
}
function foldRetro(events, warnings = [], future = false) {
  const first = events[0];
  if (!first || first.type !== "retro.started") return null;
  const r = {
    id: first.retroId,
    root: first.root,
    since: first.since,
    until: first.until,
    startedAt: first.at,
    stores: first.stores,
    threads: first.threads,
    bytes: first.bytes,
    preferences: first.preferences ?? [],
    sessionsMode: first.sessionsMode ?? null,
    sources: Array.isArray(first.sources) ? RETRO_SOURCES.filter((x) => first.sources.includes(x)) : [...RETRO_SOURCES],
    feedback: [],
    classification: null,
    proposals: [],
    watch: [],
    dropped: [],
    verifications: [],
    decisions: {},
    applied: {},
    conversations: {},
    sessions: null,
    reports: null,
    overview: null,
    usage: null,
    findings: {},
    finishedAt: null,
    readOnly: future,
    warnings
  };
  for (const e of events.slice(1)) {
    switch (e.type) {
      case "retro.feedback":
        r.feedback.push(e.body);
        break;
      case "retro.classified": {
        const c = r.classification ??= { by: [], labels: {} };
        if (!c.by.includes(e.by)) c.by.push(e.by);
        Object.assign(c.labels, e.labels);
        break;
      }
      case "retro.proposed":
        r.proposals = e.proposals;
        r.watch = e.watch;
        r.dropped = e.dropped;
        r.verifications = e.verifications ?? [];
        r.overview = e.overview ?? null;
        r.decisions = {};
        r.applied = {};
        break;
      case "retro.decided":
        r.decisions[e.proposal] = {
          decision: e.decision,
          at: e.at,
          ...e.target ? { target: e.target } : {},
          ...e.note ? { note: e.note } : {}
        };
        break;
      case "retro.applied":
        r.applied[e.proposal] = [.../* @__PURE__ */ new Set([...r.applied[e.proposal] ?? [], ...e.files])];
        break;
      case "retro.undone":
        delete r.decisions[e.proposal];
        delete r.applied[e.proposal];
        break;
      case "retro.conversation":
        if (!r.conversations[e.thread]?.available)
          r.conversations[e.thread] = { sessions: e.sessions, available: e.available, at: e.at };
        break;
      case "retro.sessions":
        r.sessions = {
          source: e.source,
          list: Array.isArray(e.sessions) ? e.sessions : [],
          costUsd: e.costUsd ?? null,
          durationMs: e.durationMs ?? null
        };
        break;
      case "retro.reports": {
        const sum = (a, b) => b === void 0 ? a ?? null : (a ?? 0) + b;
        r.reports = {
          source: e.source,
          list: Array.isArray(e.sessions) ? e.sessions : [],
          costUsd: sum(r.reports?.costUsd, e.costUsd),
          durationMs: sum(r.reports?.durationMs, e.durationMs),
          tokens: sum(r.reports?.tokens, e.tokens)
        };
        break;
      }
      case "retro.usage":
        r.usage = {
          source: e.source,
          tools: Array.isArray(e.tools) ? e.tools : [],
          windows: Array.isArray(e.windows) ? e.windows : []
        };
        break;
      case "retro.findings":
        r.findings[e.source] = {
          source: e.source,
          findings: Array.isArray(e.findings) ? e.findings : [],
          ...e.verifications ? { verifications: e.verifications } : {},
          ...e.overview ? { overview: e.overview } : {}
        };
        break;
      case "retro.finished":
        r.finishedAt ??= e.at;
        break;
      case "retro.started":
        break;
    }
  }
  return r;
}
function foldPreferences(events) {
  const prefs2 = /* @__PURE__ */ new Map();
  for (const e of events) {
    if (e.type === "preference.added") prefs2.set(e.id, { id: e.id, body: e.body, at: e.at });
    else prefs2.delete(e.id);
  }
  return [...prefs2.values()];
}
async function retroHome(root, env = process.env) {
