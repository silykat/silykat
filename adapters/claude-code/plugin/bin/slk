  }
  /** A folder for the files a retro writes for its agents. */
  async workDir(id) {
    if (!RETRO_ID.test(id)) throw new Error(`Invalid retro id: ${id}`);
    const dir = (0, import_node_path12.join)(this.dir, id);
    await (0, import_promises10.mkdir)(dir, { recursive: true });
    return dir;
  }
  get preferencesFile() {
    return (0, import_node_path12.join)(this.dir, "preferences.jsonl");
  }
  /** Every retro of this book, oldest first. */
  list() {
    return readRetros(this.dir);
  }
  read(id) {
    return readRetro(this.dir, id);
  }
  /** The retro, which must exist and accept writes. */
  async get(id) {
    const r = await this.read(id);
    if (!r) throw new Error(`Retro not found: ${id}`);
    return r;
  }
  /** The last finished retro of the project folder `root`, if any. */
  async lastFinished(root) {
    const done = (await this.list()).filter((r) => r.finishedAt !== null && r.root === (0, import_node_path12.resolve)(root));
    return done.at(-1) ?? null;
  }
  async preferences() {
    let text;
    try {
      text = await (0, import_promises10.readFile)(this.preferencesFile, "utf8");
    } catch (err) {
      if (err.code === "ENOENT") return [];
      throw err;
    }
    return foldPreferences(parseLines(text, "retros/preferences.jsonl", PREFERENCE_EVENTS).events);
  }
  async addPreference(body2) {
    const text = body2.trim();
    if (text === "") throw new Error("A preference cannot be empty");
    const ids = (await this.allPreferenceIds()).map((id2) => Number(id2.slice(1)));
    const id = `P${Math.max(0, ...ids) + 1}`;
    const at = (/* @__PURE__ */ new Date()).toISOString();
    await this.append(this.preferencesFile, [
      { v: RETRO_SCHEMA_VERSION, type: "preference.added", at, id, body: text }
    ]);
    return { id, body: text, at };
  }
  async removePreference(id) {
    if (!(await this.preferences()).some((p) => p.id === id)) throw new Error(`Preference not found: ${id}`);
    await this.append(this.preferencesFile, [
      { v: RETRO_SCHEMA_VERSION, type: "preference.removed", at: (/* @__PURE__ */ new Date()).toISOString(), id }
    ]);
  }
  /** Every preference id ever given, removed ones included: an id is never reused. */
  async allPreferenceIds() {
    try {
      const text = await (0, import_promises10.readFile)(this.preferencesFile, "utf8");
      return parseLines(text, "preferences", PREFERENCE_EVENTS).events.map((e) => e.id);
    } catch {
      return [];
    }
  }
  /** Starts a retro: its period and the threads it reads. */
  async start(scope2) {
    const retroId = newRetroId();
    const preferences = await this.preferences();
    await this.append(this.retroFile(retroId), [
      {
        v: RETRO_SCHEMA_VERSION,
        type: "retro.started",
        at: (/* @__PURE__ */ new Date()).toISOString(),
        retroId,
        ...scope2,
        root: (0, import_node_path12.resolve)(scope2.root),
        preferences
      }
    ]);
    return this.get(retroId);
  }
  /** Appends events to a retro still in progress. */
  async record(id, events) {
    const r = await this.get(id);
    if (r.readOnly) throw new Error(`Retro ${id} was written by a newer version of silykat: update silykat`);
    if (r.finishedAt) throw new Error(`Retro ${id} is finished`);
    const at = (/* @__PURE__ */ new Date()).toISOString();
    await this.append(
      this.retroFile(id),
      events.map((e) => ({ v: RETRO_SCHEMA_VERSION, at, ...e }))
    );
    return this.get(id);
  }
  async append(file, events) {
    await (0, import_promises10.mkdir)(this.dir, { recursive: true });
    await (0, import_promises10.appendFile)(file, events.map((e) => JSON.stringify(e) + "\n").join(""), { flag: "a" });
  }
};

// ../core/src/cadence.ts
var DEFAULT_CADENCE = thresholdsOf(DEFAULT_CONFIG);
function thresholdsOf(c) {
  return { days: c.retroReminderDays, bytes: c.retroReminderSizeKB * 1e3, maxDays: c.retroReminderMaxDays };
}
var DAY = 864e5;
async function retroCadence(root, opts = {}) {
  const env = opts.env ?? process.env;
  const now = opts.now ?? Date.now();
  const dir = (0, import_node_path13.resolve)(root);
  if (dir === LOOSE_ROOT || (0, import_node_path13.dirname)(dir) === dir) return null;
  const thresholds = opts.thresholds ?? thresholdsOf(await readConfig(env));
  const last = await lastRetroCovering(dir);
  let since = last ? Date.parse(last.until) : null;
  const history2 = await projectHistory(dir, { since: since === null ? null : new Date(since + 1), env });
  const threads = history2.stores.flatMap((s) => s.threads);
  const sessions2 = await projectAgentSessions(dir, since === null ? null : new Date(since).toISOString(), env);
  let first;
  if (since === null && threads.length + sessions2.length > 0) {
    const thread = threads.reduce((x, t) => Math.min(x, Date.parse(t.createdAt)), Infinity);
    const session2 = sessions2.reduce((x, t) => Math.min(x, Date.parse(t.startedAt)), Infinity);
    [since, first] = thread <= session2 ? [thread, "thread"] : [session2, "session"];
  }
  const days = since === null ? 0 : Math.max(0, Math.floor((now - since) / DAY));
  const reasons = [];
  if (threads.length + sessions2.length > 0) {
    if (days >= Math.min(thresholds.days, thresholds.maxDays)) reasons.push("days");
    if (history2.bytes >= thresholds.bytes) reasons.push("size");
    if (days >= thresholds.maxDays) reasons.push("max-days");
  }
  return {
    root: dir,
    lastRetro: last ? { id: last.id, root: last.root, until: last.until } : null,
    since: since === null ? null : new Date(since).toISOString(),
    ...first ? { first } : {},
    days,
    threads: threads.length,
    bytes: history2.bytes,
    sessions: sessions2.length,
    thresholds,
    due: reasons.length > 0,
    reasons
  };
}
