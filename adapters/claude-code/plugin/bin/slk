function parseDateArg(value, now = Date.now()) {
  const days = /^(\d+)d$/.exec(value.trim());
  if (days) return new Date(now - Number(days[1]) * 864e5);
  const day2 = /^(\d{4})-(\d{2})-(\d{2})(T.+)?$/.exec(value.trim());
  if (!day2) return null;
  const date = new Date(day2[4] ? value.trim() : `${day2[1]}-${day2[2]}-${day2[3]}T00:00:00`);
  const exists = (/* @__PURE__ */ new Date(`${day2[1]}-${day2[2]}-${day2[3]}T00:00:00Z`)).getUTCDate() === +day2[3];
  return exists && !Number.isNaN(date.getTime()) ? date : null;
}
function dateArgLabel(value, date) {
  const pad = (n) => String(n).padStart(2, "0");
  const day2 = `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  const days = /^(\d+)d$/.exec(value.trim());
  if (days) return `${day2} (${days[1]} day${days[1] === "1" ? "" : "s"})`;
  return /T/.test(value) ? `${day2} ${pad(date.getHours())}:${pad(date.getMinutes())}` : day2;
}
