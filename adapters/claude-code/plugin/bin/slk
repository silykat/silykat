function sessionRefOf(raw) {
  if (typeof raw !== "object" || raw === null) return void 0;
  const { id, message } = raw;
  if (typeof id !== "string" || id.trim() === "") return void 0;
  return typeof message === "string" && message.trim() !== "" ? { id, message } : { id };
}
