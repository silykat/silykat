  ".yaml": "yaml",
  ".css": "css",
  ".html": "html",
  ".sql": "sql",
  ".c": "c",
  ".cpp": "cpp",
  ".h": "c",
  ".cs": "csharp",
  ".php": "php",
  ".swift": "swift"
};
function fence(code, path, startLine) {
  const numbered = startLine === null ? code : code.split("\n").map((l, i) => `${startLine + i} | ${l}`).join("\n");
  const longest = Math.max(0, ...(numbered.match(/`+/g) ?? []).map((r) => r.length));
  const ticks = "`".repeat(Math.max(3, longest + 1));
  return `${ticks}${LANGUAGES[(0, import_node_path19.extname)(path)] ?? ""}
${numbered}
${ticks}`;
}
function where(l) {
  const a = l.view.thread.anchor;
  if (!a.range) return `${a.path} (whole file)`;
  if (l.outdated) return `${a.path} (outdated)`;
  const r = l.range;
  return `${a.path}:${r.startLine}${r.endLine !== r.startLine ? `-${r.endLine}` : ""}`;
}
function renderThread(l) {
  const { thread, comments } = l.view;
  const a = thread.anchor;
  const tag = versionTag(a);
  const lines = [`## ${thread.id} \u2014 ${where(l)}`, ""];
  const facts = [`Status: ${thread.status}`, `Version: ${l.view.rev} (pass --rev ${l.view.rev} when you reply)`];
  if (tag)
    facts.push(`About the ${tag === "Index" ? "staged version (index)" : `version ${tag}`}, not the working tree`);
  if (a.diff) facts.push(`Made in a diff (${a.diff.side === "base" ? "old" : "new"} side)`);
  lines.push(facts.join(" \xB7 "), "");
  if (l.outdated) lines.push("\u26A0\uFE0F Outdated: this code is no longer in the file. Recorded code:", "");
  if (a.range) lines.push(fence(l.code, a.path, l.outdated ? null : l.range.startLine), "");
  for (const c of comments) {
    const who3 = c.author === "user" ? "User" : c.agentName ?? "Agent";
    lines.push(`**${who3}** (${c.createdAt}${c.editedAt ? `, edited ${c.editedAt}` : ""}):`, c.body, "");
  }
  return lines.join("\n").trimEnd();
}
function renderReviews(located, reviews) {
  const ids = new Set(located.flatMap((l) => l.view.comments.map((c) => c.reviewId).filter((id) => id !== null)));
  const withSummary = reviews.filter((r) => ids.has(r.id) && r.state === "submitted" && r.summary);
  return withSummary.map((r) => `> **Review summary** (${r.submittedAt}): ${r.summary}`).join("\n");
}

// src/args.ts
var import_node_util = require("node:util");
var UsageError = class extends Error {
};
function parse(rest, options) {
  try {
    const parsed = (0, import_node_util.parseArgs)({ args: rest, options: { root: { type: "string" }, ...options }, allowPositionals: true });
    return { values: parsed.values, positionals: parsed.positionals };
  } catch (err) {
    throw new UsageError(err instanceof Error ? err.message : String(err));
  }
}
var str = (v) => typeof v === "string" ? v : void 0;

// src/history.ts
var ORIGIN = {
  root: "this folder",
  below: "subfolder",
  above: "folder above",
  worktree: "git worktree",
  saved: "saved from a worktree"
};
var branchLabel2 = (b) => b ? topicLabel({ kind: "branch", ...b }) : null;
var states = (c, d) => HISTORY_STATES.map((s) => `${c[s]} ${s}${s === "deleted" && d && c.deleted > 0 ? ` (${deletions(d)})` : ""}`).join(
  " \xB7 "
);
function deletions(d) {
  const parts = [];
  if (d.user) parts.push(`${d.user} removed by the user`);
  if (d["branch-gone"]) parts.push(`${d["branch-gone"]} with their branch`);
  if (d.unknown) parts.push(`${d.unknown} reason unknown`);
  return parts.join(", ");
}
var plural = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
function renderHistory(h) {
  const period = h.since ? `Since ${h.since}` : "Whole history";
  const parts = [
    `# silykat history \u2014 ${h.root}`,
    `${period} \xB7 ${plural(h.threads, "thread")} \xB7 ${formatBytes(h.bytes)} of journals

${states(h.states, h.deletions)}` + (h.archived > 0 ? ` \u2014 ${h.archived} archived` : "")
  ];
  if (h.stores.length === 0) {
    parts.push("No comment store in this folder, its subfolders or the worktrees of its repositories.");
    return parts.join("\n\n");
  }
  const rows = h.stores.map(
    (s) => `| ${storeLabel(s, h.root)} | ${ORIGIN[s.origin]} | ${s.threads.length} | ` + HISTORY_STATES.map((st) => s.states[st]).join(" | ") + ` | ${formatBytes(s.bytes)} |`
  );
  parts.push(
    [
      "## Comment stores",
      "",
      `| Store | Found as | Threads | ${HISTORY_STATES.join(" | ")} | Size |`,
      `| --- | --- | --- | ${HISTORY_STATES.map(() => "---").join(" | ")} | --- |`,
      ...rows
    ].join("\n")
  );
  const warnings = h.stores.flatMap((s) => s.warnings.map((w) => `- ${storeLabel(s, h.root)}: ${w}`));
  if (warnings.length > 0) parts.push(["## Warnings", "", ...warnings].join("\n"));
  if (h.threads === 0) {
    parts.push(h.since ? "No thread was active in this period." : "No thread yet.");
    return parts.join("\n\n");
  }
  parts.push("## Threads");
  for (const s of h.stores) for (const t of s.threads) parts.push(renderThreadHistory(t, storeLabel(s, h.root)));
  return parts.join("\n\n");
}
function where2(t) {
  const a = t.anchor;
  if (!a.range) return `${a.path} (whole file)`;
  return `${a.path}:${a.range.startLine}${a.range.endLine !== a.range.startLine ? `-${a.range.endLine}` : ""}`;
}
var who2 = (by, agent) => by === "user" ? "User" : agent ?? "Agent";
function renderEntry(e) {
  switch (e.kind) {
    case "comment": {
      const notes = [e.at];
      if (e.publishedAt) notes.push(`submitted in a review ${e.publishedAt}`);
      if (e.editedAt) notes.push(`edited ${e.editedAt}`);
      if (e.deletedAt) notes.push(`deleted ${e.deletedAt}`);
      if (e.session) notes.push(`session ${e.session.id}${e.session.message ? `, message ${e.session.message}` : ""}`);
      return `**${who2(e.author, e.agent)}** (${notes.join(", ")}):
${e.body}`;
    }
    case "status":
      return `_Status \u2192 ${e.status} (${who2(e.by, e.agent)}, ${e.at})_`;
    case "deleted":
      return `_Thread deleted: ${deletionLabel(e.reason)} (${e.at})_`;
  }
}
function renderThreadHistory(t, store) {
  const a = t.anchor;
  const facts = [`Store: ${store}`];
  if (t.state === "deleted") facts.push(`Deleted: ${deletionLabel(t.deletedReason)}`);
  if (t.archivedAt) facts.push(`Archived ${t.archivedAt}`);
  const branch = branchLabel2(t.branch);
  if (branch) facts.push(`Branch: ${branch}`);
  const tag = versionTag(a);
  if (tag) facts.push(`About the ${tag === "Index" ? "staged version (index)" : `version ${tag}`}`);
  if (a.diff) facts.push(`Made in a diff (${a.diff.side === "base" ? "old" : "new"} side)`);
  if (t.readOnly) facts.push("Written by a newer version of silykat: partly shown");
  const lines = [`### ${t.id} \u2014 ${where2(t)} \xB7 ${t.state}`, "", facts.join(" \xB7 "), ""];
  if (a.range) lines.push(fence(a.snippet, a.path, a.range.startLine), "");
  for (const e of t.conversation) lines.push(renderEntry(e), "");
  return lines.join("\n").trimEnd();
}

// src/archive.ts
var import_node_path20 = require("node:path");
var OK = 0;
var ERROR = 1;
var ARCHIVE_USAGE = `Archive and clean up (on the project, as slk review history: the folder, its subfolders, its worktrees).
Archived threads leave the editor and slk review list, and stay in slk review history and in retros. Only do this
when the user asks:
  slk review archive <thread-id>\u2026         Archive these threads
  slk review archive --resolved-before <date>
                                          Archive every thread resolved before a date (2026-10-01,
                                          or 30d for 30 days ago)
  slk review archive --list [--format md|json]
                                          The archived threads
  slk review unarchive <thread-id>\u2026       Bring archived threads back to the editor
  slk review purge --before <date> [--yes [--count <n>]] [--format md|json]
                                          Delete for good the finished threads (resolved, archived
                                          or deleted) with nothing published since a date. Without
                                          --yes, only says how many and which: show the user, and
                                          run it again with --yes once they confirm (--count: the
                                          number announced; refused if it changed). Threads still
                                          in progress are kept, and so are those a retro has not
                                          read yet. Keep a copy first: slk review history --format json
                                          --out <file>
  slk review purge --history [--yes] [--format md|json]
                                          Erase the history kept for retros: the deleted threads,
                                          and the threads saved from worktrees (when the user no
                                          longer keeps it: slk config set keep-history off)`;
async function archive(rest, io, dateOption) {
  const { values, positionals } = parse(rest, {
    "resolved-before": { type: "string" },
    list: { type: "boolean" },
    format: { type: "string" }
  });
  const format = formatOf(str(values.format));
  const root = (0, import_node_path20.resolve)(io.cwd, str(values.root) ?? ".");
  const resolvedOption = str(values["resolved-before"]);
  const modes = [positionals.length > 0, resolvedOption !== void 0, values.list === true].filter(Boolean).length;
  if (modes !== 1)
    throw new UsageError("slk review archive takes thread ids, or --resolved-before <date>, or --list (one of them)");
  const threads = await projectThreads([root], io.env);
  if (values.list === true) {
    const archived = archivedThreads(threads);
    if (format === "json")
      io.out(
        JSON.stringify(
          archived.map((t) => threadJson2(t)),
          null,
          2
        )
      );
    else
      io.out(
        archived.length === 0 ? `No archived thread in ${root}.` : [
          `${plural2(archived.length, "archived thread")} in ${root} (slk review unarchive <id> brings one back):`,
          ...archived.map((t) => `  ${threadLine(t, root)}`)
        ].join("\n")
      );
    return OK;
  }
  const date = resolvedOption === void 0 ? null : dateOption(resolvedOption, "--resolved-before");
  const selected = date ? resolvedBefore(threads, date) : byIds(threads, positionals, root);
  const result = await archiveThreads(selected);
  return report(io, format, result, selected, root, {
    none: date ? `No resolved thread to archive: none was resolved before ${dateArgLabel(resolvedOption, date)} in ${root}.` : "Nothing to archive.",
    done: (n) => `Archived ${plural2(n, "thread")}: ${n === 1 ? "it is" : "they are"} no longer shown in the editor nor in slk review list, and ${n === 1 ? "stays" : "stay"} in slk review history and in retros (slk review unarchive <id> brings one back).`,
    unchanged: (n) => `${plural2(n, "thread")} ${n === 1 ? "was" : "were"} already archived.`
  });
}
async function unarchive(rest, io) {
  const { values, positionals } = parse(rest, { format: { type: "string" } });
  const format = formatOf(str(values.format));
  if (positionals.length === 0) throw new UsageError("missing <thread-id>");
  const root = (0, import_node_path20.resolve)(io.cwd, str(values.root) ?? ".");
  const selected = byIds(await projectThreads([root], io.env), positionals, root);
  const result = await unarchiveThreads(selected);
  return report(io, format, result, selected, root, {
    none: "Nothing to unarchive.",
    done: (n) => `Unarchived ${plural2(n, "thread")}: back in the editor and in slk review list.`,
    unchanged: (n) => `${plural2(n, "thread")} ${n === 1 ? "was" : "were"} not archived: nothing to do.`
  });
}
async function purge(rest, io, dateOption) {
  const { values, positionals } = parse(rest, {
    before: { type: "string" },
    history: { type: "boolean" },
    yes: { type: "boolean" },
    count: { type: "string" },
    format: { type: "string" }
  });
  if (positionals.length > 0) throw new UsageError(`slk review purge takes no argument: "${positionals[0]}"`);
  const format = formatOf(str(values.format));
  const root = (0, import_node_path20.resolve)(io.cwd, str(values.root) ?? ".");
  const beforeOption = str(values.before);
  if (values.history === true) {
    if (beforeOption !== void 0 || values.count !== void 0)
      throw new UsageError("slk review purge --history takes neither --before nor --count");
    return purgeHistory(root, values.yes === true, format, io);
  }
  if (beforeOption === void 0) throw new UsageError("slk review purge needs --before <date> (or --history)");
  const date = dateOption(beforeOption, "--before");
  const since = dateArgLabel(beforeOption, date);
  const count = str(values.count);
  if (count !== void 0 && !/^\d+$/.test(count)) throw new UsageError(`--count must be a number, not "${count}"`);
  const plan = purgePlan(await projectThreads([root], io.env), date, await retroReading([root]));
  const n = plan.threads.length;
  if (values.yes !== true) {
    if (format === "json") {
      io.out(
        JSON.stringify(
          {
            before: date.toISOString(),
            threads: plan.threads.map((t) => threadJson2(t)),
            bytes: plan.bytes,
            inProgress: plan.inProgress.map((t) => t.thread.id),
            unreadByRetro: plan.unread.map((t) => t.thread.id),
            retro: plan.retro
          },
          null,
          2
        )
      );
      return OK;
    }
    const kept = (plan.inProgress.length > 0 ? `
${plural2(plan.inProgress.length, "thread")} as old ${plan.inProgress.length === 1 ? "is" : "are"} still in progress (open, needs-info, addressed, or with a draft reply in your review): kept.` : "") + retroNote(plan);
    io.out(
      n === 0 ? `No finished thread without activity since ${since} in ${root}: nothing to delete.${kept}` : [
        `${plural2(n, "thread")} would be deleted for good (finished, nothing published since ${since}; ${formatBytes(plan.bytes)}):`,
        ...plan.threads.map((t) => `  ${threadLine(t, root)}`)
      ].join("\n") + kept + `
Nothing is deleted yet: they stay in slk review history and in retros until then. Keep a copy first with slk review history --format json --out <file>. To delete ${n === 1 ? "it" : "these " + n} for good: slk review purge --before ${beforeOption} --yes --count ${n}`
    );
    return OK;
  }
  if (count !== void 0 && Number(count) !== n) {
    io.err(
      `slk: ${plural2(n, "thread")} now match${n === 1 ? "es" : ""}, not ${count}: the threads changed since. Nothing was deleted: run slk review purge --before ${beforeOption} again to see them.`
    );
    return ERROR;
  }
  const result = await purgeThreads(plan.threads);
  return report(io, format, result, plan.threads, root, {
    none: `No finished thread without activity since ${since}: nothing deleted.`,
    done: (k) => `Deleted ${plural2(k, "thread")} for good (${formatBytes(plan.bytes)}).`
  });
}
function retroNote(plan) {
  if (!plan.retro) return "\nNo retro in this project yet: no thread is kept for one.";
  const k = plan.unread.length;
  return k === 0 ? "" : `
${plural2(k, "finished thread")} as old ${k === 1 ? "is" : "are"} not read by a retro yet: kept for the next one.`;
}
async function purgeHistory(root, yes, format, io) {
  const plan = await historyPlan([root], io.env);
  const summary = historySummary(plan.deleted.length, plan.saved.length);
  if (!yes) {
    if (format === "json")
      io.out(
        JSON.stringify(
          { deleted: plan.deleted.map((t) => threadJson2(t)), saved: plan.saved.map((s) => s.saved.dir) },
          null,
          2
        )
      );
    else
      io.out(
        summary === null ? `No history kept in ${root}: nothing to erase.` : `History kept in ${root}: ${summary}. Nothing is erased yet. To erase it for good (gone from slk review history and from retros): slk review purge --history --yes`
      );
    return OK;
  }
  const erased = await eraseHistory(plan);
  if (format === "json") io.out(JSON.stringify(erased, null, 2));
  else
    io.out(
      erased.threads + erased.saved === 0 ? "No history kept: nothing erased." : `Erased for good: ${historySummary(erased.threads, erased.saved)}.`
    );
  return OK;
}
function byIds(threads, ids, root) {
  return ids.map((id) => {
    const found = threads.find((t) => t.thread.id === id);
    if (!found) throw new Error(`Thread not found: ${id} (in ${root}, its subfolders and its worktrees)`);
    return found;
  });
}
function report(io, format, result, selected, root, text) {
  if (format === "json") io.out(JSON.stringify(result, null, 2));
  else {
    const lines = [
      selected.length === 0 ? text.none : result.done.length > 0 ? text.done(result.done.length) : "",
      text.unchanged && result.unchanged.length > 0 ? text.unchanged(result.unchanged.length) : ""
    ];
    for (const f of result.failed) {
      const t = selected.find((x) => x.thread.id === f.id);
      lines.push(`Failed: ${t ? threadLine(t, root) : f.id}: ${f.error}`);
    }
    io.out(lines.filter((l) => l !== "").join("\n"));
  }
  return result.failed.length > 0 ? ERROR : OK;
}
function formatOf(format) {
  const f = format ?? "md";
  if (f !== "md" && f !== "json") throw new UsageError(`--format must be "md" or "json", not "${f}"`);
  return f;
}
var plural2 = (n, word) => `${n} ${word}${n === 1 ? "" : "s"}`;
function threadLine({ thread: t, store }, root) {
  const a = t.anchor;
  const place = a.range ? `${a.path}:${a.range.startLine}` : `${a.path} (whole file)`;
  const first = t.conversation.find((e) => e.kind === "comment");
  const excerpt = first?.kind === "comment" ? first.body.split("\n")[0].trim() : "";
  const facts = [
    t.id,
    storeLabel(store, root) === "." ? place : `${storeLabel(store, root)}: ${place}`,
    t.state,
    ...t.archivedAt ? [`archived ${t.archivedAt.slice(0, 10)}`] : [],
    `last activity ${t.lastActivityAt.slice(0, 10)}`
  ];
  return `${facts.join(" \xB7 ")} \u2014 "${excerpt.length > 60 ? `${excerpt.slice(0, 59)}\u2026` : excerpt}"`;
}
function threadJson2({ thread: t, store }) {
  const first = t.conversation.find((e) => e.kind === "comment");
  return {
    id: t.id,
    store: store.root,
    path: t.anchor.path,
    range: t.anchor.range,
    state: t.state,
    archivedAt: t.archivedAt,
    resolvedAt: t.resolvedAt,
    lastActivityAt: t.lastActivityAt,
    firstComment: first?.kind === "comment" ? first.body : null,
    bytes: t.bytes
  };
}

// src/retro.ts
var import_promises17 = require("node:fs/promises");
var import_node_path21 = require("node:path");
var RETRO_USAGE = `Retros (look back at the feedback of a period with your agent, and improve its setup):
  slk retro scope [--since <date> | --all]
                                          What a retro would cover: period (since the last retro),
                                          stores, threads, size, time; its sources and their
                                          settings; the last retro, preferences
  slk retro sources [--set <source>=yes|no|ask]\u2026
                                          The settings of the sources of a retro (reviews, sessions,
                                          audit): those of the project, else of the machine; --set
                                          writes the project's (in its .silykat/config.json)
  slk retro start [--since <date> | --all] [--sources reviews,sessions,audit]
                                          Start a retro on that period, reading those sources (at
                                          least one; default: all three): prints its id
  slk retro feedback <retro> --body -     What the user said about the previous retro
  slk retro input <retro> --for classify|threads|sessions|audit|analysis
                                          Write what a step of the retro reads, in a file of the
                                          retro: prints its path. threads, sessions, audit: one
                                          source, for its own agent; analysis: the findings of every
                                          source (or every source, when none was read on its own)
  slk retro findings <retro> --source threads|sessions|audit --body -
                                          Record what one source shows: {"findings":[{"subject",
                                          "cause","evidence"|"sessions"|"audit","confidence",\u2026}]}
                                          (refused while some are rejected)
  slk retro classification <retro> --by <name> --body -
                                          Record labels: {"labels":[{"thread","category",
                                          "confidence","missingRule","ignoredRule"}]}
  slk retro check <retro> --body -        Apply the guard rails to proposals, record nothing
  slk retro propose <retro> --body -      Record the proposals (refused while some are rejected)
  slk retro show <retro>                  The retro: proposals with their threads and numbers
  slk retro show <retro> <proposal> | --next
                                          One proposal, to present it to the user (--next: the next
                                          one to decide, in the order of the discussion)
  slk retro decide <retro> <proposal> accepted|modified|excluded|retargeted
           [--target project-shared|project-personal|user] [--note <text>]
  slk retro applied <retro> <proposal> --file <path>\u2026
                                          Files changed for a proposal
  slk retro undo <retro> <proposal>       Undo a decision recorded by mistake, with its files
                                          (the journal is never edited by hand)
  slk retro finish <retro>                Close the retro: prints the files changed
  slk retro list                          The retros of the project
  slk retro prefs [add --body <text> | remove <id>]
                                          The user's retro preferences
  slk retro key                           Is the Jev key set up, and safely? (never read)
  slk retro cadence                       Is a retro due? Days, size of the threads and agent
                                          sessions since the last retro, against the reminder
                                          settings (slk config)
  The project is --root (default: the current folder). --body - reads stdin, --body-file a file.`;
var RETRO_OPTIONS = {
  since: { type: "string" },
  all: { type: "boolean" },
  format: { type: "string" },
  body: { type: "string" },
  "body-file": { type: "string" },
  for: { type: "string" },
  by: { type: "string" },
  target: { type: "string" },
  note: { type: "string" },
  file: { type: "string", multiple: true },
  next: { type: "boolean" },
  source: { type: "string" },
  sources: { type: "string" },
  set: { type: "string", multiple: true }
};
async function retro(rest, io, parseSince2) {
  const [action, ...args] = rest;
  const { values, positionals } = parse(args, RETRO_OPTIONS);
  const root = (0, import_node_path21.resolve)(io.cwd, str(values.root) ?? ".");
  const json = str(values.format) === "json";
  const ctx = { io, values, positionals, root, json, parseSince: parseSince2 };
  switch (action) {
    case "scope":
      return scope(ctx);
    case "start":
      return start(ctx);
    case "sources":
      return sources(ctx);
    case "feedback":
      return feedback(ctx);
    case "input":
      return input(ctx);
    case "classification":
      return classification(ctx);
    case "findings":
      return findings(ctx);
    case "check":
      return check(ctx, false);
    case "propose":
      return check(ctx, true);
    case "show":
      return show(ctx);
    case "decide":
      return decide(ctx);
    case "applied":
      return applied(ctx);
    case "undo":
      return undo(ctx);
    case "finish":
      return finish(ctx);
    case "list":
      return list(ctx);
    case "prefs":
      return prefs(ctx);
    case "key":
      return key(ctx);
    case "cadence":
      return cadence(ctx);
    default:
      throw new UsageError(`unknown retro action: ${action ?? "(none)"}`);
  }
}
var book = async (c) => new RetroBook(await retroHome(c.root, c.io.env));
async function retroOf(c) {
  const id = c.positionals[0];
  if (!id) throw new UsageError("missing <retro-id> (slk retro list)");
  const b = await book(c);
  return { book: b, retro: await b.get(id) };
}
async function body(c) {
  let text = str(c.values.body);
  if (text === "-") text = await c.io.readStdin();
  const file = str(c.values["body-file"]);
  if (file) text = await (0, import_promises17.readFile)((0, import_node_path21.resolve)(c.io.cwd, file), "utf8");
  if (text === void 0 || text.trim() === "") throw new UsageError("needs --body <text>, --body - or --body-file");
  return text;
}
function parseJson(text) {
  try {
    return JSON.parse(text);
  } catch (err) {
    throw new Error(`invalid JSON: ${err instanceof Error ? err.message : String(err)}`);
  }
}
var out = (c, data, md) => {
  c.io.out(c.json ? JSON.stringify(data, null, 2) : md());
  return 0;
};
async function scopeOf(c) {
  const all = c.values.all === true;
  const since = c.parseSince(str(c.values.since));
  if (all && since) throw new UsageError("--since and --all do not go together");
  return retroScope(c.root, { since, all, env: c.io.env });
}
var quote = (p) => /^[\w./-]+$/.test(p) ? p : `'${p.replace(/'/g, `'\\''`)}'`;
var minutes = (s) => s < 90 ? `${Math.max(1, Math.round(s / 60))} min` : `${Math.round(s / 60)} min`;
function day(iso) {
  if (!iso) return "the start";
  const d = new Date(iso);
  const p = (n) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`;
}
var SESSIONS_MODE_LINE = {
  reports: "through a report on each session, written by a model (finer, costs more; or the agent's own summaries, cheaper: slk config set retro-sessions insights)",
  insights: "through the agent's own summaries of them (Claude Code's /insights: cheaper; or a report on each session, finer: slk config set retro-sessions reports)"
};
var SOURCE_NAME = {
  reviews: "Reviews (your review threads)",
  sessions: "Sessions (your sessions with the agent)",
  audit: "Audit of the setup (/doctor prompt-audit)"
};
var SETTING_MEANING = {
  yes: "always read",
  no: "never read",
  ask: "asked at each retro"
};
var ORIGIN2 = {
  project: "the project's setting",
  machine: "the machine's setting",
  default: "the default"
};
function renderSources(settings, s, root) {
  const lines = [
    "## Sources",
    "",
    "A retro reads one source or more (at least one), as their settings say: yes (always), no (never), ask (asked at each retro).",
    ""
  ];
  for (const src of RETRO_SOURCES) {
    const x = settings.sources[src];
    const data = src === "reviews" && s ? ` In this period: ${s.history.threads} thread${s.history.threads === 1 ? "" : "s"}.` : src === "audit" && s ? ` About ${minutes(s.estimate.audit)}.` : "";
    lines.push(`- **${SOURCE_NAME[src]}**: ${x.setting}, ${SETTING_MEANING[x.setting]} (${ORIGIN2[x.origin]}).${data}`);
  }
  lines.push(
    "",
    ...settings.projectSet ? ["The project has its retro settings: follow them, without asking for them again (even at its first retro)."] : [
      "This project has no retro settings yet: ask the user the setting of each source (yes, no or ask), then save them for the project:",
      `slk retro sources --root ${quote(root)} --set reviews=<yes|no|ask> --set sessions=<yes|no|ask> --set audit=<yes|no|ask>`
    ]
  );
  return lines;
}
function renderScope(s, keepHistory, sessionsMode, settings) {
  const h = s.history;
  const period = s.source === "last-retro" ? `since the last retro (${day(s.since)})` : s.source === "all" ? "the whole history" : s.source === "given" ? `since ${day(s.since)}` : s.since ? `proposed for a first retro: since ${day(s.since)}` : "proposed for a first retro: the whole history";
  const lines = [
    `# Retro scope \u2014 ${s.root}`,
    "",
    `- **Period**: ${period}, until now.`,
    `- **Threads**: ${h.threads} (${HISTORY_STATES.map((st) => `${h.states[st]} ${st}`).join(", ")}).`,
    ...keepHistory ? [] : [
      "- **History**: not kept on this machine (keep-history is off): deleted threads are erased, so this retro does not see them."
    ],
    `- **The agent's sessions**: read ${SESSIONS_MODE_LINE[sessionsMode]}.`,
    `- **Size**: ${formatBytes(h.bytes)} of journals, about ${Math.round(s.estimate.tokens / 1e3)}k tokens to read.`,
    `- **Time** (estimate): classification ${minutes(s.estimate.classifyJev)} with Jev or ${minutes(s.estimate.classifyModel)} with a small model, then analysis ${minutes(s.estimate.analysis)}.`,
    `- **Retro journal**: ${(0, import_node_path21.resolve)(s.home, ".silykat", "retros")}`,
    "",
    ...renderSources(settings, s, s.root),
    "",
    "## Comment stores",
    "",
    ...h.stores.length ? h.stores.map(
      (st) => `- ${storeLabel(st, h.root)} (${st.origin}): ${st.threads.length} threads, ${formatBytes(st.bytes)}`
    ) : ["- none: nothing has been commented in this project yet"]
  ];
  if (s.options.length > 0) {
    lines.push("", "## Periods to choose from", "");
    for (const o of s.options)
      lines.push(
        `- ${o.label} (${o.flag || "the default"}${o.proposed ? ", proposed" : ""}): ${o.threads} threads, ${formatBytes(o.bytes)}` + (o.overlapsLastRetro ? " (reads again threads of the last retro)" : "")
      );
  }
  lines.push("", "## Last retro", "");
  if (!s.lastRetro) lines.push("None: this would be the first retro of this project.");
  else lines.push(...renderOutcome(s.lastRetro));
  if (s.toVerify.length > 0)
    lines.push(
      "",
      `This retro will check whether the ${s.toVerify.length} change(s) adopted then reduced the feedback on their subject.`
    );
  if (s.unfinished.length > 0) {
    lines.push("", "## Unfinished retros", "");
    for (const r of s.unfinished)
      lines.push(
        `- ${r.id}, started ${day(r.startedAt)}: ${r.proposals.length} proposals, ${Object.keys(r.decisions).length} decided`
      );
  }
  lines.push("", "## Retro preferences", "");
  lines.push(...s.preferences.length ? s.preferences.map((p) => `- ${p.id}: ${p.body}`) : ["None yet."]);
  return lines.join("\n");
}
function renderOutcome(r) {
  const lines = [`${r.id}, ${day(r.since)} to ${day(r.until)}, finished ${day(r.finishedAt)}.`];
  for (const p of r.proposals) {
    const d = r.decisions[p.id];
    const files = r.applied[p.id];
    lines.push(
      `- ${p.id} [${COLUMN_TITLE[p.column]}] ${p.title}: ${d ? d.decision + (d.target ? ` (${d.target})` : "") : "no decision"}` + (files?.length ? ` \u2192 ${files.join(", ")}` : "")
    );
  }
  if (r.proposals.length === 0) lines.push("- no proposal");
  return lines;
}
async function scope(c) {
  const s = await scopeOf(c);
  const { keepHistory, retroSessions: sessionsMode } = await readConfig(c.io.env);
  const settings = await readSourceSettings(s.home, c.io.env);
  return out(
    c,
    {
      ...s,
      keepHistory,
      sessionsMode,
      sources: settings,
      history: void 0,
      threads: s.history.threads,
      bytes: s.history.bytes,
      states: s.history.states,
      stores: s.history.stores.map((st) => ({
        root: st.root,
        origin: st.origin,
        threads: st.threads.length,
        bytes: st.bytes
      }))
    },
    () => renderScope(s, keepHistory, sessionsMode, settings)
  );
}
async function sources(c) {
  const home = await retroHome(c.root, c.io.env);
  const sets = Array.isArray(c.values.set) ? c.values.set : [];
  if (sets.length > 0) {
    const change = {};
    for (const x of sets) {
      const [name, value] = x.split("=").map((v) => v.trim());
      if (!RETRO_SOURCES.includes(name))
        throw new UsageError(`--set takes <source>=<setting>, the source one of ${RETRO_SOURCES.join(", ")}: "${x}"`);
      if (!SOURCE_SETTINGS.includes(value))
        throw new UsageError(`--set ${name} takes ${SOURCE_SETTINGS.join(", ")}, not "${value ?? ""}"`);
      change[SOURCE_KEY[name]] = value;
    }
    await prepareStoreHome(home);
    await writeProjectConfig(home, change);
  }
  const settings = await readSourceSettings(home, c.io.env);
  return out(
    c,
    settings,
    () => [...sets.length ? [`Saved for the project (${home}).`, ""] : [], ...renderSources(settings, null, c.root)].join(
      "\n"
    )
  );
}
function sourcesOf(c) {
  const given = str(c.values.sources);
  if (given === void 0) return [...RETRO_SOURCES];
  const names = given.split(",").map((x) => x.trim()).filter(Boolean);
  for (const n of names)
    if (!RETRO_SOURCES.includes(n))
      throw new UsageError(`--sources takes ${RETRO_SOURCES.join(", ")} (comma-separated), not "${n}"`);
  if (names.length === 0)
    throw new UsageError("a retro reads at least one source: nothing to look back at without one");
  return RETRO_SOURCES.filter((x) => names.includes(x));
}
async function start(c) {
  const s = await scopeOf(c);
  const chosen = sourcesOf(c);
  const reviews = chosen.includes("reviews");
  if (reviews && s.history.threads === 0)
    throw new Error(
      "no thread in this period: leave the reviews out of the sources (--sources " + (chosen.filter((x) => x !== "reviews").join(",") || "sessions,audit") + ")"
    );
  await prepareStoreHome(s.home);
  const r = await new RetroBook(s.home).start({
    root: s.root,
    since: s.since,
    until: s.until,
    stores: reviews ? s.history.stores.filter((st) => st.threads.length > 0).map((st) => ({ root: st.root, origin: st.origin, threads: st.threads.length, bytes: st.bytes })) : [],
    threads: reviews ? s.history.stores.flatMap((st) => st.threads.map((t) => t.id)) : [],
    bytes: reviews ? s.history.bytes : 0,
    sessionsMode: (await readConfig(c.io.env)).retroSessions,
    sources: chosen
  });
  return out(
    c,
    r,
    () => `Retro ${r.id} started: ` + (reviews ? `${r.threads.length} threads, ${formatBytes(r.bytes)}` : "no review thread (reviews left out)") + `, ${day(r.since)} to ${day(r.until)}. Sources: ${r.sources.join(", ")}.`
  );
}
function needsSource(r, source, what) {
  if (!r.sources.includes(source))
    throw new Error(
      `retro ${r.id} does not read ${SOURCE_NAME[source].toLowerCase()} (its sources: ${r.sources.join(", ")}): no ${what}`
    );
}
async function feedback(c) {
  const { book: b, retro: r } = await retroOf(c);
  await b.record(r.id, [{ type: "retro.feedback", body: (await body(c)).trim() }]);
  c.io.out(`Feedback recorded in ${r.id}.`);
  return 0;
}
var INPUT_KINDS = ["classify", "analysis", ...FINDING_SOURCES];
async function analysisContext(c, b, r) {
  const { threads } = await retroThreads(r, c.io.env);
  const previous = (await b.list()).filter((x) => x.id !== r.id && x.startedAt < r.startedAt);
  const sessions2 = await retroSessions(b, r);
  const reports = await retroReports(b, r);
  return {
    retro: r,
    threads,
    previous,
    preferences: await b.preferences(),
    sessions: sessions2,
    ...reports.length ? { reports: { list: reports, dir: reportsDir(b) } } : {}
  };
}
async function auditReport(b, r) {
  const file = (0, import_node_path21.join)(await b.workDir(r.id), AUDIT_FILE);
  try {
    return { file, text: await (0, import_promises17.readFile)(file, "utf8") };
  } catch {
    return null;
  }
}
async function sourceInputOf(b, r, ctx, source) {
  const audit = source === "audit" ? await auditReport(b, r) : null;
  return sourceInput(ctx, source, { audit: audit?.text ?? null, usage: r.usage });
}
async function input(c) {
  const { book: b, retro: r } = await retroOf(c);
  const kind = str(c.values.for);
  if (!INPUT_KINDS.includes(kind)) throw new UsageError(`--for must be one of ${INPUT_KINDS.join(", ")}`);
  if (kind === "classify" || kind === "threads") needsSource(r, "reviews", "reading of the threads");
  if (kind === "sessions") needsSource(r, "sessions", "reading of the sessions");
  if (kind === "audit") needsSource(r, "audit", "reading of the audit");
  const { threads } = await retroThreads(r, c.io.env);
  const missing = r.threads.filter((id) => !threads.has(id));
  let content;
  let sessions2 = [];
  let reports = [];
  const bySource = Object.keys(r.findings).length > 0;
  if (kind === "classify") content = classifyInput(r, threads);
  else {
    const ctx = await analysisContext(c, b, r);
    sessions2 = ctx.sessions;
    reports = ctx.reports?.list ?? [];
    if (kind !== "analysis") content = await sourceInputOf(b, r, ctx, kind);
    else if (!bySource) content = analysisInput(ctx);
    else {
      const files = {};
      for (const source of FINDING_SOURCES)
        if (r.findings[source])
          files[source] = await writeRetroFile(b, r.id, `${source}-input.md`, await sourceInputOf(b, r, ctx, source));
      content = arbiterInput(ctx, r.findings, files, r.usage);
    }
  }
  const file = await writeRetroFile(b, r.id, `${kind}-input.md`, content);
  const lines = content.split("\n").length;
  const answer = (0, import_node_path21.join)(
    (0, import_node_path21.dirname)(file),
    kind === "classify" ? "labels.json" : kind === "analysis" ? "proposals.json" : `findings-${kind}.json`
  );
  const root = `--root ${quote(c.root)}`;
  const next = kind === "classify" ? `slk retro classification ${r.id} ${root} --by <your name> --body-file ${quote(answer)}` : kind === "analysis" ? `slk retro check ${r.id} ${root} --body-file ${quote(answer)}, then slk retro propose with the same arguments` : `slk retro findings ${r.id} ${root} --source ${kind} --body-file ${quote(answer)}`;
  const shown = kind === "analysis" && bySource ? [`the findings of ${andList(FINDING_SOURCES.filter((x) => r.findings[x]).map((x) => SOURCE_TITLE[x]))}`] : [
    ...kind === "classify" || kind === "analysis" || kind === "threads" ? [`${threads.size} threads`] : [],
    ...kind === "analysis" || kind === "sessions" ? [
      ...sessions2.length ? [`${sessions2.length} session${sessions2.length === 1 ? "" : "s"} of the agent`] : [],
      ...reports.length ? [`${reports.length} report${reports.length === 1 ? "" : "s"} on its sessions`] : []
    ] : [],
    ...kind === "audit" ? ["the audit of the setup and the usage of its tools"] : []
  ];
  return out(
    c,
    {
      file,
      lines,
      bytes: Buffer.byteLength(content),
      threads: threads.size,
      sessions: sessions2.length,
      reports: reports.length,
      missing,
      answer,
      next
    },
    () => [
      `Written: ${file}`,
      `${andList(shown) || "nothing to read"}, ${lines} lines, ${formatBytes(Buffer.byteLength(content))}. Read it all (in parts if needed).`,
      ...missing.length ? [`${missing.length} thread(s) of the retro are no longer found: ${missing.join(", ")}`] : [],
      `Then write your JSON in ${answer} and run: ${next}`
    ].join("\n")
  );
}
async function findings(c) {
  const { book: b, retro: r } = await retroOf(c);
  const source = str(c.values.source);
  if (!FINDING_SOURCES.includes(source)) throw new UsageError(`--source must be one of ${FINDING_SOURCES.join(", ")}`);
  needsSource(r, source === "threads" ? "reviews" : source, "findings to record from it");
  const result = checkFindings(parseJson(await body(c)), source, await guardContext(c, b, r));
  const rejected = result.rejected.length > 0;
  if (!rejected)
    await b.record(r.id, [
      {
        type: "retro.findings",
        source,
        findings: result.findings,
        ...result.verifications ? { verifications: result.verifications } : {},
        ...result.overview ? { overview: result.overview } : {}
      }
    ]);
  if (c.json) {
    c.io.out(JSON.stringify({ recorded: !rejected, ...result }, null, 2));
    return rejected ? 1 : 0;
  }
  const lines = [
    rejected ? `${result.rejected.length} finding(s) rejected: fix them, nothing was recorded.` : `Recorded: ${result.findings.length} finding(s) from ${SOURCE_TITLE[source]}` + (result.verifications ? `, ${result.verifications.length} change(s) of the last retro checked` : "") + (result.overview ? `, an overview of ${result.overview.items.length} item(s)` : "") + ".",
    ...result.rejected.map((x) => `- REJECTED ${x.index ? `#${x.index} ` : ""}${x.subject}: ${x.reasons.join("; ")}`),
    ...(result.verifications ?? []).map((v) => `- ${verificationLine(v)}`),
    ...result.notes.map((n) => `  note: ${n}`)
  ];
  c.io.out(lines.join("\n"));
  return rejected ? 1 : 0;
}
async function retroSessions(b, r) {
  if (!r.sessions || r.sessionsMode === "reports" || !r.sources.includes("sessions")) return [];
  const listed = new Set(r.sessions.list.map((x) => x.id));
  return (await readRetroSessions(b, r.id)).filter((x) => listed.has(x.id));
}
var andList = (xs) => xs.length <= 1 ? xs[0] ?? "" : `${xs.slice(0, -1).join(", ")} and ${xs.at(-1)}`;
async function retroReports(b, r) {
  if (r.sessionsMode === "insights" || !r.sources.includes("sessions")) return [];
  const ids = (r.reports?.list ?? []).filter(reportRead).map((x) => x.id);
  const found = await Promise.all(ids.map((id) => readSessionReport(b, id)));
  return found.filter((x) => x !== null);
}
async function guardSessions(b, r) {
  const out2 = /* @__PURE__ */ new Map();
  for (const x of await retroSessions(b, r)) out2.set(x.id, { start: x.start, summary: x.summary });
  for (const rep of await retroReports(b, r)) {
    const summary = typeof rep.analysis.summary === "string" ? rep.analysis.summary : "";
    out2.set(rep.session, {
      start: out2.get(rep.session)?.start ?? rep.start,
      summary: out2.get(rep.session)?.summary ?? null,
      report: { text: reportText(rep), moments: reportMoments(rep), summary: firstSentence(summary) }
    });
  }
  return out2;
}
var firstSentence = (text) => (/^.*?[.!?](?=\s|$)/s.exec(text.trim())?.[0] ?? text.trim()).slice(0, 300);
var sessionLine = (e) => `session ${e.session.slice(0, 8)} (${day(e.start)})${e.excerpt ? `: "${e.excerpt}"` : ", facts only"}` + (e.moments?.length ? ` (moment${e.moments.length === 1 ? "" : "s"} ${e.moments.map((m) => m.slice(0, 8)).join(", ")})` : "");
function sourceOf(p, audit) {
  const f = p.figures;
  const n = p.sessions?.length ?? 0;
  const parts = [
    ...f.threads > 0 || n === 0 && !p.audit ? [`${f.threads} thread${f.threads === 1 ? "" : "s"}`] : [],
    ...n ? [`${n} session${n === 1 ? "" : "s"} of the agent`] : []
  ];
  if (parts.length === 0) return audit;
  return parts.join(" and ") + (p.audit ? `, and ${audit}` : "");
}
var SESSIONS_ONLY = "only the agent's sessions: summaries written by a model, not your own words (no review thread)";
var threadOf = (x) => {
  const t = x?.thread;
  return typeof t === "string" ? t : "";
};
function labelsOf(data, known) {
  const raw = data?.labels ?? data;
  const entries = Array.isArray(raw) ? raw.map((x) => [threadOf(x), x]) : typeof raw === "object" && raw !== null ? Object.entries(raw) : [];
  const labels = {};
  const problems = [];
  const score = (x) => typeof x === "number" && x >= 0 && x <= 1 ? x : void 0;
  for (const [thread, x] of entries) {
    const l = x;
    const category = Number(l?.category);
    if (!known.has(thread)) problems.push(`${thread || "(no thread)"}: not a thread of this retro`);
    else if (!FEEDBACK_CATEGORIES[category]) problems.push(`${thread}: category must be 1 to 14`);
    else {
      const label2 = { category };
      const conf = score(l.confidence);
      const missing = score(l.missingRule);
      const ignored = score(l.ignoredRule);
      if (conf !== void 0) label2.confidence = conf;
      if (missing !== void 0) label2.missingRule = missing;
      if (ignored !== void 0) label2.ignoredRule = ignored;
      labels[thread] = label2;
    }
  }
  return { labels, problems };
}
async function classification(c) {
  const { book: b, retro: r } = await retroOf(c);
  const by = str(c.values.by)?.trim();
  if (!by) throw new UsageError("say who classified with --by <name> (e.g. jev, haiku)");
  needsSource(r, "reviews", "classification");
  const { labels, problems } = labelsOf(parseJson(await body(c)), new Set(r.threads));
  if (Object.keys(labels).length === 0)
    throw new Error(`no valid label${problems.length ? `: ${problems.join("; ")}` : ""}`);
  const after = await b.record(r.id, [{ type: "retro.classified", by, labels }]);
  const done = Object.keys(after.classification?.labels ?? {}).length;
  c.io.out(
    [
      `Recorded ${Object.keys(labels).length} labels (${done}/${r.threads.length} threads classified).`,
      ...problems.map((p) => `Skipped ${p}`)
    ].join("\n")
  );
  return 0;
}
async function guardContext(c, b, r) {
  const { threads } = await retroThreads(r, c.io.env);
  const previous = (await b.list()).filter((x) => x.id !== r.id && x.startedAt < r.startedAt);
  return {
    threads: new Map([...threads].map(([id, x]) => [id, x.thread])),
    labels: r.classification?.labels ?? {},
    exclusions: exclusionsOf(previous),
    adopted: changesToVerify(r, previous),
    sessions: await guardSessions(b, r),
    ...r.usage ? { usage: { ...r.usage, root: r.root, ...c.io.env.HOME ? { home: c.io.env.HOME } : {} } } : {}
  };
}
function withFindings(input2, r) {
  if (typeof input2 !== "object" || input2 === null || Array.isArray(input2)) return input2;
  const x = { ...input2 };
  const checked = [...r.findings.threads?.verifications ?? [], ...r.findings.sessions?.verifications ?? []];
  if (x.verify === void 0 && checked.length) {
    const merged = /* @__PURE__ */ new Map();
    for (const v of checked) {
      const ref = changeRef(v);
      const m = merged.get(ref) ?? { change: ref, notes: [] };
      if (v.measured?.includes("sessions")) m.sessions = v.afterSessions?.ids ?? [];
      else m.threads = v.after.ids;
      if (v.note) m.notes.push(v.note);
      merged.set(ref, m);
    }
    x.verify = [...merged.values()].map(({ notes, ...m }) => ({
      ...m,
      ...notes.length ? { note: notes.join(" ") } : {}
    }));
  }
  if (x.overview === void 0 && r.findings.sessions?.overview) x.overview = r.findings.sessions.overview;
  return x;
}
async function check(c, record) {
  const { book: b, retro: r } = await retroOf(c);
  const result = checkProposals(withFindings(parseJson(await body(c)), r), await guardContext(c, b, r));
  const rejected = result.rejected.length > 0;
  if (record && !rejected)
    await b.record(r.id, [
      {
        type: "retro.proposed",
        proposals: result.proposals,
        watch: result.watch,
        dropped: result.dropped,
        ...result.verifications.length ? { verifications: result.verifications } : {},
        ...result.overview ? { overview: result.overview } : {}
      }
    ]);
  if (c.json) c.io.out(JSON.stringify({ recorded: record && !rejected, ...result }, null, 2));
  else c.io.out(renderGuards(result, record && !rejected, record));
  return rejected ? 1 : 0;
}
function renderGuards(g, recorded, record) {
  const lines = [
    recorded ? `Recorded: ${g.proposals.length} proposals, ${g.watch.length} to watch, ${g.dropped.length} left out.` : g.rejected.length ? `${g.rejected.length} proposal(s) rejected: fix them${record ? ", nothing was recorded" : ""}.` : `The guard rails pass: ${g.proposals.length} proposals, ${g.watch.length} to watch, ${g.dropped.length} left out.`
  ];
  for (const x of g.rejected)
    lines.push(`- REJECTED ${x.index ? `#${x.index} ` : ""}${x.subject}: ${x.reasons.join("; ")}`);
  for (const v of g.verifications) lines.push(`- ${verificationLine(v)}`);
  for (const p of g.proposals)
    lines.push(
      `- ${p.id} [${p.column}] ${p.subject}: ${p.figures.threads} threads` + (p.sessions?.length ? ` and ${p.sessions.length} session${p.sessions.length === 1 ? "" : "s"}${p.sessionsOnly ? " (sessions only)" : ""}` : "") + (p.askTarget ? ", target to ask" : "") + (p.convertedFromKeep ? ", turned from keep into improve" : "") + (p.reopens ? `, reopens ${p.reopens.retro}/${p.reopens.proposal}` : "") + (p.revisits ? `, revises ${changeRef(p.revisits)}` : "") + (p.unused ? `, ${TOOL_TITLE[p.unused.kind]} never used: keep it or remove it?` : "")
    );
  for (const w of g.watch) lines.push(`- ${w.id} [watch] ${w.subject}`);
  if (g.overview) lines.push(`- overview of the sessions: ${g.overview.items.length} item(s)`);
  for (const d of g.dropped) lines.push(`- left out: ${d.subject} (${d.reason})`);
  for (const n of g.notes) lines.push(`  note: ${n}`);
  return lines.join("\n");
}
var VERDICT = {
  stopped: "stopped: kept",
  decreased: "decreased: kept",
  "not-decreased": "not decreased: to revise",
  "not-measured": "not measured: no data in this period from the sources it rested on"
};
function verificationLine(v) {
  const ids = [...v.after.ids, ...v.afterSessions?.ids.map((x) => x.slice(0, 8)) ?? []];
  const numbers = measureText(v);
  return `${changeRef(v)} ${v.title}: ${numbers ? `${numbers} \u2192 ` : ""}${VERDICT[v.verdict]}` + (ids.length ? ` (${ids.join(", ")})` : "");
}
var COLUMN_TITLE = { keep: "To keep", remove: "To remove", improve: "To improve" };
var TARGET_TITLE = {
  "project-shared": "project, shared (committed, for the team)",
  "project-personal": "project, personal (yours, not committed)",
  user: "you, in every project"
};
function where3(t) {
  if (!t) return "";
  const a = t.anchor;
  return a.range ? ` (${a.path}:${a.range.startLine}, ${t.state})` : ` (${a.path}, ${t.state})`;
}
function renderProposal(p, r, threads) {
  const f = p.figures;
  const d = r.decisions[p.id];
  const lines = [
    `### ${p.id} \xB7 ${COLUMN_TITLE[p.column]} \xB7 ${p.title}`,
    "",
    `- **Source**: ${sourceOf(p, "the audit of the setup")}` + (p.sessionsOnly ? ` (${SESSIONS_ONLY})` : ""),
    ...p.evidence.map(
      (e) => `  - ${e.thread}${where3(threads.get(e.thread)?.thread)}${e.excerpt ? `: "${e.excerpt}"` : ""}`
    ),
    ...(p.sessions ?? []).map((e) => `  - ${sessionLine(e)}`),
    ...p.audit ? [`  - ${AUDIT_NAME}, ${p.audit.location}: ${p.audit.finding}`] : [],
    ...f.threads > 0 ? [
      `- **Numbers**: ${f.threads} threads${p.sessions?.length ? ` and ${p.sessions.length} session${p.sessions.length === 1 ? "" : "s"}` : ""}, ${f.reopened} reopened, ${f.questions} with a question from the agent, ${f.rounds} round(s) of back-and-forth, from ${day(f.first)} to ${day(f.last)}`
    ] : [],
    `- **File**: ${p.file}` + (p.rule ? `
- **Rule**: ${p.rule}` : ""),
    `- **Why**: ${p.why}`
  ];
  if (p.change) lines.push(`- **Change** (${p.kind}): ${p.change}`);
  lines.push(
    p.askTarget ? `- **Target**: to ask the user (nothing in the threads tells it; suggested: ${TARGET_TITLE[p.target]}${p.targetWhy ? `, ${p.targetWhy}` : ""})` : `- **Target**: ${TARGET_TITLE[p.target]}${p.targetWhy ? `, because ${p.targetWhy}` : ""}`,
    `- **Confidence**: ${Math.round(p.confidence * 100)}% \xB7 recommended: ${p.recommendation}`
  );
  if (p.convertedFromKeep)
    lines.push(
      `- **Guard rail**: proposed as "keep", but you had to enforce the rule in ${p.convertedFromKeep.threads.join(", ")}`
    );
  if (p.reopens)
    lines.push(
      `- **Excluded before** (${day(p.reopens.at)}), back for new threads: ${p.reopens.newThreads.join(", ")}`
    );
  if (p.revisits)
    lines.push(
      `- **Revises** ${changeRef(p.revisits)}, adopted at the last retro: the feedback on its subject did not decrease`
    );
  if (p.unused) lines.push(`- **Never used**: ${unusedText(p.unused)}`);
  if (p.unused?.fix) lines.push(`- **Fix, if kept**: ${p.unused.fix}`);
  if (d) lines.push(`- **Decision**: ${d.decision}${d.target ? ` (${d.target})` : ""}${d.note ? `: ${d.note}` : ""}`);
  const files = r.applied[p.id];
  if (files?.length) lines.push(`- **Changed**: ${files.join(", ")}`);
  return lines.join("\n");
}
function unusedText(u) {
  const where4 = u.scope === "project" ? `in the ${u.sessions} session${u.sessions === 1 ? "" : "s"} of this project` : `in the ${u.sessions} session${u.sessions === 1 ? "" : "s"} of every project (it is in your own setup)`;
  return `the audit flagged the ${TOOL_TITLE[u.kind]} ${u.name}, but nobody used it ${where4} that the agent still keeps on this machine` + (u.since ? ` (since ${day(u.since).slice(0, 10)})` : "") + `. Limits: only this machine (a ${TOOL_TITLE[u.kind]} shared in the repository may serve your team), and the agent deletes the sessions inactive for more than ${u.keptDays} days.`;
}
var AUDIT_NAME = "/doctor prompt-audit";
var DISCUSSION = ["improve", "remove", "keep"];
var blockquote = (text) => text.split("\n").map((l) => l.trim() ? `> ${l}` : ">").join("\n");
function presentProposal(p, position, total, r, threads) {
  const f = p.figures;
  const d = r.decisions[p.id];
  const source = sourceOf(p, `the audit of your setup (${AUDIT_NAME})`) + (p.sessionsOnly ? `. **Note**: ${SESSIONS_ONLY}` : "");
  const lines = [
    "---",
    "",
    `## Proposal ${position}/${total} (${p.id}) \xB7 ${COLUMN_TITLE[p.column]} \xB7 ${p.title}`,
    "",
    `**Source**: ${source}`,
    ...p.evidence.map(
      (e) => `- ${e.thread}${where3(threads.get(e.thread)?.thread)}${e.excerpt ? `: "${e.excerpt}"` : ""}`
    ),
    ...(p.sessions ?? []).map((e) => `- ${sessionLine(e)}`),
    ...p.audit ? [`- ${AUDIT_NAME}, \`${p.audit.location}\`: ${p.audit.finding}`] : [],
    ""
  ];
  if (f.threads > 0)
    lines.push(
      `**Numbers**: ${f.threads} threads, ${f.reopened} reopened, ${f.questions} with a question from the agent, ${f.rounds} round(s) of back-and-forth, from ${day(f.first)} to ${day(f.last)}.`,
      ""
    );
  lines.push(`**File**: \`${p.file}\` (${p.kind})`, "");
  if (p.rule) lines.push("**Existing rule**:", blockquote(p.rule), "");
  lines.push(`**Why**: ${p.why}`, "");
  if (p.change) lines.push("**Proposed change**:", blockquote(p.change), "");
  lines.push(
    p.askTarget ? `**Target**: to choose (nothing in the threads tells it). Suggested: ${TARGET_TITLE[p.target]}${p.targetWhy ? `, ${p.targetWhy}` : ""}.` : `**Target**: ${TARGET_TITLE[p.target]}${p.targetWhy ? `, because ${p.targetWhy}` : ""}.`,
    "",
    `**Confidence**: ${Math.round(p.confidence * 100)}% \xB7 recommended: ${p.recommendation}`
  );
  if (p.convertedFromKeep)
    lines.push(
      "",
      `**Guard rail**: proposed as "keep", but you had to enforce the rule in ${p.convertedFromKeep.threads.join(", ")}.`
    );
  if (p.reopens)
    lines.push(
      "",
      `**Excluded before** (${day(p.reopens.at)}), back for new threads: ${p.reopens.newThreads.join(", ")}.`
    );
  if (p.revisits)
    lines.push(
      "",
      `**Revises** ${changeRef(p.revisits)}, adopted at the last retro: the feedback on its subject did not decrease.`
    );
  if (p.unused)
    lines.push(
      "",
      `**Never used**: ${unusedText(p.unused)}`,
      "",
      `**The question**: keep this ${TOOL_TITLE[p.unused.kind]}${p.unused.fix ? " (and fix it)" : ""}, or remove it?`,
      ...p.unused.fix ? ["", "**The fix, if you keep it**:", blockquote(p.unused.fix)] : []
    );
  if (d) lines.push("", `**Decision**: ${d.decision}${d.target ? ` (${d.target})` : ""}${d.note ? `: ${d.note}` : ""}`);
  return lines.join("\n");
}
async function showOne(c, r) {
  const order = [
    ...r.proposals.filter((p2) => p2.revisits),
    ...DISCUSSION.flatMap((col) => r.proposals.filter((p2) => p2.column === col && !p2.revisits))
  ];
  const wanted = c.positionals[1];
  const p = wanted ? order.find((x) => x.id === wanted) : order.find((x) => !r.decisions[x.id]);
  if (!p) {
    if (wanted) throw new Error(`Proposal not found: ${wanted} (slk retro show ${r.id})`);
    c.io.out(order.length ? `All ${order.length} proposals are decided.` : "No proposal recorded yet.");
    return 0;
  }
  const position = order.indexOf(p) + 1;
  if (c.json) {
    c.io.out(
      JSON.stringify({ position, total: order.length, proposal: p, decision: r.decisions[p.id] ?? null }, null, 2)
    );
    return 0;
  }
  const { threads } = await retroThreads(r, c.io.env);
  c.io.out(presentProposal(p, position, order.length, r, threads));
  return 0;
}
async function show(c) {
  const { retro: r } = await retroOf(c);
  if (c.positionals[1] || c.values.next) return showOne(c, r);
  const { threads } = await retroThreads(r, c.io.env);
  if (c.json) {
    c.io.out(
      JSON.stringify(
        {
          ...r,
          stats: statsOf({ retro: r, threads }),
          classification: r.classification ? { by: r.classification.by, threads: Object.keys(r.classification.labels).length } : null
        },
        null,
        2
      )
    );
    return 0;
  }
  const lines = [
    `# Retro ${r.id} \u2014 ${r.root}`,
    "",
    `${day(r.since)} to ${day(r.until)} \xB7 ${r.threads.length} threads \xB7 ${formatBytes(r.bytes)}` + (!r.sources.includes("reviews") ? "" : r.classification ? ` \xB7 classified by ${r.classification.by.join(", ")}` : " \xB7 not classified") + (r.finishedAt ? ` \xB7 finished ${day(r.finishedAt)}` : ""),
    "",
    `Sources: ${RETRO_SOURCES.map((x) => `${SOURCE_NAME[x]}: ${r.sources.includes(x) ? "read" : "not read"}`).join(" \xB7 ")}.`
  ];
  if (r.sessions) {
    const fromSessions = r.proposals.filter((p) => p.sessions?.length).length;
    const withSummary = r.sessions.list.filter((x) => x.summary).length;
    lines.push(
      "",
      `The agent's sessions: ${r.sessions.list.length} in this project and period, ${withSummary} with a summary; ${fromSessions} proposal${fromSessions === 1 ? "" : "s"} rest${fromSessions === 1 ? "s" : ""} on them.`
    );
  }
  if (r.reports) lines.push("", reportsLine(r));
  if (r.preferences.length) lines.push("", "Preferences: " + r.preferences.map((p) => `${p.id} ${p.body}`).join(" \xB7 "));
  if (r.overview) lines.push("", ...renderOverview(r.overview));
  if (r.verifications.length || r.feedback.length) {
    lines.push("", "## The last retro's changes: did they help?", "");
    for (const f of r.feedback) lines.push(`- **What you said about them**: ${f}`);
    for (const v of r.verifications) {
      lines.push(`- ${verificationLine(v)}`);
      if (v.note) lines.push(`  ${v.note}`);
    }
  }
  if (r.proposals.length === 0 && r.watch.length === 0) lines.push("", "No proposal recorded yet.");
  for (const col of COLUMNS) {
    const ps = r.proposals.filter((p) => p.column === col);
    if (ps.length === 0) continue;
    lines.push("", `## ${COLUMN_TITLE[col]}`, "");
    for (const p of ps) lines.push(renderProposal(p, r, threads), "");
  }
  if (r.watch.length) {
    lines.push("", "## To watch (seen in a single thread or session)", "");
    for (const w of r.watch)
      lines.push(
        `- ${w.id} ${w.subject}: ${w.why} (${[
          ...w.evidence.map((e) => e.thread + (e.excerpt ? `: "${e.excerpt}"` : "")),
          ...(w.sessions ?? []).map(sessionLine)
        ].join("; ")})`
      );
  }
  const conversations = Object.entries(r.conversations);
  if (conversations.length) {
    lines.push("", "## The agent's conversations read back", "");
    for (const [thread, c2] of conversations)
      lines.push(
        `- ${thread}: ${c2.available ? "read back" : "no longer available on this machine, analysed without it"}`
      );
  }
  if (r.dropped.length) {
    lines.push("", "## Left out by the guard rails", "");
    for (const d of r.dropped) lines.push(`- ${d.subject}: ${d.reason}`);
  }
  c.io.out(lines.join("\n").trimEnd());
  return 0;
}
function reportsLine(r) {
  const list3 = r.reports?.list ?? [];
  const n = (status2) => list3.filter((x) => x.status === status2).length;
  const ok = n("analysed") + n("reused");
  const fromReports = r.proposals.filter((p) => p.sessions?.some((s) => s.moments?.length)).length;
  return `Reports on the agent's sessions: ${ok} (${n("analysed")} written for this retro, ${n("reused")} kept from before)` + (n("failed") ? `, ${n("failed")} could not be written` : "") + (n("excluded") ? `, ${n("excluded")} left out (too long to analyse)` : "") + (r.proposals.length ? `; ${fromReports} proposal${fromReports === 1 ? "" : "s"} point${fromReports === 1 ? "s" : ""} at moments of them.` : ".");
}
var OVERVIEW_TITLE = { pattern: "Pattern", friction: "Friction", ritual: "Ritual" };
function renderOverview(o) {
  return [
    "## Your sessions with the agent: what recurs",
    "",
    ...o.summary ? [o.summary, ""] : [],
    ...o.items.map(
      (i) => `- **${OVERVIEW_TITLE[i.kind]}: ${i.title}** (${i.sessions.length} session${i.sessions.length === 1 ? "" : "s"}: ${i.sessions.map((s) => s.slice(0, 8)).join(", ")}). ${i.description}` + (i.idea ? ` Lead: ${i.idea}` : "")
    )
  ];
}
var DECISION_ALIASES = {
  accept: "accepted",
  modify: "modified",
  exclude: "excluded",
  retarget: "retargeted"
};
async function decide(c) {
  const { book: b, retro: r } = await retroOf(c);
  const [, proposal, word] = c.positionals;
  const p = r.proposals.find((x) => x.id === proposal);
  if (!p) throw new Error(`Proposal not found: ${proposal ?? "(none)"} (slk retro show ${r.id})`);
  const decision = DECISION_ALIASES[word ?? ""] ?? word;
  if (!DECISIONS.includes(decision)) throw new UsageError(`the decision must be one of ${DECISIONS.join(", ")}`);
  const target = str(c.values.target);
  if (target !== void 0 && !TARGETS.includes(target))
    throw new UsageError(`--target must be one of ${TARGETS.join(", ")}`);
  if (decision === "retargeted" && !target) throw new UsageError("retargeted needs --target");
  const note = str(c.values.note)?.trim();
  await b.record(r.id, [
    { type: "retro.decided", proposal: p.id, decision, ...target ? { target } : {}, ...note ? { note } : {} }
  ]);
  c.io.out(`${p.id} ${decision}${target ? ` (${target})` : ""}.`);
  return 0;
}
async function undo(c) {
  const { book: b, retro: r } = await retroOf(c);
  const proposal = c.positionals[1];
  const p = r.proposals.find((x) => x.id === proposal);
  if (!p) throw new Error(`Proposal not found: ${proposal ?? "(none)"} (slk retro show ${r.id})`);
  if (r.finishedAt) throw new Error(`Retro ${r.id} is finished`);
  const d = r.decisions[p.id];
  if (!d) throw new Error(`${p.id} has no decision to undo`);
  const files = r.applied[p.id] ?? [];
  await b.record(r.id, [{ type: "retro.undone", proposal: p.id }]);
  c.io.out(
    `${p.id}: decision "${d.decision}" undone` + (files.length ? `, and its files changed forgotten (${files.join(", ")}): undo those changes if they were not for it.` : ".")
  );
  return 0;
}
async function applied(c) {
  const { book: b, retro: r } = await retroOf(c);
  const proposal = c.positionals[1];
  const p = r.proposals.find((x) => x.id === proposal);
  if (!p) throw new Error(`Proposal not found: ${proposal ?? "(none)"}`);
  const d = r.decisions[p.id];
  if (!d || d.decision === "excluded") throw new Error(`${p.id} was not accepted: decide it first (slk retro decide)`);
  const files = (Array.isArray(c.values.file) ? c.values.file : []).map((f) => (0, import_node_path21.resolve)(c.io.cwd, f));
  if (files.length === 0) throw new UsageError("say which files changed with --file <path>");
  await b.record(r.id, [{ type: "retro.applied", proposal: p.id, files }]);
  c.io.out(`${p.id}: ${files.length} file(s) recorded.`);
  return 0;
}
async function finish(c) {
  const { book: b, retro: r } = await retroOf(c);
  const done = await b.record(r.id, [{ type: "retro.finished" }]);
  const files = [...new Set(Object.values(done.applied).flat())].sort();
  const count = (d) => Object.values(done.decisions).filter((x) => x.decision === d).length;
  const undecided = done.proposals.filter((p) => !done.decisions[p.id]).map((p) => p.id);
  return out(
    c,
    { id: done.id, files, decisions: done.decisions, undecided, watch: done.watch },
    () => [
      `Retro ${done.id} finished: ${count("accepted")} accepted, ${count("modified")} modified, ${count("retargeted")} with another target, ${count("excluded")} excluded` + (undecided.length ? `, ${undecided.length} without a decision (${undecided.join(", ")})` : "") + ".",
      "",
      files.length ? `Files changed (${files.length}):` : "No file changed.",
      ...files.map((f) => `- ${f}`),
      ...done.watch.length ? ["", "To watch:", ...done.watch.map((w) => `- ${w.subject}`)] : [],
      ...sessionsCost(done),
      ...reportsCost(done)
    ].join("\n")
  );
}
function sessionsCost(r) {
  const s = r.sessions;
  if (!s || s.costUsd === null && s.durationMs === null) return [];
  const time = s.durationMs === null ? "" : ` took ${Math.max(1, Math.round(s.durationMs / 6e4))} min`;
  const cost = s.costUsd === null ? "" : ` and about $${s.costUsd.toFixed(2)} at the API list price (on a subscription, tokens counted against your usage limits, not a bill)`;
  return ["", `Reading the agent's sessions (${s.source})${time}${cost}.`];
}
function reportsCost(r) {
  const s = r.reports;
  if (!s) return [];
  const written = s.list.filter((x) => x.status === "analysed").length;
  const reused = s.list.filter((x) => x.status === "reused").length;
  const time = s.durationMs === null ? "" : `, in ${Math.max(1, Math.round(s.durationMs / 6e4))} min`;
  const tokens = s.tokens === null ? "" : `, ${formatTokens(s.tokens)} tokens`;
  const cost = s.costUsd === null ? "" : `, about $${s.costUsd.toFixed(2)} at the API list price (on a subscription, tokens counted against your usage limits, not a bill)`;
  return [
    "",
    `Reports on the agent's sessions: ${written} written${reused ? ` (${reused} kept from earlier retros, at no cost)` : ""}${written ? `${time}${tokens}${cost}` : ""}.`
  ];
}
var formatTokens = (n) => n >= 1e6 ? `${(n / 1e6).toFixed(1)} M` : n >= 1e3 ? `${Math.round(n / 1e3)} k` : String(n);
async function list(c) {
  const all = await (await book(c)).list();
  return out(
    c,
    all.map((r) => ({
      id: r.id,
      root: r.root,
      since: r.since,
      until: r.until,
      threads: r.threads.length,
      proposals: r.proposals.length,
      finishedAt: r.finishedAt
    })),
    () => all.length === 0 ? "No retro yet in this project." : all.map(
      (r) => `${r.id} \xB7 ${r.root} \xB7 ${day(r.since)} to ${day(r.until)} \xB7 ${r.threads.length} threads \xB7 ${r.proposals.length} proposals \xB7 ${r.finishedAt ? "finished" : "unfinished"}`
    ).join("\n")
  );
}
async function prefs(c) {
  const b = await book(c);
  const [verb, id] = c.positionals;
  if (verb === "add") {
    await prepareStoreHome(b.home);
    const p = await b.addPreference(await body(c));
    c.io.out(`Preference ${p.id} saved: ${p.body}`);
    return 0;
  }
  if (verb === "remove") {
    if (!id) throw new UsageError("missing <preference-id>");
    await b.removePreference(id);
    c.io.out(`Preference ${id} removed.`);
    return 0;
  }
  if (verb !== void 0) throw new UsageError(`unknown prefs action: ${verb}`);
  const all = await b.preferences();
  return out(c, all, () => all.length ? all.map((p) => `${p.id}: ${p.body}`).join("\n") : "No retro preference yet.");
}
async function key(c) {
  const s = await jevKeyStatus(c.io.env);
  const setup = jevKeySetupCommand();
  return out(c, { ...s, setupCommand: setup }, () => {
    if (s.source === "env") return "Jev: the key comes from $JEV_API_KEY. Ready.";
    if (!s.exists)
      return [
        `Jev: no key (expected in ${s.path}). The classification will use a small model instead.`,
        "To add one, the user runs this in their own terminal, not through the agent (it asks for the key without showing it):",
        "",
        `  ${setup}`
      ].join("\n");
    return s.ok ? `Jev: key file ${s.path} (mode ${s.mode}, only you can read it, in no repository). Ready.` : [
      `Jev: key file ${s.path} is not safe yet${s.private ? "" : ` (mode ${s.mode}: others can read it)`}${s.inRepo ? ` (inside the repository ${s.inRepo})` : ""}.`,
      "Fix:",
      ...s.fixes.map((f) => `  ${f}`)
    ].join("\n");
  });
}
async function cadence(c) {
  const cad = await retroCadence(c.root, { env: c.io.env });
  if (!cad) throw new UsageError("a retro is about a project folder, not the root of the file system");
  return out(c, cad, () => {
    const t = cad.thresholds;
    return [
      cad.due ? `A retro is due: ${cadenceSummary(cad)}.` : `No retro due yet: ${cadenceSummary(cad)}.`,
      ...dueReasons(cad).map((r) => `- ${r}`),
      `Reminder settings (slk config): ${t.days} days, or ${formatBytes(t.bytes)} of threads, and never more than ${t.maxDays} days.`
    ].join("\n");
  });
}

// src/cli.ts
var EXIT = { OK: 0, ERROR: 1, NOT_FOUND: 2, CHANGED: 3 };
var ChangedError = class extends Error {
};
var USAGE = `slk \u2014 silykat, for agents

Usage: slk <module> <command> \u2026 (modules: review, retro), or slk <command> \u2026 for what they share.

Review (the comment threads of the project):
  slk review status                       How many threads wait for you
  slk review list [--all] [--thread <id>]\u2026 [--any-topic] [--format md|json]
                                          Threads waiting for you (--all: every unresolved thread;
                                          --thread: only those threads). In an agent session, only
                                          the threads of what it is subscribed to (--any-topic: all)
  slk review show <thread-id> [--format md|json]
                                          One thread, in full
  slk review reply <thread-id> --agent <name> (--body <markdown> | --body-file <path> | --body -)
           [--status addressed|needs-info] [--rev <version>] [--session <id>] [--message <id>]
           The reply records your session (found from the processes running slk, or --session,
           or $SLK_SESSION) and, when known, your message (--message): a retro can then read
           your conversation back
  slk review set-status <thread-id> addressed|needs-info --agent <name> [--rev <version>]
           --rev: the version you read (slk review list / slk review show): refused, exit 3, if the user changed
           the thread since. Exit 2: the thread no longer exists (e.g. deleted by the user).

History of the review (every thread, whatever its state: open, addressed, resolved, deleted, archived or
not):
  slk review history [--since <date>] [--format md|json] [--out <file>]
                                          The whole conversation of every thread of the project:
                                          the folder (--root, default: the current one), its
                                          subfolders, and the git worktrees of its repositories,
                                          even outside it. --since: threads active since a date
                                          (2026-10-01, local midnight; an ISO time; or 7d for
                                          7 days ago). md starts with counts per state and store.
                                          --out: write it to a file (an export, with --format json)

${ARCHIVE_USAGE}

${RETRO_USAGE}

Git worktrees (git worktree remove deletes a worktree's comments with it):
  slk worktree save [<dir>] [--format md|json]
                                          Save the threads of the git worktree of that folder
                                          (default: the current one) to the store of its main
                                          worktree, before removing it: they stay in slk review history
                                          and in retros. Saving again refreshes the copy

Settings of this machine:
  slk config [--format md|json]           Show them
  slk config set <name> <value>           Change one:
${Object.entries(CONFIG_KEYS).map(([name, c]) => `                                            ${name}: ${c.help}`).join("\n")}
  slk config [set <name> <value>] --project [--root <dir>]
                                          The project's own settings (its .silykat/config.json,
                                          personal), which come before the machine's: ${PROJECT_CONFIG_KEYS.join(", ")}

Subscriptions (comments are published to the sessions subscribed to their branch or path):
  slk subscribe [<dir-or-file>] [--path]  Subscribe this session to the branch of that folder
                                          (default: the current one), or to the path itself
                                          (--path, and always outside git), or to a branch
                                          of the current repository by its name
  slk unsubscribe [<dir-or-file>] [--path] [--all]
  slk subscriptions [--format md|json]    What this session is subscribed to
  (the session is found from the processes running slk; --session <id> or $SLK_SESSION to name it)

Sessions (used by agent integrations to register themselves):
  slk sessions [--format md|json]         Running agent sessions on this machine
  slk session register --id <id> --agent <name> --cwd <dir> [--branch <b>] [--pid <n>]
                     [--push yes|no] [--push-command <command>]
  slk session unregister --id <id>

Options:
  --root <dir>    Folder holding .silykat/ (default: found from the current directory);
                  --root / for the files outside any folder open in the editor
  --agent <name>  Your display name in the threads (default: $SLK_AGENT)

Statuses: "addressed" = done, the user will verify; "needs-info" = you asked the user a question.
Only the user resolves threads.`;
async function runCli(args, io) {
  const [command, ...rest] = args;
  try {
    switch (command) {
      case "review":
        return await review(rest, io);
      case "retro":
        return await retro(rest, io, parseSince);
      case "worktree":
        return await worktree(rest, io);
      case "config":
        return await config(rest, io);
      case "sessions":
        return await sessions(rest, io);
      case "session":
        return await session(rest, io);
      case "subscribe":
        return await subscribe(rest, io);
      case "unsubscribe":
        return await unsubscribe(rest, io);
      case "subscriptions":
        return await subscriptions(rest, io);
      case void 0:
      case "help":
      case "--help":
      case "-h":
        io.out(USAGE);
        return command === void 0 ? EXIT.ERROR : EXIT.OK;
      default:
        throw new UsageError(`Unknown command: ${command}`);
    }
  } catch (err) {
    if (err instanceof UsageError) {
      io.err(`slk: ${err.message}

${USAGE}`);
      return EXIT.ERROR;
    }
    if (err instanceof ChangedError) {
      io.err(`slk: ${err.message}`);
      return EXIT.CHANGED;
    }
    const message = err instanceof Error ? err.message : String(err);
    io.err(`slk: ${message}`);
    return /not found/i.test(message) ? EXIT.NOT_FOUND : EXIT.ERROR;
  }
}
async function review(args, io) {
  const [command, ...rest] = args;
  switch (command) {
    case "status":
      return await status(rest, io);
    case "list":
      return await list2(rest, io);
    case "show":
      return await show2(rest, io);
    case "reply":
      return await reply(rest, io);
    case "set-status":
      return await setStatus(rest, io);
    case "history":
      return await history(rest, io);
    case "archive":
      return await archive(rest, io, parseDateOption);
    case "unarchive":
      return await unarchive(rest, io);
    case "purge":
      return await purge(rest, io, parseDateOption);
    case void 0:
      throw new UsageError("Missing review command");
    default:
      throw new UsageError(`Unknown review command: ${command}`);
  }
}
function openStore(root, io) {
  const dir = root ? (0, import_node_path22.resolve)(io.cwd, root) : findStoreRoot(io.cwd, io.env);
  if (dir) return storeAt(dir, io.env);
  const below = findStoresBelow(io.cwd, 3, io.env);
  const hint = below.length > 0 ? `Stores below this folder:
${below.map((b) => `  ${b}`).join("\n")}
Run the command in one of them, or pass --root <dir>.` : "Nothing has been commented in this folder or above yet.";
  throw new Error(`no silykat store in ${io.cwd} or above. ${hint}`);
}
async function visibleThreads(store) {
  const { threads } = await store.loadAll();
  const views = threads.map(agentView).filter((v) => v !== null);
  const located = await Promise.all(views.map(async (v) => locate(v, await readWorkingFile(store, v))));
  located.sort((a, b) => a.view.thread.anchor.path.localeCompare(b.view.thread.anchor.path) || lineOf(a) - lineOf(b));
  return { located, store };
}
async function readWorkingFile(store, view) {
  if (view.thread.anchor.source !== "worktree") return null;
  try {
    return await (0, import_promises18.readFile)((0, import_node_path22.join)(store.root, ...view.thread.anchor.path.split("/")), "utf8");
  } catch {
    return null;
  }
}
var lineOf = (l) => l.range?.startLine ?? 0;
async function forThisSession(located, store, values, io) {
  if (values["any-topic"] === true) return { located };
  const sessions2 = await registryFor(io).list();
  const session2 = sessionOfProcess(sessions2, await io.ancestors?.() ?? await processAncestors());
  if (!session2) return { located };
  const subs = session2.subscriptions;
  const covered = async (l) => {
    const file = (0, import_node_path22.join)(store.root, ...l.view.thread.anchor.path.split("/"));
    const branch = l.view.thread.branch ?? branchOfTopic(await topicOf(file));
    return subs.some(
      (sub) => sub.topic.kind === "path" ? isWithin(file, sub.topic.path) : branch !== null && branchKey(branchOfTopic(sub.topic)) === branchKey(branch)
    );
  };
  const scope2 = subs.length === 0 ? "this session is subscribed to nothing (slk subscribe, or --any-topic to see every thread)" : `only what this session is subscribed to: ${subs.map((x) => topicLabel(x.topic)).join(", ")} (--any-topic for every thread)`;
  const keep = await Promise.all(located.map(covered));
  return { located: located.filter((_, i) => keep[i]), scope: scope2 };
}
async function status(rest, io) {
  const { values } = parse(rest, { "any-topic": { type: "boolean" } });
  const store = openStore(str(values.root), io);
  const { located, scope: scope2 } = await forThisSession((await visibleThreads(store)).located, store, values, io);
  const forAgent = located.filter((l) => l.view.needsAgent).length;
  const forUser = located.filter((l) => l.view.waitsForUser).length;
  io.out(
    `${forAgent} thread${forAgent === 1 ? "" : "s"} waiting for you \xB7 ${forUser} waiting for the user` + (scope2 ? ` (${scope2})` : "")
  );
  return EXIT.OK;
}
async function list2(rest, io) {
  const { values } = parse(rest, {
    all: { type: "boolean" },
    thread: { type: "string", multiple: true },
    format: { type: "string" },
    "any-topic": { type: "boolean" }
  });
  const only = Array.isArray(values.thread) ? new Set(values.thread) : void 0;
  const store = openStore(str(values.root), io);
  const all = (await visibleThreads(store)).located;
  const { located, scope: scope2 } = only ? { located: all, scope: void 0 } : await forThisSession(all, store, values, io);
  const selected = located.filter(
    (l) => (only === void 0 || only.has(l.view.thread.id)) && (values.all === true ? l.view.thread.status !== "resolved" : l.view.needsAgent)
  );
  if (str(values.format) === "json") {
    io.out(JSON.stringify(selected.map(toJson), null, 2));
    return EXIT.OK;
  }
  if (selected.length === 0) {
    io.out(
      (values.all === true ? "No unresolved thread." : "Nothing waits for you: no thread where the user spoke last.") + (scope2 ? ` (${scope2})` : "")
    );
    return EXIT.OK;
  }
  const { reviews } = await store.loadAll();
  const n = selected.length;
  const parts = [
    `# silykat \u2014 ${n} thread${n === 1 ? "" : "s"} ${values.all === true ? "unresolved" : "waiting for you"}`
  ];
  if (scope2) parts.push(`_Showing ${scope2}._`);
  const summaries = renderReviews(selected, reviews);
  if (summaries) parts.push(summaries);
  parts.push(...selected.map(renderThread));
  io.out(parts.join("\n\n"));
  return EXIT.OK;
}
async function show2(rest, io) {
  const { values, positionals } = parse(rest, { format: { type: "string" } });
  const id = requireThreadId(positionals);
  const { located } = await visibleThreads(openStore(str(values.root), io));
  const found = located.find((l) => l.view.thread.id === id);
  if (!found) throw new Error(await whyNotFound(openStore(str(values.root), io), id, io.env));
  io.out(str(values.format) === "json" ? JSON.stringify(toJson(found), null, 2) : renderThread(found));
  return EXIT.OK;
}
async function reply(rest, io) {
  const { values, positionals } = parse(rest, {
    agent: { type: "string" },
    body: { type: "string" },
    "body-file": { type: "string" },
    status: { type: "string" },
    rev: { type: "string" },
    session: { type: "string" },
    message: { type: "string" }
  });
  const id = requireThreadId(positionals);
  const agent = requireAgent(str(values.agent), io);
  const status2 = str(values.status) === void 0 ? void 0 : agentStatus(str(values.status));
  let body2 = str(values.body);
  if (body2 === "-") body2 = await io.readStdin();
  const bodyFile = str(values["body-file"]);
  if (bodyFile) body2 = await (0, import_promises18.readFile)((0, import_node_path22.resolve)(io.cwd, bodyFile), "utf8");
  if (body2 === void 0 || body2.trim() === "") throw new UsageError("reply needs --body, --body-file or --body -");
  const store = openStore(str(values.root), io);
  await assertCurrent(store, id, str(values.rev), io.env);
  const session2 = await replySession(id, values, io);
  const state = await store.addComment(
    id,
    { author: "agent", agent, body: body2, reviewId: null, ...session2 ? { session: session2 } : {} },
    status2 ? { status: status2 } : {}
  );
  io.out(`Replied on ${state.id} (status: ${state.status}).`);
  return EXIT.OK;
}
async function replySession(threadId, values, io) {
  try {
    const registry = registryFor(io);
    const named = str(values.session)?.trim() || io.env.SLK_SESSION?.trim();
    const id = named || sessionOfProcess(await registry.list(), await io.ancestors?.() ?? await processAncestors())?.id;
    if (!id) return void 0;
    const message = str(values.message)?.trim() || callFor(await registry.calls(id).catch(() => []), threadId)?.message;
    return message ? { id, message } : { id };
  } catch {
    return void 0;
  }
}
async function setStatus(rest, io) {
  const { values, positionals } = parse(rest, { agent: { type: "string" }, rev: { type: "string" } });
  const id = requireThreadId(positionals);
  const status2 = agentStatus(positionals[1]);
  const store = openStore(str(values.root), io);
  await assertCurrent(store, id, str(values.rev), io.env);
  const state = await store.setStatus(id, status2, "agent", requireAgent(str(values.agent), io));
  io.out(`${state.id} is now ${state.status}.`);
  return EXIT.OK;
}
async function history(rest, io) {
  const { values, positionals } = parse(rest, {
    since: { type: "string" },
    format: { type: "string" },
    out: { type: "string" }
  });
  if (positionals.length > 0) throw new UsageError(`slk review history takes no argument: "${positionals[0]}"`);
  const format = str(values.format) ?? "md";
  if (format !== "md" && format !== "json") throw new UsageError(`--format must be "md" or "json", not "${format}"`);
  const since = parseSince(str(values.since));
  const h = await projectHistory((0, import_node_path22.resolve)(io.cwd, str(values.root) ?? "."), { since, env: io.env });
  const text = format === "json" ? JSON.stringify(historyJson(h), null, 2) : renderHistory(h);
  const out2 = str(values.out);
  if (out2 === void 0) io.out(text);
  else {
    const file = (0, import_node_path22.resolve)(io.cwd, out2);
    await (0, import_promises18.writeFile)(file, text + "\n");
    io.out(`Wrote the history of ${h.threads} thread${h.threads === 1 ? "" : "s"} (${format}) to ${file}.`);
  }
  return EXIT.OK;
}
async function worktree(rest, io) {
  const { values, positionals } = parse(rest, { format: { type: "string" } });
  const [action, dir, extra] = positionals;
  if (action !== "save") throw new UsageError(`slk worktree takes "save", not "${action ?? ""}"`);
  if (extra !== void 0) throw new UsageError(`slk worktree save takes one folder at most: "${extra}"`);
  const result = await saveWorktreeThreads((0, import_node_path22.resolve)(io.cwd, dir ?? str(values.root) ?? "."), io.env);
  if (str(values.format) === "json") {
    io.out(JSON.stringify(result, null, 2));
    return EXIT.OK;
  }
  const branch = result.branch ? ` (branch ${result.branch})` : "";
  io.out(
    result.copies.length === 0 ? `No comment in the worktree ${result.worktree}${branch}: nothing to save.` : `Saved ${result.published} thread${result.published === 1 ? "" : "s"} of the worktree ${result.worktree}${branch} to the store of ${result.main}:
${result.copies.map((c) => `  ${c.from} \u2192 ${c.dir}`).join("\n")}
They stay in slk review history and in retros after the worktree is removed.`
  );
  return EXIT.OK;
}
async function keptHistoryNote(io) {
  let summary = null;
  try {
    const plan = await historyPlan([io.cwd], io.env);
    summary = historySummary(plan.deleted.length, plan.saved.length);
  } catch {
  }
  return " Deleting a thread now erases it, and nothing is saved when an agent removes a worktree." + (summary ? `
The history already kept stays: ${summary} in ${io.cwd}. To erase it: slk review purge --history (it shows what, then --yes).` : "");
}
async function config(rest, io) {
  const { values, positionals } = parse(rest, { format: { type: "string" }, project: { type: "boolean" } });
  const [action, name, value] = positionals;
  if (values.project === true) return projectConfig(io, str(values.root), action, name, value, str(values.format));
  if (action === "set") {
    const setting = name ? CONFIG_KEYS[name] : void 0;
    if (!setting) throw new UsageError(`unknown setting "${name ?? ""}": ${Object.keys(CONFIG_KEYS).join(", ")}`);
    if (setting.kind === "boolean") {
      if (value !== "on" && value !== "off") throw new UsageError(`${name} takes "on" or "off", not "${value ?? ""}"`);
      await writeConfig({ [setting.key]: value === "on" }, io.env);
    } else if (setting.kind === "choice") {
      if (!setting.choices.includes(value ?? ""))
        throw new UsageError(`${name} takes ${setting.choices.join(" or ")}, not "${value ?? ""}"`);
      await writeConfig({ [setting.key]: value }, io.env);
    } else {
      const n = /^\d+$/.test(value ?? "") ? Number(value) : NaN;
      if (!validSettingNumber(n)) throw new UsageError(`${name} takes a whole number, 1 or more, not "${value ?? ""}"`);
      await writeConfig({ [setting.key]: n }, io.env);
    }
    io.out(`${name} is now ${value}.` + (name === "keep-history" && value === "off" ? await keptHistoryNote(io) : ""));
    return EXIT.OK;
  }
  if (action !== void 0) throw new UsageError(`slk config takes "set" or nothing, not "${action}"`);
  const current = await readConfig(io.env);
  if (str(values.format) === "json") {
    io.out(JSON.stringify(current, null, 2));
    return EXIT.OK;
  }
  const shown = (s) => s.kind === "boolean" ? current[s.key] ? "on" : "off" : String(current[s.key]);
  io.out(
    [
      `Settings of this machine (${configFile(io.env)}):`,
      ...Object.entries(CONFIG_KEYS).map(([n, c]) => `  ${n}: ${shown(c)}`)
    ].join("\n")
  );
  return EXIT.OK;
}
async function projectConfig(io, root, action, name, value, format) {
  const home = await retroHome((0, import_node_path22.resolve)(io.cwd, root ?? "."), io.env);
  if (action === "set") {
    const setting = name && PROJECT_CONFIG_KEYS.includes(name) ? CONFIG_KEYS[name] : void 0;
    if (setting?.kind !== "choice")
      throw new UsageError(`a project sets ${PROJECT_CONFIG_KEYS.join(", ")} only, not "${name ?? ""}"`);
    if (!setting.choices.includes(value ?? ""))
      throw new UsageError(`${name} takes ${setting.choices.join(" or ")}, not "${value ?? ""}"`);
    await prepareStoreHome(home);
    await writeProjectConfig(home, { [setting.key]: value });
    io.out(`${name} is now ${value} for the project (${home}).`);
    return EXIT.OK;
  }
  if (action !== void 0) throw new UsageError(`slk config takes "set" or nothing, not "${action}"`);
  const own = await readProjectConfig(home);
  if (format === "json") {
    io.out(JSON.stringify(own, null, 2));
    return EXIT.OK;
  }
  const machine = await readConfig(io.env);
  io.out(
    [
      `Settings of the project (${projectConfigFile(home)}), before the machine's:`,
      ...PROJECT_CONFIG_KEYS.map((n) => {
        const key2 = CONFIG_KEYS[n].key;
        return `  ${n}: ${own[key2] ?? `not set (the machine's: ${String(machine[key2])})`}`;
      })
    ].join("\n")
  );
  return EXIT.OK;
}
function parseSince(value, now = Date.now()) {
  return value === void 0 ? null : parseDateOption(value, "--since", now);
}
function parseDateOption(value, flag, now = Date.now()) {
  const date = parseDateArg(value, now);
  if (!date)
    throw new UsageError(`${flag} must be a date (2026-10-01), a date and time, or a number of days (7d): "${value}"`);
  return date;
}
var registryFor = (io) => new SessionRegistry(silykatHome(io.env));
async function sessions(rest, io) {
  const { values } = parse(rest, { format: { type: "string" } });
  const list3 = await registryFor(io).list();
  if (str(values.format) === "json") {
    io.out(JSON.stringify(list3, null, 2));
    return EXIT.OK;
  }
  if (list3.length === 0) {
    io.out("No agent session is running.");
    return EXIT.OK;
  }
  io.out(
    list3.map(
      (x) => `${x.agent} ${x.id.slice(0, 8)} \xB7 ${x.branch ?? "no branch"} \xB7 ${x.cwd}${x.push === false ? " \xB7 no push" : ""}` + x.subscriptions.map((sub) => `
  subscribed to ${topicLabel(sub.topic)} (${sub.reason})`).join("")
    ).join("\n")
  );
  return EXIT.OK;
}
async function session(rest, io) {
  const [action, ...args] = rest;
  const { values } = parse(args, {
    id: { type: "string" },
    agent: { type: "string" },
    cwd: { type: "string" },
    branch: { type: "string" },
    pid: { type: "string" },
    push: { type: "string" },
    "push-command": { type: "string" }
  });
  const id = str(values.id);
  if (!id) throw new UsageError("missing --id <session id>");
  const registry = registryFor(io);
  switch (action) {
    case "register": {
      const pid = str(values.pid) === void 0 ? null : Number(str(values.pid));
      if (pid !== null && !Number.isInteger(pid)) throw new UsageError("--pid must be a process id");
      const push = str(values.push);
      if (push !== void 0 && push !== "yes" && push !== "no") throw new UsageError('--push must be "yes" or "no"');
      await registry.register({
        id,
        agent: requireAgent(str(values.agent), io),
        cwd: (0, import_node_path22.resolve)(io.cwd, str(values.cwd) ?? "."),
        branch: str(values.branch) ?? null,
        pid,
        startedAt: (/* @__PURE__ */ new Date()).toISOString(),
        push: push === void 0 ? null : push === "yes",
        pushCommand: str(values["push-command"]) ?? null
      });
      io.out(`Session ${id} registered.`);
      return EXIT.OK;
    }
    case "unregister":
      await registry.unregister(id);
      io.out(`Session ${id} unregistered.`);
      return EXIT.OK;
    default:
      throw new UsageError(`unknown session action: ${action ?? "(none)"}`);
  }
}
var subscriptionOptions = {
  session: { type: "string" },
  path: { type: "boolean" },
  all: { type: "boolean" },
  format: { type: "string" }
};
async function currentSession(values, io) {
  const registry = registryFor(io);
  const named = str(values.session) ?? io.env.SLK_SESSION?.trim();
  if (named) return { registry, id: named };
  const found = sessionOfProcess(await registry.list(), await io.ancestors?.() ?? await processAncestors());
  if (!found)
    throw new Error(
      "this command does not run in a registered agent session. Pass --session <id> (see slk sessions), or set SLK_SESSION."
    );
  return { registry, id: found.id };
}
async function subscribe(rest, io) {
  const { values, positionals } = parse(rest, subscriptionOptions);
  const { registry, id } = await currentSession(values, io);
  const target = await subscriptionTarget(positionals[0], values, io);
  if (!target) throw new Error(`${(0, import_node_path22.resolve)(io.cwd, positionals[0] ?? ".")}: file, folder or branch not found.`);
  const added = await registry.subscribe(id, target.topic, "user");
  io.out(`${added ? "Subscribed to" : "Already subscribed to"} ${topicLabel(target.topic)}.`);
  if (target.checkedOutNowhere)
    io.out(`${positionals[0]} is not checked out in any folder yet: its comments will come once it is.`);
  return EXIT.OK;
}
async function subscriptionTarget(arg, values, io) {
  const path = (0, import_node_path22.resolve)(io.cwd, arg ?? ".");
  if (arg === void 0 || values.path === true || await (0, import_promises18.stat)(path).catch(() => null))
    return { topic: await topicOf(path, { asPath: values.path === true }) };
  const repo = (await worktreeInfo(io.cwd))?.repo;
  if (!repo || !(await localBranches(io.cwd)).has(arg)) return null;
  for (const wt of await worktreesOf2(io.cwd))
    if ((await gitWorktreeOf(wt))?.branch === arg)
      return { topic: { kind: "branch", repo, branch: arg, worktree: wt } };
  return { topic: { kind: "branch", repo, branch: arg }, checkedOutNowhere: true };
}
async function unsubscribe(rest, io) {
  const { values, positionals } = parse(rest, subscriptionOptions);
  const { registry, id } = await currentSession(values, io);
  const gone = await registry.unsubscribe(
    id,
    values.all === true ? "all" : (await subscriptionTarget(positionals[0], values, io))?.topic ?? await topicOf((0, import_node_path22.resolve)(io.cwd, positionals[0] ?? "."))
  );
  io.out(
    gone.length === 0 ? "Not subscribed to that." : `Unsubscribed from ${gone.map((g) => topicLabel(g.topic)).join(", ")}.`
  );
  return EXIT.OK;
}
async function subscriptions(rest, io) {
  const { values } = parse(rest, subscriptionOptions);
  const { registry, id } = await currentSession(values, io);
  const subs = await registry.subscriptions(id);
  if (str(values.format) === "json") io.out(JSON.stringify(subs, null, 2));
  else
    io.out(
      subs.length === 0 ? "This session is subscribed to nothing: comments reach it only when the user asks." : subs.map((sub) => `${topicLabel(sub.topic)} (${sub.reason})`).join("\n")
    );
  return EXIT.OK;
}
async function assertCurrent(store, id, rev, env) {
  const { state } = await store.loadThread(id);
  const view = state ? agentView(state) : null;
  if (!view) throw new Error(await whyNotFound(store, id, env));
  if (rev === void 0 || rev === view.rev) return;
  const located = locate(view, await readWorkingFile(store, view));
  throw new ChangedError(
    `the user changed thread ${id} since you read it (version ${rev}, now ${view.rev}): read it again, adapt your work if needed, then reply with --rev ${view.rev}. It is now:

${renderThread(located)}`
  );
}
async function whyNotFound(store, id, env) {
  let state = null;
  try {
    state = (await store.loadThread(id)).state;
  } catch {
  }
  if (state?.deleted)
    return `Thread not found: ${id} was deleted by the user. Stop working on it; if you already changed code for it, ask the user whether to undo those changes (never undo them on your own).`;
  if (state?.archived)
    return `Thread not found: ${id} was archived by the user: it is finished. Stop working on it (slk review unarchive ${id} brings it back, only if the user asks).`;
  if (!state && !(await readConfig(env)).keepHistory)
    return `Thread not found: ${id}. The user may have deleted it (deleted threads are erased on this machine): if you were working on it, stop, and ask the user whether to undo the changes you made for it (never undo them on your own).`;
  return `Thread not found: ${id}`;
}
function requireThreadId(positionals) {
  const id = positionals[0];
  if (!id) throw new UsageError("missing <thread-id>");
  return id;
}
function requireAgent(flag, io) {
  const agent = (flag ?? io.env.SLK_AGENT)?.trim();
  if (!agent) throw new UsageError("say who you are with --agent <name> (or set SLK_AGENT)");
  return agent;
}
function agentStatus(value) {
  if (value === "addressed" || value === "needs-info") return value;
  throw new UsageError(`status must be "addressed" or "needs-info"${value ? `, not "${value}"` : ""}`);
}
function toJson(l) {
  const { thread, comments, needsAgent, waitsForUser } = l.view;
  return {
    id: thread.id,
    path: thread.anchor.path,
    source: thread.anchor.source,
    ref: thread.anchor.ref,
    sha: thread.anchor.sha,
    range: l.range,
    outdated: l.outdated,
    code: l.code,
    status: thread.status,
    rev: l.view.rev,
    needsAgent,
    waitsForUser,
    comments: comments.map((c) => ({
      author: c.author === "user" ? "user" : c.agentName ?? "agent",
      body: c.body,
      createdAt: c.createdAt,
      edited: c.editedAt !== void 0
    }))
  };
}

// src/main.ts
async function readStdin() {
  const chunks = [];
  for await (const chunk of process.stdin) chunks.push(chunk);
  return Buffer.concat(chunks).toString("utf8");
}
runCli(process.argv.slice(2), {
  cwd: process.cwd(),
  env: process.env,
  out: (text) => process.stdout.write(text + "\n"),
  err: (text) => process.stderr.write(text + "\n"),
  readStdin
}).then(
  (code) => {
    process.exitCode = code;
  },
  (err) => {
    process.stderr.write(`slk: ${String(err)}
`);
    process.exitCode = 1;
  }
);
