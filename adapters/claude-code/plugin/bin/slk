function sourceInput(ctx, source, extras = {}) {
  const body2 = [];
  if (source === "threads")
    body2.push(
      ...renderToVerify(ctx, "threads"),
      "## Statistics (computed without a model)",
      ...renderStats(statsOf(ctx)),
      "",
      ...renderThreads(ctx)
    );
  else if (source === "sessions") {
    const sessions2 = renderRetroSessions(ctx);
    body2.push(
      ...renderToVerify(ctx, "sessions"),
      ...sessions2.length ? sessions2 : ["## The agent's sessions", "", "None: the retro reads no session.", ""]
    );
  } else
    body2.push(
      "## The audit of the setup",
      "",
      extras.audit?.trim() || "None: the audit did not run.",
      "",
      ...renderUsage(extras.usage ?? null)
    );
  return [...inputHead(`Retro input: ${SOURCE_TITLE[source]}`, ctx), ...body2, "", ...findingsFormat(source)].join("\n");
}
var SOURCE_TITLE = {
  threads: "the review threads",
  sessions: "the agent's sessions",
  audit: "the audit of the setup"
};
function renderUsage(usage) {
  if (!usage) return ["## Usage of the setup's tools", "", "Not counted.", ""];
  const lines = [
    "## Usage of the setup's tools (counted without a model)",
    "",
    `From ${usage.source}'s own records, on this machine only: ` + usage.windows.map(
      (w) => `${w.scope === "project" ? "the project's tools on its" : "the user's tools on every project's"} ${w.sessions} session(s)` + (w.since ? ` since ${w.since.slice(0, 10)}` : "")
    ).join("; ") + `. Sessions inactive for more than ${usage.windows[0]?.keptDays ?? 30} days are deleted by the agent: older uses are not seen. A tool shared in a repository may serve the rest of the team.`,
    ""
  ];
  const sorted = [...usage.tools].sort((a, b) => usesOf(a) - usesOf(b) || a.name.localeCompare(b.name));
  for (const t of sorted)
    lines.push(
      `- ${TOOL_TITLE[t.kind]} ${t.name} (${t.scope}, ${t.file}): ` + (usesOf(t) === 0 ? "NEVER USED" : `used ${usesOf(t)} time(s) (${t.byUser} typed by the user, ${t.byAgent} by the agent) in ${t.sessions} session(s), last ${t.lastUsed?.slice(0, 10) ?? "?"}`)
    );
  if (sorted.length === 0) lines.push("No skill, command or sub-agent in the setup.");
  return [...lines, ""];
}
function renderFinding(f, usage, root) {
  const tool = usage && f.source === "audit" ? toolOfFile(f.file || f.audit?.location || "", usage.tools, root) : null;
  return [
    `### ${f.id} \xB7 ${f.subject}` + (f.column ? ` (suggests: ${f.column}${f.kind ? `, ${f.kind}` : ""})` : ""),
    `- cause: ${f.cause}`,
    ...f.evidence.map((e) => `- thread ${e.thread}${e.excerpt ? `: "${e.excerpt}"` : ""}`),
    ...f.sessions.map(
      (e) => `- session ${e.session}${e.excerpt ? `: "${e.excerpt}"` : ""}` + (e.moments?.length ? ` (moments ${e.moments.join(", ")})` : "")
    ),
    ...f.audit ? [`- audit, ${f.audit.location}: ${f.audit.finding}`] : [],
    ...tool ? [
      `- usage: ${TOOL_TITLE[tool.kind]} ${tool.name} ` + (usesOf(tool) === 0 ? "NEVER USED (the user will be asked whether to keep it or remove it)" : `used ${usesOf(tool)} time(s)`)
    ] : [],
    ...f.file ? [`- file: ${f.file}`] : [],
    ...f.rule ? [`- existing: ${f.rule.replace(/\s+/g, " ").slice(0, 400)}`] : [],
    ...f.change ? [`- suggested change: ${f.change.replace(/\s+/g, " ").slice(0, 600)}`] : [],
    ...f.target ? [`- target: ${f.target}${f.targetEvidence.length ? ` (${f.targetEvidence.join(", ")})` : ""}`] : [],
    `- confidence: ${f.confidence}` + (f.note ? ` \xB7 ${f.note}` : ""),
    ""
  ];
}
function arbiterInput(ctx, findings2, files, usage) {
  const lines = [...inputHead("Retro input: the findings of every source", ctx)];
  const verifications = [...findings2.threads?.verifications ?? [], ...findings2.sessions?.verifications ?? []];
  if (verifications.length > 0) {
    lines.push(
      "## Changes adopted at the last retro: checked by the reading of each source",
      "",
      'Already in "verify" (copied into your proposals when you leave "verify" out, the threads and the sessions together). A change that did not reduce the feedback, with 2 threads or sessions or more, needs a proposal to revise it ("revisits": "<ref>").',
      "",
      ...verifications.map(
        (v) => `- ${changeRef(v)} ${v.title}, by the reading of ${v.measured?.includes("sessions") ? "the sessions" : "the threads"}: ${measureText(v)} \u2192 ${v.verdict}` + ([...v.after.ids, ...v.afterSessions?.ids ?? []].length ? ` (${[...v.after.ids, ...v.afterSessions?.ids ?? []].join(", ")})` : "") + (v.note ? `; ${v.note}` : "")
      ),
      ""
    );
  }
  lines.push("## Statistics (computed without a model)", ...renderStats(statsOf(ctx)), "");
  for (const source of FINDING_ORDER) {
    const f = findings2[source];
    lines.push(`## Findings: ${SOURCE_TITLE[source]}`, "");
    if (!f) {
      lines.push("Not read: the user left it out of this retro, or it had nothing to read.", "");
      continue;
    }
    if (f.findings.length === 0) lines.push("No finding.", "");
    for (const x of f.findings) lines.push(...renderFinding(x, usage, ctx.retro.root));
    if (f.overview)
      lines.push(
        "### What recurs across the sessions (prepared by the reading of the sessions)",
        "",
        'Copied into your proposals as "overview" when you leave it out.',
        "",
        "```json",
        JSON.stringify(f.overview, null, 1),
        "```",
        ""
      );
  }
  lines.push(
    "## The sources, to go back to",
    "",
    ...files.threads ? [`- The threads, every one of them: ${files.threads}`] : [],
    ...files.sessions ? [`- The agent's sessions: ${files.sessions}`] : [],
    ...files.audit ? [`- The audit of the setup and the usage of its tools: ${files.audit}`] : [],
    ""
  );
  return lines.join("\n");
}
var FINDING_ORDER = ["threads", "sessions", "audit"];
function sessionIds(ctx) {
  return new Map([
    ...(ctx.sessions ?? []).map((x) => [x.id, true]),
    ...(ctx.reports?.list ?? []).map((x) => [x.session, true])
  ]);
}
function renderToVerify(ctx, on) {
  const measurable = { threads: ctx.threads, sessions: sessionIds(ctx) };
  const changes = changesToVerify(ctx.retro, ctx.previous).map((c) => ({ c, parts: measurableSources(c, measurable).filter((m) => !on || m === on) })).filter((x) => x.parts.length > 0);
  if (changes.length === 0) return [];
  const what = on === "sessions" ? "sessions" : on === "threads" ? "threads" : "threads and sessions";
  const out2 = [
    "## Changes adopted at the last retro: did they help?",
    "",
    `For EACH change below, list in "verify" the ${what} of this period whose feedback has the same cause (the change did not prevent it), [] when none: { "change": "<ref>", ${on ? `"${on}"` : '"threads" / "sessions" (those listed for it)'}: [...], "note": "what you saw, in a sentence" }. The numbers and the verdict are computed by program: stopped (nothing), decreased (a smaller share than before) or not decreased. A change that did not reduce the feedback, with 2 threads or sessions or more, needs a proposal to revise it, with "revisits": "<ref>" (reword it, move it up, make it a hook, or remove it); its "target" defaults to the one of the change it revises.`,
    ""
  ];
  for (const { c, parts } of changes) {
    const before2 = parts.map(
      (m) => m === "threads" ? `${c.before.threads} of the ${c.before.total} threads of that retro` : `${c.beforeSessions?.sessions ?? 0} of the ${c.beforeSessions?.total ?? 0} sessions of that retro`
    ).join("; ");
    out2.push(
      `- ${changeRef(c)} [${c.column}] ${c.title} (${c.kind}, ${c.decision}${c.target ? `, target ${c.target}` : ""}${c.files.length ? `, changed: ${c.files.join(", ")}` : ", no file recorded as changed"}): ${c.subject}`,
      `  check on: ${parts.join(" and ")}; before: ${before2}` + (c.change ? `; change: ${c.change.replace(/\s+/g, " ").slice(0, 300)}` : "") + (c.note ? `; note of the user: ${c.note}` : ""),
      ...parts.includes("threads") ? c.evidence.map((e) => `  - ${e.thread}${e.excerpt ? `: "${e.excerpt}"` : ""}`) : [],
      ...parts.includes("sessions") ? (c.sessions ?? []).map((e) => `  - session ${e.session}${e.excerpt ? `: "${e.excerpt}"` : ""}`) : []
    );
  }
  out2.push("");
  return out2;
}
function linkedSessions(t) {
  const ids = t.conversation.flatMap((e) => e.kind === "comment" && e.session ? [e.session.id] : []);
  return [...new Set(ids)];
}
async function writeRetroFile(book2, id, name, content) {
  const file = (0, import_node_path18.join)(await book2.workDir(id), name);
  await (0, import_promises16.writeFile)(file, content);
  return file;
}

// src/digest.ts
var import_node_path19 = require("node:path");
function locate(view, fileText) {
  const a = view.thread.anchor;
  if (!a.range) return { view, range: null, code: "", outdated: false };
  if (a.source !== "worktree") return { view, range: a.range, code: a.snippet, outdated: false };
  const found = fileText === null ? { kind: "lost" } : reanchor(a, fileText);
  if (!found || found.kind === "lost") return { view, range: null, code: a.snippet, outdated: true };
  const lines = fileText.split(/\r\n|\r|\n/).slice(found.range.startLine - 1, found.range.endLine);
  return { view, range: found.range, code: lines.join("\n"), outdated: false };
}
